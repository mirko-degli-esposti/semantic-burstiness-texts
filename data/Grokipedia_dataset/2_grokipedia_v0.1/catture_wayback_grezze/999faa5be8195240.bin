ined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[[\"slug\",\"Buddhism\",\"d\"],[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L5\",null,{\"children\":[[\"$\",\"$L6\",null,{\"maxWidth\":\"full\",\"mobileOptions\":{\"right\":{\"showFixedIssues\":true,\"showThemeSwitcher\":true,\"showSearch\":true,\"showTableOfContents\":true}}}],[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L4\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[\"$\",\"$L7\",null,{}],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]]}],{\"children\":[\"__PAGE__\",[\"$\",\"$1\",\"c\",{\"children\":[\"$L8\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/f87fff2ab93d05a7.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"NjJkOTBiYzYtNmE5ZS00MDEzLThiZTAtNWYyZmEzZTUxOWY4\"}]],[\"$\",\"$L9\",null,{\"children\":[\"$La\",[\"$\",\"$Lb\",null,{\"promise\":\"$@c\"}]]}]]}],{},null,false]},null,false]},null,false]},null,false],[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$Ld\",null,{\"children\":\"$Le\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$Lf\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$10\",null,{\"fallback\":null,\"children\":\"$L11\"}]}]}]]}],false]],\"m\":\"$undefined\",\"G\":[\"$12\",[]],\"s\":false,\"S\":false}\n"])</script><script nonce="NjJkOTBiYzYtNmE5ZS00MDEzLThiZTAtNWYyZmEzZTUxOWY4">self.__next_f.push([1,"2:[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"bg-surface-base antialiased\",\"suppressHydrationWarning\":true,\"children\":[\"$\",\"body\",null,{\"className\":\"flex h-[100svh] w-full flex-col __variable_13c637 __variable_8a0ba0 __variable_779740 __variable_2484fd __variable_525cc3 __variable_13486b\",\"children\":[[\"$\",\"$L13\",null,{\"children\":[\"$\",\"$L14\",null,{\"children\":[\"$\",\"$L15\",null,{\"defaultTheme\":\"dark\",\"nonce\":\"NjJkOTBiYzYtNmE5ZS00MDEzLThiZTAtNWYyZmEzZTUxOWY4\",\"children\":[\"$\",\"$L16\",null,{\"children\":[\"$\",\"$L17\",null,{\"children\":[\"$\",\"$L18\",null,{\"children\":[\"$\",\"$L19\",null,{\"children\":[\"$\",\"$L1a\",null,{\"children\":[[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$1b\",\"errorStyles\":[],\"errorScripts\":[],\"template\":[\"$\",\"$L4\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[\"$\",\"$L1c\",null,{}],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}],[\"$\",\"$L1d\",null,{}]]}]}]}]}]}]}]}]}],[\"$\",\"script\",null,{\"type\":\"application/json\",\"id\":\"server-client-data-experimentation\",\"children\":\"{\\\"status\\\":\\\"uninitialized\\\"}\"}]]}]}]\n"])</script><script nonce="NjJkOTBiYzYtNmE5ZS00MDEzLThiZTAtNWYyZmEzZTUxOWY4">self.__next_f.push([1,"e:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\na:null\n"])</script><script nonce="NjJkOTBiYzYtNmE5ZS00MDEzLThiZTAtNWYyZmEzZTUxOWY4">self.__next_f.push([1,"1e:I[42712,[\"8739\",\"static/chunks/63f0ec43-8ee6a76d70472249.js\",\"2254\",\"static/chunks/8208b75a-a48e5a4507a0de91.js\",\"4684\",\"static/chunks/24cf1b50-159cca90b09285e0.js\",\"1829\",\"static/chunks/9ffa21ba-c069766d809bd4c7.js\",\"7670\",\"static/chunks/7670-def27a8af6e0c44d.js\",\"282\",\"static/chunks/282-691fffb366e24ca5.js\",\"7515\",\"static/chunks/7515-336759ef5dad2b52.js\",\"5497\",\"static/chunks/5497-ab85ef3ea59dd353.js\",\"7720\",\"static/chunks/7720-3a1e7e411adba2d3.js\",\"6281\",\"static/chunks/6281-c6e84786dade3614.js\",\"7086\",\"static/chunks/7086-1f1c4891d766e04f.js\",\"600\",\"static/chunks/600-9a9fcafaaa6c1c4c.js\",\"5002\",\"static/chunks/5002-4d6d2ca837fbfe03.js\",\"5448\",\"static/chunks/5448-004667276a0cea5b.js\",\"5855\",\"static/chunks/5855-3a8c0d1551398f00.js\",\"4393\",\"static/chunks/4393-1c8dff25ec904469.js\",\"9214\",\"static/chunks/9214-a10614844a67ba31.js\",\"8\",\"static/chunks/8-8ca70ca619d8e099.js\",\"4789\",\"static/chunks/4789-2080f6497f78b5b6.js\",\"6304\",\"static/chunks/app/page/%5Bslug%5D/page-a9340b15d5ef4a80.js\"],\"HydrationBoundary\"]\n"])</script><script nonce="NjJkOTBiYzYtNmE5ZS00MDEzLThiZTAtNWYyZmEzZTUxOWY4">self.__next_f.push([1,"21:I[6367,[],\"IconMark\"]\n1f:T1d941,"])</script><script nonce="NjJkOTBiYzYtNmE5ZS00MDEzLThiZTAtNWYyZmEzZTUxOWY4">self.__next_f.push([1,"# Buddhism\n\n**Buddhism**\u003csup\u003e[a]\u003c/sup\u003e, also known as **Buddhadharma** and **Dharmavinaya**, is an [Indian religion](Indian_religion \"Indian religion\")\u003csup\u003e[b]\u003c/sup\u003e based on [teachings](Pre-sectarian_Buddhism \"Pre-sectarian Buddhism\") attributed to [the Buddha](The_Buddha \"The Buddha\"), a wandering teacher who lived in the 6th or 5th century [BCE](Before_the_Common_Era \"Before the Common Era\").[7] It is the [world's fourth-largest religion](Major_religious_groups \"Major religious groups\"),[8][9] with about 320 million followers, known as **Buddhists**, who comprise four percent of the global population.[10] It arose in the eastern [Gangetic plain](Gangetic_plain \"Gangetic plain\") as a _[śramaṇa](śramaṇa \"Śramaṇa\")_ movement in the 5th century BCE, and gradually spread throughout much of Asia. Buddhism has subsequently played a major role in Asian culture and spirituality, eventually spreading to [the West](Western_world \"Western world\") in the 20th century.[11]  \n\nAccording to tradition, the Buddha instructed his followers in a path of [development](Bhavana \"Bhavana\") which leads to [awakening](Enlightenment_in_Buddhism \"Enlightenment in Buddhism\") and [full liberation](Moksha \"Moksha\") from _[dukkha](dukkha \"Duḥkha\")_ (lit. 'suffering, unease'). He regarded this path as a [Middle Way](Middle_Way \"Middle Way\") between extremes such as [asceticism](Asceticism \"Asceticism\") and sensual indulgence.[12][13] Teaching that _dukkha_ arises alongside [attachment or clinging](Upādāna \"Upādāna\"), the Buddha advised [meditation practices](Buddhist_meditation \"Buddhist meditation\") and [ethical precepts](Buddhist_ethics \"Buddhist ethics\") rooted in [non-harming](Ahimsa \"Ahimsa\"). Widely observed teachings include the [Four Noble Truths](Four_Noble_Truths \"Four Noble Truths\"), the [Noble Eightfold Path](Noble_Eightfold_Path \"Noble Eightfold Path\"), and the doctrines of [dependent origination](Dependent_origination \"Dependent origination\"), [karma](Karma_in_Buddhism \"Karma in Buddhism\"), and the [three marks of existence](Three_marks_of_existence \"Three marks of existence\"). Other commonly observed elements include the [Triple Gem](Triple_Gem \"Triple Gem\"), the taking of [monastic vows](Buddhist_monasticism \"Buddhist monasticism\"), and the cultivation of perfections (_[pāramitā](pāramitā \"Pāramitā\")_).[14]  \n\nThe [Buddhist canon](Tripiṭaka \"Tripiṭaka\") is vast, with [philosophical traditions](Philosophical_tradition \"Philosophical tradition\") and many different textual collections in different languages (such as [Sanskrit](Sanskrit \"Sanskrit\"), [Pali](Pali \"Pali\"), [Tibetan](Tibeto-Burman_languages \"Tibeto-Burman languages\"), and [Chinese](Chinese_language \"Chinese language\")).[15] [Buddhist schools](Schools_of_Buddhism \"Schools of Buddhism\") vary in their interpretation of the paths to liberation (_[mārga](Buddhist_paths_to_liberation \"Buddhist paths to liberation\")_) as well as the relative importance and \"canonicity\" assigned to various [Buddhist texts](Buddhist_texts \"Buddhist texts\"), and their specific teachings and practices.[16][17] Two major extant branches of Buddhism are generally recognized by scholars: [Theravāda](Theravada \"Theravada\") (lit. 'School of the Elders') and [Mahāyāna](Mahayana \"Mahayana\") (lit. 'Great Vehicle'). The Theravada tradition emphasizes the attainment of _[nirvāṇa](Nirvana_(Buddhism) \"Nirvana (Buddhism)\")_ (lit. 'extinguishing') as a means of transcending the individual self and ending the cycle of death and rebirth (_[saṃsāra](Saṃsāra_(Buddhism) \"Saṃsāra (Buddhism)\")_),[18][19][20] while the Mahayana tradition emphasizes the [Bodhisattva ideal](Bodhisattva \"Bodhisattva\"), in which one works for the liberation of all sentient beings. Additionally, [Vajrayāna](Vajrayāna \"Vajrayāna\") (lit. 'Indestructible Vehicle'), a body of teachings incorporating esoteric [tantric](Tantra \"Tantra\") techniques, may be viewed as a separate branch or tradition within Mahāyāna.[21]  \n\nThe Theravāda branch has a widespread following in [Sri Lanka](Sri_Lanka \"Sri Lanka\") as well as in Southeast Asia, namely [Myanmar](Myanmar \"Myanmar\"), [Thailand](Thailand \"Thailand\"), [Laos](Laos \"Laos\"), and [Cambodia](Cambodia \"Cambodia\"). The Mahāyāna branch—which includes the East Asian traditions of [Tiantai](Tiantai \"Tiantai\"), [Chan](Chan_Buddhism \"Chan Buddhism\"), [Pure Land](Pure_Land_Buddhism \"Pure Land Buddhism\"), [Zen](Zen \"Zen\"), [Nichiren](Nichiren_Buddhism \"Nichiren Buddhism\"), and [Tendai](Tendai \"Tendai\") is predominantly practised in [Nepal](Nepal \"Nepal\"), [Bhutan](Bhutan \"Bhutan\"), [China](China \"China\"), [Malaysia](Malaysia \"Malaysia\"), [Vietnam](Vietnam \"Vietnam\"), [Taiwan](Taiwan \"Taiwan\"), [Korea](Korea \"Korea\"), and [Japan](Japan \"Japan\"). [Tibetan Buddhism](Tibetan_Buddhism \"Tibetan Buddhism\"), a form of _Vajrayāna_, is practised in the [Himalayan states](Himalayan_states \"Himalayan states\") as well as in [Mongolia](Mongolia \"Mongolia\")[22] and [Russian Kalmykia](Kalmykia \"Kalmykia\") and [Tuva](Tuva \"Tuva\").[23] Japanese [Shingon](Shingon \"Shingon\") also preserves the Vajrayana tradition as transmitted to [China](Tangmi \"Tangmi\"). Historically, until the early [2nd millennium](2nd_millennium \"2nd millennium\"), Buddhism was widely practiced in [the Indian subcontinent before declining there](Decline_of_Buddhism_in_the_Indian_subcontinent \"Decline of Buddhism in the Indian subcontinent\");[24][25][26] it also had a foothold to some extent elsewhere in Asia, namely [Afghanistan](Afghanistan \"Afghanistan\"), [Turkmenistan](Turkmenistan \"Turkmenistan\"), [Uzbekistan](Uzbekistan \"Uzbekistan\"), and [Tajikistan](Tajikistan \"Tajikistan\").[27]\n## Etymology\n\nThe names **Buddha Dharma** and **Bauddha Dharma** come from [Sanskrit](Sanskrit \"Sanskrit\"): बुद्ध धर्म and बौद्ध धर्म respectively (\"doctrine of the Enlightened One\" and \"doctrine of Buddhists\"). The term Dharmavinaya comes from Sanskrit: धर्मविनय, literally meaning \"doctrines [and] disciplines\".[28]\n\n[The Buddha](The_Buddha \"The Buddha\") (\"the Awakened One\") was a [Śramaṇa](%C5%9Arama%E1%B9%87a \"Śramaṇa\") who lived in [South Asia](South_Asia \"South Asia\") c. 6th or 5th century BCE.[29][30] Followers of Buddhism, called _Buddhists_ in English, referred to themselves as _Sakyan_ -s or _Sakyabhiksu_ in ancient India.[31][32] Buddhist scholar Donald S. Lopez asserts they also used the term _Bauddha_ ,[33] although scholar Richard Cohen asserts that that term was used only by outsiders to describe Buddhists.[34]\n# The Buddha\n\nDetails of the Buddha's life are mentioned in many [Early Buddhist Texts](Early_Buddhist_Texts \"Early Buddhist Texts\") but are inconsistent. His social background and life details are difficult to prove, and the precise dates are uncertain, although the 5th century BCE seems to be the best estimate.[35]\n\nEarly texts give his personal name as Siddhattha (Sanskrit: Siddhārtha) and his clan name as Gotama (Sanskrit: Gautama). He was born in [Lumbini](Lumbini \"Lumbini\"), present-day [Nepal](Nepal \"Nepal\")—supported by archaeological evidence, including an inscription at Lumbini attributed to Emperor Ashoka (3rd century BCE), confirming it as the Buddha's birthplace.[](https://whc.unesco.org/en/list/666/)—and grew up in [Kapilavastu](Kapilavastu_\\(ancient_city\\) \"Kapilavastu \\(ancient city\\)\"), a town in the [Ganges Plain](Indo-Gangetic_Plain \"Indo-Gangetic Plain\"), near the modern Nepal–India border, and he spent his life in what is now modern [Bihar](Bihar \"Bihar\") and [Uttar Pradesh](Uttar_Pradesh \"Uttar Pradesh\").[43][35] Some hagiographic legends state that his father was a king named [Suddhodana](%C5%9Auddhodana \"Śuddhodana\"), his mother was [Queen Maya](Maya_\\(mother_of_the_Buddha\\) \"Maya \\(mother of the Buddha\\)\").[44] Scholars such as [Richard Gombrich](Richard_Gombrich \"Richard Gombrich\") consider this a dubious claim because a combination of evidence suggests he was born in the [Shakya](Shakya \"Shakya\") community, which was governed by a [small oligarchy or republic-like council](Ga%E1%B9%87asa%E1%B9%85gha \"Gaṇasaṅgha\") where there were no ranks but where seniority mattered instead.[45] Some of the stories about the Buddha, his life, his teachings, and claims about the society he grew up in may have been invented and interpolated at a later time into the Buddhist texts.[46][47]\n\nVarious details about the Buddha's background are contested in modern scholarship. For example, Buddhist texts assert that Buddha described himself as a [kshatriya](Kshatriya \"Kshatriya\") (warrior class), but Gombrich writes that little is known about his father and there is no proof that his father even knew the term _kshatriya_.[48] ([Mahavira](Mahavira \"Mahavira\"), whose teachings helped establish the ancient religion [Jainism](Jainism \"Jainism\"), is also claimed to be ksatriya by his early followers.[49]) \n\nAccording to early texts such as the Pali _Ariyapariyesanā-sutta_ (\"The discourse on the noble quest\", [MN](Majjhima_Nik%C4%81ya \"Majjhima Nikāya\") 26) and its Chinese parallel at [MĀ](Madhyama_Agama \"Madhyama Agama\") 204, Gautama was moved by the suffering (_[dukkha](Dukkha \"Dukkha\")_) of life and death, and its [endless repetition](Samsara \"Samsara\") due to [rebirth](Rebirth_\\(Buddhism\\) \"Rebirth \\(Buddhism\\)\").[50] He thus set out on a quest to find liberation from suffering (also known as \"[nirvana](Nirvana_\\(Buddhism\\) \"Nirvana \\(Buddhism\\)\")\").[51] Early texts and biographies state that Gautama first studied under two teachers of meditation, namely [Āḷāra Kālāma](%C4%80%E1%B8%B7%C4%81ra_K%C4%81l%C4%81ma \"Āḷāra Kālāma\") (Sanskrit: Arada Kalama) and [Uddaka Ramaputta](Uddaka_R%C4%81maputta \"Uddaka Rāmaputta\") (Sanskrit: Udraka Ramaputra), learning meditation and philosophy, particularly the meditative attainment of \"the sphere of nothingness\" from the former, and \"the sphere of neither perception nor non-perception\" from the latter.[52][53]\n\nFinding these teachings to be insufficient to attain his goal, he turned to the practice of severe [asceticism](Asceticism \"Asceticism\"), which included a strict [fasting](Fasting \"Fasting\") regime and various forms of [breath control](Pranayama \"Pranayama\").[56] This too fell short of attaining his goal, and then he turned to the meditative practice of _[dhyana](Dhy%C4%81na_in_Buddhism \"Dhyāna in Buddhism\")_. He famously sat in [meditation](Meditation \"Meditation\") under a _[Ficus religiosa](Ficus_religiosa \"Ficus religiosa\")_ tree—now called the [Bodhi Tree](Bodhi_Tree \"Bodhi Tree\")—in the town of [Bodh Gaya](Bodh_Gaya \"Bodh Gaya\") and attained \"Awakening\" ([Bodhi](Enlightenment_in_Buddhism \"Enlightenment in Buddhism\")).[57]\n\nAccording to various early texts like the _Mahāsaccaka-sutta,_ and the _[Samaññaphala Sutta](Sama%C3%B1%C3%B1aphala_Sutta \"Samaññaphala Sutta\"),_ on awakening, the Buddha gained insight into the workings of karma and his former lives, as well as achieving the ending of the mental defilements (_[asavas](Asava \"Asava\")_), the ending of suffering, and the end of rebirth in [saṃsāra](Sa%E1%B9%83s%C4%81ra \"Saṃsāra\").[56] This event also brought certainty about the [Middle Way](Middle_Way \"Middle Way\") as the right path of spiritual practice to end suffering.[12][13] As a [fully enlightened Buddha](Buddhahood#Samyaksambuddha \"Buddhahood\"), he attracted followers and founded a _[Sangha](Sangha_\\(Buddhism\\) \"Sangha \\(Buddhism\\)\")_ (monastic order).[58] He spent the rest of his life teaching the [Dharma](Dharma \"Dharma\") he had discovered, and then died, achieving \"[final nirvana](Parinirvana \"Parinirvana\")\", at the age of 80 in [Kushinagar](Kushinagar \"Kushinagar\"), India.[59][38]\n# Worldview\n\nThe term \"Buddhism\" is an occidental neologism, commonly (and \"rather roughly\" according to [Donald S. Lopez Jr.](Donald_S._Lopez_Jr. \"Donald S. Lopez Jr.\")) used as a translation for the [Dharma](Dharma \"Dharma\") of the [Buddha](Gautama_Buddha \"Gautama Buddha\"), _fójiào_ in Chinese, _bukkyō_ in Japanese, _nang pa sangs rgyas pa'i chos_ in Tibetan, _buddhadharma_ in Sanskrit, _buddhaśāsana_ in Pali.[65]\n\n## Four Noble Truths – _dukkha_ and its ending\n\nThe Four Noble Truths, or the truths of the [Noble Ones](Arhat \"Arhat\"),[66] express the basic orientation of Buddhism: everything is impermanent, yet we [crave and cling](Up%C4%81d%C4%81na \"Upādāna\") to [impermanent states and things](Sa%E1%B9%85kh%C4%81ra#Conditioned_things \"Saṅkhāra\"), which is _dukkha_ , \"incapable of satisfying\" and painful.[67][68] This keeps us caught in [saṃsāra](Sa%E1%B9%83s%C4%81ra_\\(Buddhism\\) \"Saṃsāra \\(Buddhism\\)\"), metaphysicallty interpreted as the endless cycle of repeated [rebirth](Rebirth_\\(Buddhism\\) \"Rebirth \\(Buddhism\\)\"), dukkha and dying again;[74] also interpreted as a psychological cycle of repetitious rebirth of the ego. \n\nBut there is a way to [liberation](Moksha \"Moksha\") from this endless cycle[74] to the state of [nirvana](Nirvana \"Nirvana\"), namely following the [Noble Eightfold Path](Noble_Eightfold_Path \"Noble Eightfold Path\").[74]\n\nThe truth of _[dukkha](Dukkha \"Dukkha\")_ is the basic insight that life in this mundane world, with its clinging and craving to [impermanent states and things](Sa%E1%B9%85kh%C4%81ra#Conditioned_things \"Saṅkhāra\")[67] is _dukkha_ , and unsatisfactory.[69][80][web 1] _Dukkha_ can be translated as \"incapable of satisfying\",[web 5] \"the unsatisfactory nature and the general insecurity of all [conditioned phenomena](Sa%E1%B9%85kh%C4%81ra#Conditioned_things \"Saṅkhāra\")\"; or \"painful\".[67][68] _Dukkha_ is most commonly translated as \"suffering\", but this is inaccurate, since it refers not to episodic suffering, but to the intrinsically unsatisfactory nature of temporary states and things, including pleasant but temporary experiences.[74] We expect happiness from states and things which are impermanent, and therefore cannot attain real happiness. \n\nThe Four Noble Truths are: \n\n* _[dukkha](Dukkha \"Dukkha\")_ (\"not being at ease\", \"suffering\") is an innate characteristic of the perpetual cycle (_[samsara](Samsara \"Samsara\")_ , lit. 'wandering') of [grasping](Up%C4%81d%C4%81na \"Upādāna\") at things, ideas and habits\n* _samudaya_ (origin, arising, combination; \"cause\"): _dukkha_ is caused by, or arises with, _[taṇhā](Ta%E1%B9%87h%C4%81 \"Taṇhā\")_ (\"craving,\" \"desire\" or \"attachment,\" literally \"thirst\")\n* _[nirodha](Nirodha \"Nirodha\")_ (cessation, ending, confinement): _dukkha_ can be ended or contained by the confinement or letting go of _taṇhā_\n* _marga_ (path) is the path leading to the confinement of _taṇhā_ and _dukkha_ , classically the [Noble Eightfold Path](Noble_Eightfold_Path \"Noble Eightfold Path\") but also summarized in [other paths to liberation](Buddhist_paths_to_liberation \"Buddhist paths to liberation\")\n\n## Three marks of existence\n\nBuddhism teaches that the idea that anything is permanent or that there is self in any being is ignorance or misperception (_[avijjā](Avidy%C4%81_\\(Buddhism\\) \"Avidyā \\(Buddhism\\)\")_), and that this is the primary source of clinging and dukkha.[86][87][88]\n\nIgnorance is countered by insight (_[paññā](Praj%C3%B1%C4%81_\\(Buddhism\\) \"Prajñā \\(Buddhism\\)\")_); most schools of Buddhism, therefore, teach [three marks of existence](Three_marks_of_existence \"Three marks of existence\"), which fundamentally characterize all phenomena:[89]\n\n* _[Dukkha](Dukkha \"Dukkha\")_ : unease, suffering\n* _[Anicca](Impermanence_\\(Buddhism\\) \"Impermanence \\(Buddhism\\)\")_ : impermanence\n* _[Anattā](Anatt%C4%81 \"Anattā\")_ : non-self; living things have no permanent immanent soul or essence[90][91][92]\n\nSome schools describe four characteristics or \"four seals of the Dharma\", adding to the above \n\n* [Nirvana](Nirvana \"Nirvana\") is peaceful/peace (_śānta/śānti_)[93][94]\n\n## The cycle of rebirth\n\n### Saṃsāra\n\n_Saṃsāra_ means \"wandering\" or \"world\", with the connotation of cyclic, circuitous change.[95][96] It refers to the theory of rebirth and \"cyclicality of all life, matter, existence\", a fundamental assumption of Buddhism, as with all major Indian religions.[96][97] Samsara in Buddhism is considered to be _[dukkha](Dukkha \"Dukkha\")_ , unsatisfactory and painful,[98] perpetuated by desire and _[avidya](Avidy%C4%81_\\(Buddhism\\) \"Avidyā \\(Buddhism\\)\")_ (ignorance), and the resulting [karma](Karma \"Karma\").[96][99][100] Liberation from this cycle of existence, _nirvana_ , has been the foundation and the most important historical justification of Buddhism.[101][102]\n\nBuddhist texts assert that rebirth can occur in six realms of existence, namely three good realms (heavenly, demi-god, human) and three evil realms (animal, hungry ghosts, hellish).[104] Samsara ends if a person attains [nirvana](Nirvana \"Nirvana\"), the \"blowing out\" of the afflictions through insight into [impermanence](Impermanence \"Impermanence\") and \"[non-self](Anatta \"Anatta\").\"[104][105][106]\n\n### Rebirth\n\nRebirth refers to a process whereby beings go through a succession of lifetimes as one of many possible forms of [sentient life](Sentient_beings_\\(Buddhism\\) \"Sentient beings \\(Buddhism\\)\"), each running from conception to death.[107] In Buddhist thought, this rebirth does not involve a [soul](Soul \"Soul\") or any fixed substance. This is because the Buddhist doctrine of [anattā](Anatta \"Anatta\") (Sanskrit: _anātman_ , no-self doctrine) rejects the concepts of a permanent self or an unchanging, eternal soul found in other religions.[108][109]\n\nThe Buddhist traditions have traditionally disagreed on what it is in a person that is reborn, as well as how quickly the rebirth occurs after death.[110][111] Some Buddhist traditions assert that \"no self\" doctrine means that there is no enduring self, but there is _avacya_ (inexpressible) personality (_[pudgala](Pudgalavada \"Pudgalavada\")_) which migrates from one life to another.[110] The majority of Buddhist traditions, in contrast, assert that [vijñāna](Vij%C3%B1%C4%81na \"Vijñāna\") (a person's consciousness) though evolving, exists as a continuum and is the mechanistic basis of what undergoes the rebirth process.[69][110] The quality of one's rebirth depends on the [merit](Merit_\\(Buddhism\\) \"Merit \\(Buddhism\\)\") or demerit gained by one's karma (i.e., actions), as well as that accrued on one's behalf by a family member.[110] Buddhism also developed [a complex cosmology](Buddhist_cosmology \"Buddhist cosmology\") to explain the various realms or planes of rebirth.[98]\n\n### Karma\n\n[In Buddhism](Karma_in_Buddhism \"Karma in Buddhism\"), [karma](Karma \"Karma\") (from [Sanskrit](Sanskrit \"Sanskrit\"): \"action, work\") drives _[saṃsāra](Sa%E1%B9%83s%C4%81ra \"Saṃsāra\")_ —the endless cycle of suffering and rebirth for each being. Good, skilful deeds (Pāli: _kusala_) and bad, unskilful deeds (Pāli: _akusala_) produce \"seeds\" in the unconscious receptacle (_ālaya_) that mature later either in this life or in a subsequent [rebirth](Rebirth_\\(Buddhism\\) \"Rebirth \\(Buddhism\\)\").[113][114] The existence of karma is a core belief in Buddhism, as with all major Indian religions, and it implies neither fatalism nor that everything that happens to a person is caused by karma.[115] (Diseases and suffering induced by the disruptive actions of other people are examples of non-karma suffering.[115]) \n\nA central aspect of Buddhist theory of karma is that intent (_[cetanā](Cetan%C4%81 \"Cetanā\")_) matters and is essential to bring about a consequence or _[phala](Phala \"Phala\")_ \"fruit\" or [vipāka](Vip%C4%81ka \"Vipāka\") \"result\".[116] The emphasis on intent in Buddhism marks a difference from the karmic theory of Jainism, where karma accumulates with or without intent.[117][118] The emphasis on intent is also found in Hinduism, and Buddhism may have influenced karma theories of Hinduism.[119]\n\nIn Buddhism, good or bad karma accumulates even if there is no physical action, and just having ill or good thoughts creates karmic seeds; thus, actions of body, speech or mind all lead to karmic seeds.[115] In the Buddhist traditions, life aspects affected by the law of karma in past and current births of a being include the form of rebirth, realm of rebirth, social class, character and major circumstances of a lifetime.[115][120][121] According to the theory, it operates like the laws of physics, without external intervention, on every being in all [six realms](Samsara_\\(Buddhism\\) \"Samsara \\(Buddhism\\)\") of existence including human beings and gods.[115][122]\n\nA notable aspect of the karma theory in modern Buddhism is merit transfer.[123][124] A person accumulates merit not only through intentions and ethical living, but also is able to gain merit from others by exchanging goods and services, such as through _dāna_ (charity to monks or nuns).[125] The theory also states a person can transfer one's own good karma to living family members and ancestors.[124]\n\nThis Buddhist idea may have roots in the _quid-pro-quo_ exchange beliefs of the Hindu Vedic rituals.[126] The \"karma merit transfer\" concept has been controversial, not accepted in later Jainism and Hinduism traditions, unlike Buddhism where it was adopted in ancient times and remains a common practice.[123] According to Bruce Reichenbach, the \"merit transfer\" idea was generally absent in early Buddhism and may have emerged with the rise of Mahayana Buddhism; he adds that while major Hindu schools such as Yoga, Advaita Vedanta and others do not believe in merit transfer, some bhakti Hindu traditions later adopted the idea just like Buddhism.[127]\n\n## Liberation\n\nThe cessation of the _[kleshas](Kleshas_\\(Buddhism\\) \"Kleshas \\(Buddhism\\)\")_ and the attainment of [nirvana](Nirvana \"Nirvana\") (_nibbāna_), with which the cycle of rebirth ends, has been the primary and the [soteriological](Soteriological \"Soteriological\") goal of the Buddhist path for monastic life since the time of the Buddha.[76][128][129] The term \"path\" is usually taken to mean the [Noble Eightfold Path](Noble_Eightfold_Path \"Noble Eightfold Path\"), but [other versions](Buddhist_Paths_to_liberation \"Buddhist Paths to liberation\") of \"the path\" can also be found in the Nikayas.[131] In some passages in the Pali Canon, a distinction is being made between right knowledge or insight (_sammā-ñāṇa_), and right liberation or release (_sammā-vimutti_), as the means to attain cessation and liberation.[131][132]\n\nNirvana literally means \"blowing out, quenching, becoming extinguished\".[133][134] In early Buddhist texts, it is the state of restraint and self-control that leads to the \"blowing out\" and the ending of the cycles of sufferings associated with rebirths and redeaths.[135][136][137] Many later Buddhist texts describe nirvana as identical with _[anatta](Anatta \"Anatta\")_ with complete \"emptiness, nothingness\".[138][139][140] In some texts, the state is described with greater detail, such as passing through the gate of emptiness (_sunyata_)—realising that there is no soul or self in any living being, then passing through the gate of signlessness (_animitta_)—realising that nirvana cannot be perceived, and finally passing through the gate of wishlessness (_apranihita_)—realising that nirvana is the state of not even wishing for nirvana.[128][142]\n\nThe nirvana state has been described in Buddhist texts partly in a manner similar to other Indian religions, as the state of complete liberation, enlightenment, highest happiness, bliss, fearlessness, freedom, permanence, non-dependent origination, unfathomable, and indescribable.[144][145] It has also been described in part differently, as a state of spiritual release marked by \"emptiness\" and realisation of _[non-self](Anatta \"Anatta\")_.[146][147][148]\n\nWhile Buddhism considers the liberation from [saṃsāra](Sa%E1%B9%83s%C4%81ra_\\(Buddhism\\) \"Saṃsāra \\(Buddhism\\)\") as the ultimate spiritual goal, in traditional practice, the primary focus of a vast majority of lay Buddhists has been to seek and accumulate merit through good deeds, donations to monks and various Buddhist rituals in order to gain better rebirths rather than nirvana.[151][152]\n\n## Dependent arising\n\n_Pratityasamutpada_ , also called \"dependent arising, or dependent origination\", is the Buddhist theory to explain the nature and relations of being, becoming, existence and ultimate reality. Buddhism asserts that there is nothing independent, except the state of nirvana.[155] All physical and mental states depend on and arise from other pre-existing states, and in turn from them arise other dependent states while they cease.[156]\n\nThe 'dependent arisings' have a causal conditioning, and thus _Pratityasamutpada_ is the Buddhist belief that causality is the basis of [ontology](Ontology \"Ontology\"), not a creator God nor the ontological Vedic concept called universal Self ([Brahman](Brahman \"Brahman\")) nor any other 'transcendent creative principle'.[157][158] However, Buddhist thought does not understand causality in terms of Newtonian mechanics; rather it understands it as conditioned arising.[159][160] In Buddhism, dependent arising refers to conditions created by a plurality of causes that necessarily co-originate a phenomenon within and across lifetimes, such as karma in one life creating conditions that lead to rebirth in one of the realms of existence for another lifetime.[161][162][163]\n\nBuddhism applies the theory of dependent arising to explain origination of endless cycles of _dukkha_ and rebirth, through [Twelve Nidānas](Twelve_Nid%C4%81nas \"Twelve Nidānas\") or \"twelve links\". It states that because [Avidyā](Avidy%C4%81_\\(Buddhism\\) \"Avidyā \\(Buddhism\\)\") (ignorance) exists, [Saṃskāras](Sa%E1%B9%85kh%C4%81ra \"Saṅkhāra\") (karmic formations) exist; because Saṃskāras exist therefore [Vijñāna](Vij%C3%B1%C4%81na \"Vijñāna\") (consciousness) exists; and in a similar manner it links [Nāmarūpa](N%C4%81mar%C5%ABpa \"Nāmarūpa\") (the sentient body), [Ṣaḍāyatana](%E1%B9%A2a%E1%B8%8D%C4%81yatana \"Ṣaḍāyatana\") (our six senses), [Sparśa](Spar%C5%9Ba \"Sparśa\") (sensory stimulation), [Vedanā](Vedan%C4%81 \"Vedanā\") (feeling), [Taṇhā](Ta%E1%B9%87h%C4%81 \"Taṇhā\") (craving), [Upādāna](Up%C4%81d%C4%81na \"Upādāna\") (grasping), [Bhava](Bhava \"Bhava\") (becoming), [Jāti](J%C4%81ti_\\(Buddhism\\) \"Jāti \\(Buddhism\\)\") (birth), and [Jarāmaraṇa](Jar%C4%81mara%E1%B9%87a \"Jarāmaraṇa\") (old age, death, sorrow, and pain).[164][165] By breaking the circuitous links of the Twelve Nidanas, Buddhism asserts that liberation from these endless cycles of rebirth and dukkha can be attained.[166]\n\n## Not-Self and Emptiness\n\nA related doctrine in Buddhism is that of _anattā_ (Pali) or _anātman_ (Sanskrit). It is the view that there is no unchanging, permanent self, soul or essence in phenomena.[167] The Buddha and Buddhist philosophers who follow him such as Vasubandhu and Buddhaghosa, generally argue for this view by analyzing the person through the schema of the [five aggregates](Five_aggregates \"Five aggregates\"), and then attempting to show that none of these five components of personality can be permanent or absolute.[168] This can be seen in Buddhist discourses such as the _[Anattalakkhana Sutta](Anattalakkhana_Sutta \"Anattalakkhana Sutta\")_. \n\n\"Emptiness\" or \"voidness\" (Skt _: Śūnyatā_ , Pali: _Suññatā)_ , is a related concept with many different interpretations throughout the various Buddhisms. In early Buddhism, it was commonly stated that all five aggregates are void (_rittaka_), hollow (_tucchaka_), coreless (_asāraka_), for example as in the _Pheṇapiṇḍūpama Sutta_ (SN 22:95).[169] Similarly, in Theravada Buddhism, it often means that the five aggregates are empty of a Self.[170]\n\nEmptiness is a central concept in Mahāyāna Buddhism, especially in [Nagarjuna](Nagarjuna \"Nagarjuna\")'s [Madhyamaka](Madhyamaka \"Madhyamaka\") school, and in the _[Prajñāpāramitā](Prajnaparamita \"Prajnaparamita\") sutras_. In Madhyamaka philosophy, emptiness is the view which holds that all phenomena are without any _[svabhava](Svabhava \"Svabhava\")_ (literally \"own-nature\" or \"self-nature\"), and are thus without any underlying essence, and so are \"empty\" of being independent. This doctrine sought to refute the heterodox theories of _svabhava_ circulating at the time.[171]\n\n## The Three Jewels\n\nAll forms of Buddhism revere and take spiritual refuge in the \"three jewels\" (_triratna_): Buddha, Dharma and Sangha.[172]\n\n### Buddha\n\nWhile all varieties of Buddhism revere \"Buddha\" and \"buddhahood\", they have different views on what these are. Regardless of their interpretation, the concept of Buddha is central to all forms of Buddhism. \n\nIn Theravada Buddhism, a Buddha is someone who has become awake through their own efforts and insight. They have put an end to their cycle of rebirths and have ended all unwholesome mental states which lead to bad action and thus are morally perfected.[173] While subject to the limitations of the human body in certain ways (for example, in the early texts, the Buddha suffers from backaches), a Buddha is said to be \"deep, immeasurable, hard-to-fathom as is the great ocean\", and also has immense psychic powers ([abhijñā](Abhij%C3%B1%C4%81 \"Abhijñā\")).[174]\n\nMahāyāna Buddhism meanwhile, has a vastly expanded [cosmology](Buddhist_cosmology \"Buddhist cosmology\"), with various [Buddhas](Buddhahood \"Buddhahood\") and other holy beings (_aryas_) residing in different realms. Mahāyāna texts not only revere numerous [Buddhas](Buddhist_deities#Buddhas \"Buddhist deities\") besides [Shakyamuni](The_Buddha \"The Buddha\"), such as [Amitabha](Amit%C4%81bha \"Amitābha\") and [Vairocana](Vairochana \"Vairocana\"), but also see them as transcendental or supramundane (_lokuttara_) beings.[175] Mahāyāna Buddhism holds that these other Buddhas in other realms can be contacted and are able to benefit beings in this world.[176] In Mahāyāna, a Buddha is a kind of \"spiritual king\", a \"protector of all creatures\" with a lifetime that is countless of eons long, rather than just a human teacher who has transcended the world after death.[177] Shakyamuni's life and death on earth is then usually understood as a \"mere appearance\" or \"a manifestation skilfully projected into earthly life by a long-enlightened transcendent being, who is still available to teach the faithful through visionary experiences\".[177][178]\n\n### Dharma\n\nThe second of the three jewels is \"Dharma\" (Pali: Dhamma), which in Buddhism refers to the Buddha's teaching, which includes all of the main ideas outlined above. While this teaching reflects the true nature of reality, it is not a belief to be clung to, but a pragmatic teaching to be put into practice. It is likened to a raft which is \"for crossing over\" (to nirvana) not for holding on to.[179] It also refers to the universal law and cosmic order which that teaching both reveals and relies upon.[180] It is an everlasting principle which applies to all beings and worlds. In that sense it is also the ultimate truth and reality about the universe, it is thus \"the way that things really are\". \n\n### Sangha\n\nThe third \"jewel\" which Buddhists take refuge in is the \"Sangha\", which refers to the monastic community of monks and nuns who follow Gautama Buddha's monastic discipline which was \"designed to shape the Sangha as an ideal community, with the optimum conditions for spiritual growth.\"[181] The Sangha consists of those who have chosen to follow the Buddha's ideal way of life, which is one of celibate monastic renunciation with minimal material possessions (such as an alms bowl and robes).[182]\n\nThe Sangha is seen as important because they preserve and pass down Buddha Dharma. As Gethin states \"the Sangha lives the teaching, preserves the teaching as Scriptures and teaches the wider community. Without the Sangha there is no Buddhism.\"[183] The Sangha also acts as a \"field of merit\" for laypersons, allowing them to make spiritual merit or goodness by donating to the Sangha and supporting them. In return, they keep their duty to preserve and spread the Dharma everywhere for the good of the world.[184]\n\nThere is also a separate definition of Sangha, referring to those who have attained any [stage of awakening](Four_stages_of_enlightenment \"Four stages of enlightenment\"), whether or not they are monastics. This sangha is called the [_āryasaṅgha_](%C5%9Ar%C4%81vaka#The_community_of_disciples \"Śrāvaka\") \"noble Sangha\".[185] All forms of Buddhism generally reveres these _[āryas](Arya_\\(Buddhism\\) \"Arya \\(Buddhism\\)\")_ (Pali: _ariya_ , \"noble ones\" or \"holy ones\") who are spiritually attained beings. Aryas have attained the fruits of the Buddhist path.[186]\n\n## Other key Mahāyāna views\n\nMahāyāna Buddhism also differs from Theravada and the other schools of early Buddhism in promoting several unique doctrines which are contained in Mahāyāna sutras and philosophical treatises. \n\nOne of these is the unique interpretation of emptiness and dependent origination found in the Madhyamaka school. Another very influential doctrine for Mahāyāna is the main philosophical view of the [Yogācāra](Yogachara \"Yogachara\") school variously, termed _Vijñaptimātratā-vāda_ (\"the doctrine that there are only ideas\" or \"mental impressions\") or _Vijñānavāda_ (\"the doctrine of consciousness\"). According to Mark Siderits, what classical Yogācāra thinkers like Vasubandhu had in mind is that we are only ever aware of mental images or impressions, which may appear as external objects, but \"there is actually no such thing outside the mind\".[187] There are several interpretations of this main theory, many scholars see it as a type of Idealism, others as a kind of phenomenology.[188]\n\nAnother very influential concept unique to Mahāyāna is that of \"Buddha-nature\" (_buddhadhātu_) or \"Tathagata-womb\" (_tathāgatagarbha_). Buddha-nature is a concept found in some 1st-millennium CE Buddhist texts, such as the _[Tathāgatagarbha sūtras](Tath%C4%81gatagarbha_s%C5%ABtras \"Tathāgatagarbha sūtras\")_. According to Paul Williams these [Sutras](Sutra \"Sutra\") suggest that 'all sentient beings contain a Tathagata' as their 'essence, core inner nature, Self'.[189] According to Karl Brunnhölzl \"the earliest mahayana sutras that are based on and discuss the notion of tathāgatagarbha as the buddha potential that is innate in all sentient beings began to appear in written form in the late second and early third century.\"[191] For some, the doctrine seems to conflict with the Buddhist anatta doctrine (non-Self), leading scholars to posit that the _Tathāgatagarbha Sutras_ were written to promote Buddhism to non-Buddhists.[192][193] This can be seen in texts like the _[Laṅkāvatāra Sūtra](La%E1%B9%85k%C4%81vat%C4%81ra_S%C5%ABtra \"Laṅkāvatāra Sūtra\")_ , which state that Buddha-nature is taught to help those who have fear when they listen to the teaching of anatta.[194] Buddhist texts like the _[Ratnagotravibhāga](Ratnagotravibh%C4%81ga \"Ratnagotravibhāga\")_ clarify that the \"Self\" implied in _Tathagatagarbha_ doctrine is actually \"[not-self](Anatt%C4%81 \"Anattā\").\"[195][196]\n# Paths to liberation\n\nThe _[Bodhipakkhiyādhammā](Bodhipakkhiy%C4%81dhamm%C4%81 \"Bodhipakkhiyādhammā\")_ are seven lists of qualities or factors that promote spiritual awakening (_bodhi_). Each list is a short summary of the Buddhist path, and the seven lists substantially overlap. The best-known list in the West is the [Noble Eightfold Path](Noble_Eightfold_Path \"Noble Eightfold Path\"), but a wide variety of paths and models of progress have been used and described in the different Buddhist traditions. However, they generally share basic practices such as _sila_ (ethics), _samadhi_ (meditation, _dhyana_) and _prajña_ (wisdom), which are known as the three trainings. An important additional practice is a kind and compassionate attitude toward every living being and the world. [Devotion](Buddhist_devotion \"Buddhist devotion\") is also important in some Buddhist traditions, and in the Tibetan traditions visualisations of deities and mandalas are important. The value of textual study is regarded differently in the various Buddhist traditions. It is central to Theravada and highly important to Tibetan Buddhism, while the Zen tradition takes an ambiguous stance. \n\nAn important guiding principle of Buddhist practice is the [Middle Way](Middle_Way \"Middle Way\") (_madhyamapratipad_). It was a part of Buddha's first sermon, where he presented the [Noble Eightfold Path](Noble_Eightfold_Path \"Noble Eightfold Path\") that was a 'middle way' between the extremes of asceticism and hedonistic sense pleasures.[197][198] In Buddhism, states Harvey, the doctrine of \"dependent arising\" (conditioned arising, _pratītyasamutpāda_) to explain rebirth is viewed as the 'middle way' between the doctrines that a being has a \"permanent soul\" involved in rebirth (eternalism) and \"death is final and there is no rebirth\" (annihilationism).[199][200]\n\n### Paths to liberation in the early texts\n\nA common presentation style of the path (_mārga_) to liberation in the [Early Buddhist Texts](Early_Buddhist_Texts \"Early Buddhist Texts\") is the \"graduated talk\", in which the Buddha lays out a step-by-step training.[201]\n\nIn the early texts, numerous different sequences of the gradual path can be found.[202] One of the most important and widely used presentations among the various Buddhist schools is The [Noble Eightfold Path](Noble_Eightfold_Path \"Noble Eightfold Path\"), or \"Eightfold Path of the Noble Ones\" (Skt. _'āryāṣṭāṅgamārga'_). This can be found in various discourses, most famously in the _[Dhammacakkappavattana Sutta](Dhammacakkappavattana_Sutta \"Dhammacakkappavattana Sutta\")_ (The discourse on the turning of the [Dharma wheel](Dharma_Wheel \"Dharma Wheel\")). \n\nOther suttas such as the _Tevijja Sutta_ , and the _Cula-Hatthipadopama-sutta_ give a different outline of the path, though with many similar elements such as ethics and meditation.[202]\n\nAccording to Rupert Gethin, the path to awakening is also frequently summarized by another a short formula: \"abandoning the hindrances, practice of the four establishings of mindfulness, and development of the awakening factors\".[203]\n\n#### Noble Eightfold Path\n\nThe Eightfold Path consists of a set of eight interconnected factors or conditions, that when developed together, lead to the cessation of [dukkha](Dukkha \"Dukkha\").[204] These eight factors are: Right View (or Right Understanding), Right Intention (or Right Thought), Right Speech, Right Action, Right Livelihood, Right Effort, Right Mindfulness, and Right Concentration. \n\nThis Eightfold Path is the fourth of the [Four Noble Truths](Four_Noble_Truths \"Four Noble Truths\") and asserts the path to the cessation of _dukkha_ (suffering, pain, unsatisfactoriness).[205][206] The path teaches that the way of the enlightened ones stopped their craving, clinging and [karmic](Karma \"Karma\") accumulations, and thus ended their endless cycles of rebirth and suffering.[207][208][209]\n\nThe Noble Eightfold Path is grouped into [three basic divisions](Three_disciplines_of_Buddhism \"Three disciplines of Buddhism\"), as follows:[210][211][212]\n\n| Division  | Eightfold factor  | _Sanskrit, Pali_ | Description   |\n|-----------|-------------------|------------------|---------------|\n| Wisdom\u003cbr\u003e(Sanskrit: _[prajñā](Wisdom_in_Buddhism \"Wisdom in Buddhism\")_ ,\u003cbr\u003ePāli: _paññā_)  | 1. Right view  | _samyag dṛṣṭi,\u003cbr\u003esammā ditthi_ | The belief that there is an afterlife and not everything ends with death, that Buddha taught and followed a successful path to nirvana;[210] according to Peter Harvey, the right view is held in Buddhism as a belief in the Buddhist principles of [karma](Karma \"Karma\") and [rebirth](Rebirth_\\(Buddhism\\) \"Rebirth \\(Buddhism\\)\"), and the importance of the [Four Noble Truths](Four_Noble_Truths \"Four Noble Truths\") and the True Realities.[213]  |\n|   | 2. Right intention  | _samyag saṃkalpa,\u003cbr\u003esammā saṅkappa_ | Giving up home and adopting the life of a religious mendicant in order to follow the path;[210] this concept, states Harvey, aims at peaceful renunciation, into an environment of non-sensuality, non-ill-will (to lovingkindness), away from cruelty (to compassion).[213]  |\n| Moral virtues[211]\u003cbr\u003e(Sanskrit: _[śīla](%C5%9A%C4%ABla \"Śīla\")_ ,\u003cbr\u003ePāli: _sīla_)  | 3. Right speech  | _samyag vāc,\u003cbr\u003esammā vāca_ | No lying, no rude speech, no telling one person what another says about him, speaking that which leads to salvation.[210]  |\n|   | 4. Right action  | _samyag karman,\u003cbr\u003esammā kammanta_ | No killing or injuring, no taking what is not given; no sexual acts in monastic pursuit,[210] for lay Buddhists no sensual misconduct such as sexual involvement with someone married, or with an unmarried woman protected by her parents or relatives.[214][215][216]  |\n|   | 5. Right livelihood  | _samyag ājīvana,\u003cbr\u003esammā ājīva_ | For monks, beg to feed, only possessing what is essential to sustain life.[217] For lay Buddhists, the canonical texts state right livelihood as abstaining from wrong livelihood, explained as not becoming a source or means of suffering to sentient beings by cheating them, or harming or killing them in any way.[218][219]  |\n| Meditation[211]\u003cbr\u003e(Sanskrit and Pāli: _[samādhi](Sam%C4%81dhi \"Samādhi\")_)  | 6. Right effort  | _samyag vyāyāma,\u003cbr\u003esammā vāyāma_ | Guard against sensual thoughts; this concept, states Harvey, aims at preventing unwholesome states that disrupt meditation.[220]  |\n|   | 7. Right mindfulness  | _samyag smṛti,\u003cbr\u003esammā sati_ | Never be absent-minded, conscious of what one is doing; this, states Harvey, encourages mindfulness about impermanence of the body, feelings and mind, as well as to experience the five [skandhas](Skandha \"Skandha\"), the five hindrances, the four True Realities and seven factors of awakening.[220]  |\n|   | 8. Right concentration  | _samyag samādhi,\u003cbr\u003esammā samādhi_ | Correct meditation or concentration (_dhyana_), explained as the four jhānas.[210][221] |\n## Common practices\n\n### Hearing and learning the Dharma\n\nIn various suttas which present the graduated path taught by the Buddha, such as the _[Samaññaphala Sutta](Sama%C3%B1%C3%B1aphala_Sutta \"Samaññaphala Sutta\")_ and the _Cula-Hatthipadopama Sutta,_ the first step on the path is hearing the Buddha teach the Dharma. This then said to lead to the acquiring of confidence or faith in the Buddha's teachings.[202]\n\nMahayana Buddhist teachers such as [Yin Shun](Yin_Shun \"Yin Shun\") also state that hearing the Dharma and study of the Buddhist discourses is necessary \"if one wants to learn and practice the Buddha Dharma.\"[222] Likewise, in Indo-Tibetan Buddhism, the \"Stages of the Path\" (_Lamrim_) texts generally place the activity of listening to the Buddhist teachings as an important early practice.[223]\n\n### Refuge\n\nTraditionally, the first step in most Buddhist schools requires taking of the \"Three Refuges\", also called the Three Jewels ([Sanskrit](Sanskrit \"Sanskrit\"): _triratna_ , [Pali](Pali \"Pali\"): _tiratana_) as the foundation of one's religious practice.[224] This practice may have been influenced by the [Brahmanical](Hinduism \"Hinduism\") motif of the triple refuge, found in the _[Rigveda](Rigveda \"Rigveda\")_ 9.97.47, _Rigveda_ 6.46.9 and _[Chandogya Upanishad](Chandogya_Upanishad \"Chandogya Upanishad\")_ 2.22.3–4.[225] Tibetan Buddhism sometimes adds a fourth refuge, in the _[lama](Lama \"Lama\")_. The three refuges are believed by Buddhists to be protective and a form of reverence.[224]\n\nThe ancient formula which is repeated for taking refuge affirms that \"I go to the Buddha as refuge, I go to the Dhamma as refuge, I go to the Sangha as refuge.\"[226] Reciting the three refuges, according to Harvey, is considered not as a place to hide, rather a thought that \"purifies, uplifts and strengthens the heart\".[172]\n\n### _Śīla_ – Buddhist ethics\n\n_Śīla_ (Sanskrit) or _sīla_ (Pāli) is the concept of \"moral virtues\", that is the second group and an integral part of the Noble Eightfold Path.[213] It generally consists of right speech, right action and right livelihood.[213]\n\nOne of the most basic forms of ethics in Buddhism is the taking of \"precepts\". This includes the Five Precepts for laypeople, Eight or Ten Precepts for monastic life, as well as rules of Dhamma (_Vinaya_ or _Patimokkha_) adopted by a monastery.[227][228]\n\nOther important elements of Buddhist ethics include [giving or charity](D%C4%81na \"Dāna\") (_dāna_), [Mettā](Mett%C4%81 \"Mettā\") (Good-Will), Heedfulness ([Appamada](Appamada \"Appamada\")), 'self-respect' ([Hri](Hri_\\(Buddhism\\) \"Hri \\(Buddhism\\)\")) and 'regard for consequences' ([Apatrapya](Apatrapya \"Apatrapya\")). \n\n#### Precepts\n\nBuddhist scriptures explain the five precepts ([Pali](Pali_language \"Pali language\"): _pañcasīla_ ; [Sanskrit](Sanskrit_language \"Sanskrit language\"): _pañcaśīla_) as the minimal standard of Buddhist morality.[214] It is the most important system of morality in Buddhism, together with the [monastic rules](Patimokkha \"Patimokkha\").[229]\n\nThe five precepts are seen as a basic training applicable to all Buddhists. They are:[227][230][231]\n\n1. \"I undertake the training-precept (_sikkha-padam_) to abstain from onslaught on breathing beings.\" This includes ordering or causing someone else to kill. The Pali suttas also say one should not \"approve of others killing\" and that one should be \"scrupulous, compassionate, trembling for the welfare of all living beings\".[232]\n2. \"I undertake the training-precept to abstain from taking what is not given.\" According to Harvey, this also covers fraud, cheating, forgery as well as \"falsely denying that one is in debt to someone\".[233]\n3. \"I undertake the training-precept to abstain from misconduct concerning sense-pleasures.\" This generally refers to [adultery](Adultery \"Adultery\"), as well as rape and incest. It also applies to sex with those who are legally under the protection of a guardian. It is also interpreted in different ways in the varying Buddhist cultures.[234]\n4. \"I undertake the training-precept to abstain from false speech.\" According to Harvey this includes \"any form of lying, deception or exaggeration...even non-verbal deception by gesture or other indication...or misleading statements.\"[235] The precept is often also seen as including other forms of wrong speech such as \"divisive speech, harsh, abusive, angry words, and even idle chatter\".[236]\n5. \"I undertake the training-precept to abstain from alcoholic drink or drugs that are an opportunity for heedlessness.\" According to Harvey, intoxication is seen as a way to mask rather than face the sufferings of life. It is seen as damaging to one's mental clarity, mindfulness and ability to keep the other four precepts.[237]\n\nUndertaking and upholding the five precepts is based on the principle of [non-harming](Ahimsa \"Ahimsa\") ([Pāli](P%C4%81li \"Pāli\") and [Sanskrit](Sanskrit_language \"Sanskrit language\"): _ahiṃsa_).[238] The [Pali Canon](Pali_Canon \"Pali Canon\") recommends one to compare oneself with others, and on the basis of that, not to hurt others.[239] Compassion and a belief in [karmic retribution](Karma_\\(Buddhism\\) \"Karma \\(Buddhism\\)\") form the foundation of the precepts.[240][241] Undertaking the five precepts is part of regular lay devotional practice, both at home and at the local temple.[242][243] However, the extent to which people keep them differs per region and time.[244][243] They are sometimes referred to as the _[śrāvakayāna](%C5%9Ar%C4%81vakay%C4%81na \"Śrāvakayāna\") precepts_ in the [Mahāyāna](Mah%C4%81y%C4%81na \"Mahāyāna\") tradition, contrasting them with the [_bodhisattva_ precepts](Bodhisattva_Precepts \"Bodhisattva Precepts\").[245]\n\n#### Vinaya\n\nVinaya is the specific code of conduct for a _sangha_ of monks or nuns. It includes the [Patimokkha](Patimokkha \"Patimokkha\"), a set of 227 offences including 75 rules of decorum for monks, along with penalties for transgression, in the Theravadin tradition.[246] The precise content of the _[Vinaya Pitaka](Vinaya_Pitaka \"Vinaya Pitaka\")_ (scriptures on the Vinaya) differs in different schools and tradition, and different monasteries set their own standards on its implementation. The list of _pattimokkha_ is recited every fortnight in a ritual gathering of all monks.[246] Buddhist text with vinaya rules for monasteries have been traced in all Buddhist traditions, with the oldest surviving being the ancient Chinese translations.[247]\n\nMonastic communities in the Buddhist tradition cut normal social ties to family and community and live as \"islands unto themselves\".[248] Within a monastic fraternity, a _sangha_ has its own rules.[248] A monk abides by these institutionalised rules, and living life as the vinaya prescribes it is not merely a means, but very nearly the end in itself.[248] Transgressions by a monk on _Sangha_ vinaya rules invites enforcement, which can include temporary or permanent expulsion.[249]\n\n### Restraint and renunciation\n\nAnother important practice taught by the Buddha is the restraint of the senses (_indriyasamvara_). In the various graduated paths, this is usually presented as a practice which is taught prior to formal sitting meditation, and which supports meditation by weakening sense desires that are a [hindrance](Five_hindrances \"Five hindrances\") to meditation.[250] According to [Anālayo](Bhikkhu_Analayo \"Bhikkhu Analayo\"), sense restraint is when one \"guards the sense doors in order to prevent sense impressions from leading to desires and discontent\".[250] This is not an avoidance of sense impression, but a kind of mindful attention towards the sense impressions which does not dwell on their main features or signs (_nimitta_). This is said to prevent harmful influences from entering the mind.[251] This practice is said to give rise to an inner peace and happiness which forms a basis for concentration and insight.[251]\n\nA related Buddhist virtue and practice is renunciation, or the intent for desirelessness (_[nekkhamma](Nekkhamma \"Nekkhamma\")_).[252] Generally, renunciation is the giving up of actions and desires that are seen as unwholesome on the path, such as lust for sensuality and worldly things.[253] Renunciation can be cultivated in different ways. The practice of giving for example, is one form of cultivating renunciation. Another one is the giving up of lay life and becoming a monastic (_bhiksu_ or _bhiksuni_).[254] Practicing [celibacy](Celibacy \"Celibacy\") (whether for life as a monk, or temporarily) is also a form of renunciation.[255] Many [Jataka](Jataka_tales \"Jataka tales\") stories focus on how the Buddha practiced renunciation in past lives.[256]\n\nOne way of cultivating renunciation taught by the Buddha is the contemplation (_anupassana_) of the \"dangers\" (or \"negative consequences\") of sensual pleasure (_kāmānaṃ ādīnava_). As part of the graduated discourse, this contemplation is taught after the practice of giving and morality.[257]\n\nAnother related practice to renunciation and sense restraint taught by the Buddha is \"restraint in eating\" or moderation with food, which for monks generally means not eating after noon. Devout laypersons also follow this rule during special days of religious observance (_[uposatha](Uposatha \"Uposatha\")_).[258]\n\n### Mindfulness and clear comprehension\n\nThe training of the faculty called [\"mindfulness\"](Sati_\\(Buddhism\\) \"Sati \\(Buddhism\\)\") (Pali: _sati_ , Sanskrit: _smṛti,_ literally meaning \"recollection, remembering\") is central in Buddhism. According to Analayo, mindfulness is a full awareness of the present moment which enhances and strengthens memory.[259] The Indian Buddhist philosopher [Asanga](Asanga \"Asanga\") defined mindfulness thus: \"It is non-forgetting by the mind with regard to the object experienced. Its function is non-distraction.\"[260] According to Rupert Gethin, _sati_ is also \"an awareness of things in relation to things, and hence an awareness of their relative value\".[261]\n\nThere are different practices and exercises for training mindfulness in the early discourses, such as the four _[Satipaṭṭhānas](Satipatthana \"Satipatthana\")_ (Sanskrit: _smṛtyupasthāna_ , \"establishments of mindfulness\") and _[Ānāpānasati](Anapanasati \"Anapanasati\")_ (Sanskrit: _ānāpānasmṛti_ , \"mindfulness of breathing\"). \n\nA closely related mental faculty, which is often mentioned side by side with mindfulness, is _[sampajañña](Sampaja%C3%B1%C3%B1a \"Sampajañña\")_ (\"clear comprehension\"). This faculty is the ability to comprehend what one is doing and is happening in the mind, and whether it is being influenced by unwholesome states or wholesome ones.[262]\n\n### Meditation – _Sama-amādhi_ and _dhyāna_\n\nA wide range of meditation practices has developed in the Buddhist traditions, but \"meditation\" primarily refers to the attainment of _[samādhi](Sam%C4%81dhi_\\(Buddhism\\) \"Samādhi \\(Buddhism\\)\")_ and the practice of _[dhyāna](Dhy%C4%81na_in_Buddhism \"Dhyāna in Buddhism\")_ (Pali: _jhāna_). _Samādhi_ is a calm, undistracted, unified and concentrated state of awareness. It is defined by Asanga as \"one-pointedness of mind on the object to be investigated. Its function consists of giving a basis to knowledge (_jñāna_).\"[260] _Dhyāna_ is \"state of perfect equanimity and awareness (_upekkhā-sati-parisuddhi_),\" reached through focused mental training.[263]\n\nThe practice of _dhyāna_ aids in maintaining a calm mind and avoiding disturbance of this calm mind by mindfulness of disturbing thoughts and feelings.[264][note 16]\n\n#### Origins\n\nThe earliest evidence of yogis and their meditative tradition, states Karel Werner, is found in the [Keśin](Ke%C5%9Bin \"Keśin\") hymn 10.136 of the [Rigveda](Rigveda \"Rigveda\").[265] While evidence suggests [meditation](Meditation \"Meditation\") was practised in the centuries preceding the Buddha,[266] the meditative methodologies described in the Buddhist texts are some of the earliest among texts that have survived into the modern era.[267][268] These methodologies likely incorporate what existed before the Buddha as well as those first developed within Buddhism.[269][note 17]\n\nThere is no scholarly agreement on the origin and source of the practice of _dhyāna._ Some scholars, like Bronkhorst, see the _four dhyānas_ as a Buddhist invention.[273] Alexander Wynne argues that the Buddha learned _dhyāna_ from Brahmanical teachers.[274]\n\nWhatever the case, the Buddha taught meditation with a new focus and interpretation, particularly through the _four dhyānas_ methodology,[275] in which mindfulness is maintained.[276][277] Further, the focus of meditation and the underlying theory of liberation guiding the meditation has been different in Buddhism.[266][278][279] For example, states Bronkhorst, the verse 4.4.23 of the _Brihadaranyaka Upanishad_ with its \"become calm, subdued, quiet, patiently enduring, concentrated, one sees soul in oneself\" is most probably a meditative state.[280] The Buddhist discussion of meditation is without the concept of soul and the discussion criticises both the ascetic meditation of Jainism and the \"real self, soul\" meditation of Hinduism.[281]\n\n#### The formless attainments\n\nOften grouped into the _jhāna_ -scheme are four other meditative states, referred to in the early texts as _arupa samāpattis_ (formless attainments). These are also referred to in commentarial literature as immaterial/formless _jhānas_ (_arūpajhānas_). The first formless attainment is a place or realm of infinite space (_ākāsānañcāyatana_) without form or colour or shape. The second is termed the realm of infinite consciousness (_viññāṇañcāyatana_); the third is the realm of nothingness (_ākiñcaññāyatana_), while the fourth is the realm of \"neither perception nor non-perception\".[282] The four _rupa-jhānas_ in Buddhist practice leads to rebirth in successfully better _rupa_ Brahma heavenly realms, while _arupa-jhānas_ leads into arupa heavens.[283][284]\n\n#### Meditation and insight\n\nIn the Pali canon, the Buddha outlines two meditative qualities which are mutually supportive: _[samatha](Samatha \"Samatha\")_ (Pāli; Sanskrit: _śamatha_ ; \"calm\") and _[vipassanā](Vipassan%C4%81 \"Vipassanā\")_ (Sanskrit: _vipaśyanā_ , insight).[285] The Buddha compares these mental qualities to a \"swift pair of messengers\" who together help deliver the message of _nibbana_ (SN 35.245).[286]\n\nThe various Buddhist traditions generally see Buddhist meditation as being divided into those two main types.[287][288] Samatha is also called \"calming meditation\", and focuses on stilling and concentrating the mind i.e. developing samadhi and the four _dhyānas_. According to [Damien Keown](Damien_Keown \"Damien Keown\"), _vipassanā_ meanwhile, focuses on \"the generation of penetrating and critical insight (_paññā_)\".[289]\n\nThere are numerous doctrinal positions and disagreements within the different Buddhist traditions regarding these qualities or forms of meditation. For example, in the Pali _Four Ways to Arahantship Sutta_ (AN 4.170), it is said that one can develop calm and then insight, or insight and then calm, or both at the same time.[290] Meanwhile, in Vasubandhu's _Abhidharmakośakārikā_ , vipaśyanā is said to be practiced once one has reached samadhi by cultivating the four foundations of mindfulness (_smṛtyupasthāna_ s).[291]\n\nBeginning with comments by [La Vallee Poussin](Louis_de_La_Vall%C3%A9e-Poussin \"Louis de La Vallée-Poussin\"), a series of scholars have argued that these two meditation types reflect a tension between two different ancient Buddhist traditions regarding the use of _dhyāna,_ one which focused on insight based practice and the other which focused purely on _dhyāna_.[292][293] However, other scholars such as Analayo and Rupert Gethin have disagreed with this \"two paths\" thesis, instead seeing both of these practices as complementary.[293][294]\n\n#### The _Brahma-vihara_\n\nThe four immeasurables or four abodes, also called _Brahma-viharas_ , are virtues or directions for meditation in Buddhist traditions, which helps a person be reborn in the heavenly (Brahma) realm.[295][296][297] These are traditionally believed to be a characteristic of the deity Brahma and the heavenly abode he resides in.[298]\n\nThe four _Brahma-vihara_ are: \n\n1. Loving-kindness (Pāli: _[mettā](Mett%C4%81 \"Mettā\")_ , Sanskrit: _maitrī_) is active good will towards all;[296][299]\n2. Compassion (Pāli and Sanskrit: _[karuṇā](Karu%E1%B9%87%C4%81 \"Karuṇā\")_) results from _metta_ ; it is identifying the suffering of others as one's own;[296][299]\n3. Empathetic joy (Pāli and Sanskrit: _[muditā](Mudita \"Mudita\")_): is the feeling of joy because others are happy, even if one did not contribute to it; it is a form of sympathetic joy;[299]\n4. Equanimity (Pāli: _[upekkhā](Upekkha \"Upekkha\")_ , Sanskrit: _upekṣā_): is even-mindedness and serenity, treating everyone impartially.[296][299]\n\n#### Tantra, visualization and the subtle body\n\nSome Buddhist traditions, especially those associated with Tantric Buddhism (also known as Vajrayana and Secret Mantra) use images and symbols of deities and Buddhas in meditation. This is generally done by mentally visualizing a Buddha image (or some other mental image, like a symbol, a mandala, a syllable, etc.), and using that image to cultivate calm and insight. One may also visualize and identify oneself with the imagined deity.[300][301] While visualization practices have been particularly popular in Vajrayana, they may also found in Mahayana and Theravada traditions.[302]\n\nIn Tibetan Buddhism, unique tantric techniques which include visualization (but also [mantra](Mantra \"Mantra\") recitation, [mandalas](Mandala \"Mandala\"), and other elements) are considered to be much more effective than non-tantric meditations and they are one of the most popular meditation methods.[303] The methods of _[Unsurpassable Yoga Tantra](Anuttarayoga_Tantra \"Anuttarayoga Tantra\")_ , (_anuttarayogatantra_) are in turn seen as the highest and most advanced. Anuttarayoga practice is divided into two stages, the _Generation Stage_ and the _Completion Stage._ In the Generation Stage, one meditates on emptiness and visualizes oneself as a deity as well as visualizing its mandala. The focus is on developing clear appearance and divine pride (the understanding that oneself and the deity are one).[304] This method is also known as deity yoga (_devata yoga_). There are numerous meditation deities (_[yidam](Yidam \"Yidam\")_) used, each with a mandala, a circular symbolic map used in meditation.[305]\n\n### Insight and knowledge\n\n_Prajñā_ (Sanskrit) or _paññā_ (Pāli) is [wisdom](Wisdom \"Wisdom\"), or knowledge of the true nature of existence. Another term which is associated with _prajñā_ and sometimes is equivalent to it is _vipassanā_ (Pāli) or _vipaśyanā_ (Sanskrit), which is often translated as \"insight\". In Buddhist texts, the faculty of insight is often said to be cultivated through the four establishments of mindfulness.[306] In the early texts, _Paññā_ is included as one of the \"five faculties\" (_[indriya](Indriya \"Indriya\")_) which are commonly listed as important spiritual elements to be cultivated (see for example: AN I 16). _Paññā_ along with samadhi, is also listed as one of the \"trainings in the higher states of mind\" (_adhicittasikkha_).[306]\n\nThe Buddhist tradition regards ignorance ([_avidyā_](Avidy%C4%81_\\(Buddhism\\) \"Avidyā \\(Buddhism\\)\")), a fundamental ignorance, misunderstanding or mis-perception of the nature of reality, as one of the basic causes of _dukkha_ and _samsara_. Overcoming this ignorance is part of the path to awakening. This overcoming includes the contemplation of impermanence and the non-self nature of reality,[307][308] and this develops dispassion for the objects of [clinging](Up%C4%81d%C4%81na \"Upādāna\"), and liberates a being from _dukkha_ and _saṃsāra_.[309][310][311]\n\n_Prajñā_ is important in all Buddhist traditions. It is variously described as wisdom regarding the impermanent and [not-self](Anatt%C4%81 \"Anattā\") nature of dharmas (phenomena), the functioning of karma and rebirth, and knowledge of dependent origination.[312] Likewise, _vipaśyanā_ is described in a similar way, such as in the _[Paṭisambhidāmagga](Pa%E1%B9%ADisambhid%C4%81magga \"Paṭisambhidāmagga\")_ , where it is said to be the contemplation of things as impermanent, unsatisfactory and [not-self](Anatt%C4%81 \"Anattā\").[313]\n\n### Devotion\n\nMost forms of Buddhism \"consider _[saddhā](Faith_in_Buddhism \"Faith in Buddhism\")_ (Sanskrit: _śraddhā_), 'trustful confidence' or 'faith', as a quality which must be balanced by wisdom, and as a preparation for, or accompaniment of, meditation.\"[314] Because of this devotion (Sanskrit: bhakti; Pali: bhatti) is an important part of the practice of most Buddhists.[315] [Devotional practices](Buddhist_devotion \"Buddhist devotion\") include ritual prayer, prostration, offerings, pilgrimage, and chanting.[316] Buddhist devotion is usually focused on some object, image or location that is seen as holy or spiritually influential. Examples of objects of devotion include paintings or statues of Buddhas and bodhisattvas, stupas, and bodhi trees.[317] Public group chanting for devotional and ceremonial is common to all Buddhist traditions and goes back to ancient India where chanting aided in the memorization of the orally transmitted teachings.[318] Rosaries called malas are used in all Buddhist traditions to count repeated chanting of common formulas or mantras. Chanting is thus a type of devotional group meditation which leads to tranquility and communicates the Buddhist teachings.[319]\n\n### Vegetarianism and animal ethics\n\nBased on the Indian principle of [ahimsa](Ahi%E1%B9%83s%C4%81 \"Ahiṃsā\") (non-harming), the Buddha's ethics strongly condemn the harming of all sentient beings, including all animals. He thus condemned the animal sacrifice of the Brahmins as well as hunting, and killing animals for food.[320] However, early Buddhist texts depict the Buddha as allowing monastics to eat meat. This seems to be because monastics begged for their food and thus were supposed to accept whatever food was offered to them.[321] This was tempered by the rule that meat had to be \"three times clean\": \"they had not seen, had not heard, and had no reason to suspect that the animal had been killed so that the meat could be given to them\".[322] Also, while the Buddha did not explicitly promote vegetarianism in his discourses, he did state that gaining one's livelihood from the meat trade was unethical.[323] In contrast to this, various Mahayana sutras and texts like the [Mahaparinirvana sutra](Mah%C4%81y%C4%81na_Mah%C4%81parinirv%C4%81%E1%B9%87a_S%C5%ABtra \"Mahāyāna Mahāparinirvāṇa Sūtra\"), [Surangama sutra](%C5%9A%C5%ABra%E1%B9%85gama_S%C5%ABtra \"Śūraṅgama Sūtra\") and the [Lankavatara sutra](La%E1%B9%85k%C4%81vat%C4%81ra_S%C5%ABtra \"Laṅkāvatāra Sūtra\") state that the Buddha promoted vegetarianism out of compassion.[324] Indian Mahayana thinkers like Shantideva promoted the avoidance of meat.[325] Throughout history, the issue of whether Buddhists should be vegetarian has remained a much debated topic and there is a variety of opinions on this issue among modern Buddhists.\n# Texts\n\nBuddhism, like all Indian religions, was initially an [oral tradition](Oral_tradition \"Oral tradition\") in ancient times.[326] The Buddha's words, the early doctrines, concepts, and their traditional interpretations were orally transmitted from one generation to the next. The earliest oral texts were transmitted in Middle [Indo-Aryan languages](Indo-Aryan_languages \"Indo-Aryan languages\") called [Prakrits](Prakrits \"Prakrits\"), such as [Pali](Pali \"Pali\"), through the use of communal recitation and other [mnemonic](Mnemonic \"Mnemonic\") techniques.[327] The first Buddhist canonical texts were likely written down in Sri Lanka, about 400 years after the Buddha died.[326] The texts were part of the _[Tripitakas](Tripi%E1%B9%ADaka \"Tripiṭaka\")_ , and many versions appeared thereafter claiming to be the words of the Buddha. Scholarly Buddhist commentary texts, with named authors, appeared in India, around the 2nd century CE.[326] These texts were written in Pali or Sanskrit, sometimes regional languages, as [palm-leaf manuscripts](Palm-leaf_manuscript \"Palm-leaf manuscript\"), birch bark, painted scrolls, carved into temple walls, and later on paper.[326]\n\nUnlike what the [Bible](Bible \"Bible\") is to [Christianity](Christianity \"Christianity\") and the [Quran](Quran \"Quran\") is to [Islam](Islam \"Islam\"), but like all major ancient Indian religions, there is no consensus among the different Buddhist traditions as to what constitutes the scriptures or a common canon in Buddhism.[326] The general belief among Buddhists is that the canonical corpus is vast.[328][329][330] This corpus includes the ancient _Sutras_ organised into _[Nikayas](Nik%C4%81ya \"Nikāya\")_ or _[Agamas](%C4%80gama_\\(Buddhism\\) \"Āgama \\(Buddhism\\)\")_ , itself the part of three basket of texts called the _Tripitakas_.[331] Each Buddhist tradition has its own collection of texts, much of which is translation of ancient Pali and Sanskrit Buddhist texts of India. The [Chinese Buddhist canon](Chinese_Buddhist_canon \"Chinese Buddhist canon\"), for example, includes 2184 texts in 55 volumes, while the [Tibetan canon](Tibetan_Buddhist_canon \"Tibetan Buddhist canon\") comprises 1108 texts – all claimed to have been spoken by the Buddha – and another 3461 texts composed by Indian scholars revered in the Tibetan tradition.[332] The Buddhist textual history is vast; over 40,000 manuscripts – mostly Buddhist, some non-Buddhist – were discovered in 1900 in the Dunhuang Chinese cave alone.[332]\n\n### Early texts\n\nThe Early Buddhist Texts refers to the literature which is considered by modern scholars to be the earliest Buddhist material. The first four [Pali](Pali \"Pali\") [Nikayas](Nikayas \"Nikayas\"), and the corresponding Chinese [Āgamas](%C4%80gama_\\(Buddhism\\) \"Āgama \\(Buddhism\\)\") are generally considered to be among the earliest material.[333][334][335] Apart from these, there are also fragmentary collections of EBT materials in other languages such as [Sanskrit](Sanskrit \"Sanskrit\"), [Khotanese](Saka_language \"Saka language\"), [Tibetan](Classical_Tibetan \"Classical Tibetan\") and [Gāndhārī](G%C4%81ndh%C4%81r%C4%AB_language \"Gāndhārī language\"). The modern study of [early Buddhism](Pre-sectarian_Buddhism \"Pre-sectarian Buddhism\") often relies on comparative scholarship using these various early Buddhist sources to identify parallel texts and common doctrinal content.[336] One feature of these early texts are literary structures which reflect oral transmission, such as widespread repetition.[337]\n\n### The Tripitakas\n\nAfter the development of the different [early Buddhist schools](Early_Buddhist_schools \"Early Buddhist schools\"), these schools began to develop their own textual collections, which were termed _Tripiṭakas_ (Triple Baskets).[338]\n\nMany early _Tripiṭakas_ , like the Pāli _Tipitaka_ , were divided into three sections: _[Vinaya Pitaka](Vinaya \"Vinaya\")_ (focuses on [monastic rule](Monasticism \"Monasticism\")), _[Sutta Pitaka](Sutta_Pitaka \"Sutta Pitaka\")_ (Buddhist discourses) and _[Abhidhamma Pitaka](Abhidhamma \"Abhidhamma\"),_ which contain expositions and commentaries on the doctrine. The [Pāli _Tipitaka_](P%C4%81li_Canon \"Pāli Canon\") (also known as the Pali Canon) of the Theravada School constitutes the only complete collection of Buddhist texts in an [Indic language](Indo-Aryan_languages \"Indo-Aryan languages\") which has survived until today.[339] However, many _Sutras_ , _Vinayas_ and _Abhidharma_ works from other schools survive in Chinese translation, as part of the Chinese Buddhist Canon. According to some sources, some early schools of Buddhism had five or seven _pitakas_.[340]\n\n### Mahāyāna texts\n\nThe [Mahāyāna sūtras](Mahayana_sutras \"Mahayana sutras\") are a very broad genre of Buddhist scriptures that the [Mahāyāna](Mahayana \"Mahayana\") Buddhist tradition holds are original teachings of [the Buddha](Gautama_Buddha \"Gautama Buddha\"). Modern historians generally hold that the first of these texts were composed probably around the 1st century BCE or 1st century CE.[341][342][343] In Mahāyāna, these texts are generally given greater authority than the early Āgamas and Abhidharma literature, which are called \"[Śrāvakayāna](%C5%9Ar%C4%81vakay%C4%81na \"Śrāvakayāna\")\" or \"[Hinayana](Hinayana \"Hinayana\")\" to distinguish them from Mahāyāna sūtras.[344] Mahāyāna traditions mainly see these different classes of texts as being designed for different types of persons, with different levels of spiritual understanding. The Mahāyāna sūtras are mainly seen as being for those of \"greater\" capacity.[345] Mahāyāna also has a very large literature of philosophical and exegetical texts. These are often called [_śāstra_](Shastras \"Shastras\") (treatises) or _vrittis_ (commentaries). Some of this literature was also written in verse form (_karikās_), the most famous of which is the _[Mūlamadhyamika-karikā](Mulamadhyamakakarika \"Mulamadhyamakakarika\")_ (Root Verses on the Middle Way) by [Nagarjuna](Nagarjuna \"Nagarjuna\"), the foundational text of the [Madhyamika](Madhyamika \"Madhyamika\") school. \n\n### Tantric texts\n\nDuring the [Gupta Empire](Gupta_Empire \"Gupta Empire\"), a new class of Buddhist sacred literature began to develop, which are called the [Tantras](Tantras_\\(Buddhism\\) \"Tantras \\(Buddhism\\)\").[346] By the 8th century, the tantric tradition was very influential in India and beyond. Besides drawing on a [Mahāyāna](Mah%C4%81y%C4%81na \"Mahāyāna\") Buddhist framework, these texts also borrowed deities and material from other Indian religious traditions, such as the [Śaiva](%C5%9Aaiva \"Śaiva\") and [Pancharatra](Pancharatra \"Pancharatra\") traditions, local god/goddess cults, and local spirit worship (such as [yaksha](Yaksha \"Yaksha\") or [nāga](N%C4%81ga \"Nāga\") spirits).[347][348]\n\nSome features of these texts include the widespread use of mantras, meditation on the [subtle body](Lung_\\(Tibetan_Buddhism\\)#Subtle_Body \"Lung \\(Tibetan Buddhism\\)\"), worship of [fierce deities](Fierce_deities \"Fierce deities\"), and [antinomian](Antinomian \"Antinomian\") and [transgressive](https://en.wiktionary.org/wiki/transgressive \"wikt:transgressive\") practices such as ingesting [alcohol](Alcohol_\\(drug\\) \"Alcohol \\(drug\\)\") and performing sexual rituals.[349][350][351]\n# History\n\n## Historical roots\n\nHistorically, the roots of Buddhism lie in the religious thought of [Iron Age India](Iron_Age_India \"Iron Age India\") around the middle of the first millennium BCE.[352] This was a period of great intellectual ferment and socio-cultural change known as the [\"Second urbanisation\"](History_of_India#Second_urbanisation_\\(c._600_–_200_BCE\\) \"History of India\"), marked by the growth of towns and trade, the composition of the [Upanishads](Upanishads \"Upanishads\") and the historical emergence of the [Śramaṇa](%C5%9Arama%E1%B9%87a \"Śramaṇa\") traditions.[353][354]\n\nNew ideas developed both in the [Vedic tradition](Historical_Vedic_religion \"Historical Vedic religion\") in the form of the Upanishads, and outside of the Vedic tradition through the Śramaṇa movements.[357][358][359] The term Śramaṇa refers to several Indian religious movements parallel to but separate from the [historical Vedic religion](Historical_Vedic_religion \"Historical Vedic religion\"), including Buddhism, [Jainism](Jainism \"Jainism\") and others such as [Ājīvika](%C4%80j%C4%ABvika \"Ājīvika\").[360]\n\nSeveral Śramaṇa movements are known to have existed in India before the 6th century BCE (pre-Buddha, pre-[Mahavira](Mahavira \"Mahavira\")), and these influenced both the [āstika and nāstika](%C4%80stika_and_n%C4%81stika \"Āstika and nāstika\") traditions of [Indian philosophy](Indian_philosophy \"Indian philosophy\").[361] According to Martin Wilshire, the Śramaṇa tradition evolved in India over two phases, namely [Paccekabuddha](Pratyekabuddha \"Pratyekabuddha\") and [Savaka](%C5%9Ar%C4%81vaka \"Śrāvaka\") phases, the former being the tradition of individual ascetic and the latter of disciples, and that Buddhism and [Jainism](Jainism \"Jainism\") ultimately emerged from these.[362] [Brahmanical](Historical_Vedic_religion \"Historical Vedic religion\") and non-Brahmanical ascetic groups shared and used several similar ideas,[363] but the Śramaṇa traditions also drew upon already established Brahmanical concepts and philosophical roots, states Wiltshire, to formulate their own doctrines.[361][364] Brahmanical motifs can be found in the oldest Buddhist texts, using them to introduce and explain Buddhist ideas.[365] For example, prior to Buddhist developments, the Brahmanical tradition internalised and variously reinterpreted the [three Vedic sacrificial fires](Srauta \"Srauta\") as concepts such as Truth, Rite, Tranquility or Restraint.[366] Buddhist texts also refer to the three Vedic sacrificial fires, reinterpreting and explaining them as ethical conduct.[367]\n\nThe Śramaṇa religions challenged and broke with the Brahmanic tradition on core assumptions such as [Atman](Atman_\\(Hinduism\\) \"Atman \\(Hinduism\\)\") (soul, self), [Brahman](Brahman \"Brahman\"), the nature of afterlife, and they rejected the authority of the [Vedas](Vedas \"Vedas\") and [Upanishads](Upanishad \"Upanishad\").[368][369][370] Buddhism was one among several Indian religions that did so.[370]\n\nEarly Buddhism, as preserved in Theravada, accepts deities (devas) as existent but impermanent beings within samsara, without positing a creator god; it is non-theistic rather than atheistic in denying all supernatural entities. Later traditions maintained this non-theistic view while incorporating devotional elements.[371]\n\n## Indian Buddhism\n\nThe history of Indian Buddhism may be divided into five periods:[372] Early Buddhism (occasionally called [pre-sectarian Buddhism](Pre-sectarian_Buddhism \"Pre-sectarian Buddhism\")), [Nikaya Buddhism](Nikaya_Buddhism \"Nikaya Buddhism\") or Sectarian Buddhism (the period of the early Buddhist schools), Early [Mahayana Buddhism](Mahayana \"Mahayana\"), Late Mahayana, and the era of [Vajrayana](Vajrayana \"Vajrayana\") or the \"Tantric Age\". \n\n### Pre-sectarian Buddhism\n\nAccording to [Lambert Schmithausen](Lambert_Schmithausen \"Lambert Schmithausen\") Pre-sectarian Buddhism is \"the canonical period prior to the development of different schools with their different positions\".[373]\n\nThe [early Buddhist Texts](Early_Buddhist_Texts \"Early Buddhist Texts\") include the four principal Pali [Nikāyas](Nik%C4%81ya \"Nikāya\") (and their parallel [Agamas](%C4%80gama_\\(Buddhism\\) \"Āgama \\(Buddhism\\)\") found in the Chinese canon) together with the main body of monastic rules, which survive in the various versions of the [patimokkha](Patimokkha \"Patimokkha\").[374][375][376] However, these texts were revised over time, and it is unclear what constitutes the earliest layer of Buddhist teachings. One method to obtain information on the oldest core of Buddhism is to compare the oldest extant versions of the Theravadin Pāli Canon and other texts. The reliability of the early sources, and the possibility to draw out a core of oldest teachings, is a matter of dispute.[379] According to Vetter, inconsistencies remain, and other methods must be applied to resolve those inconsistencies.[377]\n\nAccording to Schmithausen, three positions held by scholars of Buddhism can be distinguished:[383]\n\n1. \"Stress on the fundamental homogeneity and substantial authenticity of at least a considerable part of the Nikayic materials\". Proponents of this position include [A. K. Warder](A._K._Warder \"A. K. Warder\") and [Richard Gombrich](Richard_Gombrich \"Richard Gombrich\").[385]\n2. \"Scepticism with regard to the possibility of retrieving the doctrine of earliest Buddhism\". Ronald Davidson is a proponent of this position.\n3. \"Cautious optimism in this respect\". Proponents of this position include J.W. de Jong,[387] Johannes Bronkhorst and Donald Lopez.\n\n#### The Core teachings\n\nAccording to Mitchell, certain basic teachings appear in many places throughout the early texts, which has led most scholars to conclude that Gautama Buddha must have taught something similar to the [Four Noble Truths](Four_Noble_Truths \"Four Noble Truths\"), the [Noble Eightfold Path](Noble_Eightfold_Path \"Noble Eightfold Path\"), [Nirvana](Nirvana_\\(Buddhism\\) \"Nirvana \\(Buddhism\\)\"), the [three marks of existence](Three_marks_of_existence \"Three marks of existence\"), the [five aggregates](Skandha \"Skandha\"), [dependent origination](Prat%C4%ABtyasamutp%C4%81da \"Pratītyasamutpāda\"), [karma](Karma_in_Buddhism \"Karma in Buddhism\") and [rebirth](Rebirth_\\(Buddhism\\) \"Rebirth \\(Buddhism\\)\").[389] Recent discoveries of Gandharan Buddhist manuscripts (c. 1st century BCE–3rd CE) provide the earliest physical evidence of these teachings, aligning closely with Theravada traditions and supporting their antiquity.[](https://www.lionsroar.com/how-the-gandharan-manuscripts-change-buddhist-history/)\n\nAccording to N. Ross Reat, all of these doctrines are shared by the Theravada Pali texts and the Mahasamghika school's _[Śālistamba Sūtra](Salistamba_Sutra \"Salistamba Sutra\")_.[390] A recent study by Bhikkhu Analayo concludes that the Theravada _[Majjhima Nikaya](Majjhima_Nik%C4%81ya \"Majjhima Nikāya\")_ and Sarvastivada _[Madhyama Agama](Madhyama_Agama \"Madhyama Agama\")_ contain mostly the same major doctrines.[391] [Richard Salomon](Richard_G._Salomon_\\(professor_of_Asian_studies\\) \"Richard G. Salomon \\(professor of Asian studies\\)\"), in his study of the Gandharan texts (which are the earliest manuscripts containing early discourses), has confirmed that their teachings are \"consistent with non-Mahayana Buddhism, which survives today in the Theravada school of Sri Lanka and Southeast Asia, but which in ancient times was represented by eighteen separate schools.\"[392]\n\nHowever, some scholars argue that critical analysis reveals discrepancies among the various doctrines found in these early texts, which point to alternative possibilities for early Buddhism.[393][394][395] The authenticity of certain teachings and doctrines have been questioned. For example, some scholars think that karma was not central to the teaching of the historical Buddha, while other disagree with this position.[396][397] Likewise, there is scholarly disagreement on whether insight was seen as liberating in early Buddhism or whether it was a later addition to the practice of the four _jhānas_.[380][398][399] Scholars such as Bronkhorst also think that the four noble truths may not have been formulated in earliest Buddhism, and did not serve in earliest Buddhism as a description of \"liberating insight\".[400] According to Vetter, the description of the Buddhist path may initially have been as simple as the term \"the middle way\".[135] In time, this short description was elaborated, resulting in the description of the eightfold path.[135]\n\n### Ashokan Era and the early schools\n\nAccording to numerous Buddhist scriptures, soon after the [_parinirvāṇa_](Parinirvana \"Parinirvana\") (from Sanskrit: \"highest extinguishment\") of Gautama Buddha, the [first Buddhist council](First_Buddhist_council \"First Buddhist council\") was held to collectively recite the teachings to ensure that no errors occurred in oral transmission. Many modern scholars question the historicity of this event.[401] However, [Richard Gombrich](Richard_Gombrich \"Richard Gombrich\") states that the monastic assembly recitations of the Buddha's teaching likely began during Buddha's lifetime, and they served a similar role of codifying the teachings.[402]\n\nThe so called [Second Buddhist council](Second_Buddhist_council \"Second Buddhist council\") resulted in the first schism in the [Sangha](Sangha_\\(Buddhism\\) \"Sangha \\(Buddhism\\)\"). Modern scholars believe that this was probably caused by disputes over ten lax monastic practices proposed by the more liberal Mahāsāṃghikas, which the conservative Sthaviras opposed, leading to the first schism.[](https://en.wikipedia.org/wiki/Buddhist_councils)[](https://www.learnreligions.com/the-buddhist-councils-450076) While most scholars accept that this happened at some point, there is no agreement on the dating, especially if it dates to before or after the reign of Ashoka.[405]\n\nBuddhism may have spread only slowly throughout India until the time of the [Mauryan](Maurya_Empire \"Maurya Empire\") emperor [Ashoka](Ashoka \"Ashoka\") (304–232 BCE), who was a public supporter of the religion. The support of Aśoka and his descendants led to the construction of more [stūpas](Stupa \"Stupa\") (such as at [Sanchi](Sanchi \"Sanchi\") and [Bharhut](Bharhut \"Bharhut\")), temples (such as the [Mahabodhi Temple](Mahabodhi_Temple \"Mahabodhi Temple\")) and to its spread throughout the Maurya Empire and into neighbouring lands such as [Central Asia](Central_Asia \"Central Asia\") and to the island of [Sri Lanka](Sri_Lanka \"Sri Lanka\"). \n\nDuring and after the Mauryan period (322–180 BCE), the Sthavira community gave rise to several schools, one of which was the [Theravada](Theravada \"Theravada\") school which tended to congregate in the south and another which was the [Sarvāstivāda](Sarv%C4%81stiv%C4%81da \"Sarvāstivāda\") school, which was mainly in north India. Likewise, the [Mahāsāṃghika](Mah%C4%81s%C4%81%E1%B9%83ghika \"Mahāsāṃghika\") groups also eventually split into different Sanghas. Originally, these schisms were caused by disputes over monastic disciplinary codes of various fraternities, but eventually, by about 100 CE if not earlier, schisms were being caused by doctrinal disagreements too.[406]\n\nFollowing (or leading up to) the schisms, each Saṅgha started to accumulate their own version of [Tripiṭaka](Tripi%E1%B9%ADaka \"Tripiṭaka\") (triple basket of texts).[62][407] In their Tripiṭaka, each school included the Suttas of the Buddha, a Vinaya basket (disciplinary code) and some schools also added an [Abhidharma](Abhidharma \"Abhidharma\") basket which were texts on detailed scholastic classification, summary and interpretation of the Suttas.[62][408] The doctrine details in the Abhidharmas of various Buddhist schools differ significantly, and these were composed starting about the third century BCE and through the 1st millennium CE.[409][410][411]\n\n## Post-Ashokan expansion\n\nAccording to the [edicts of Aśoka](Edicts_of_Ashoka \"Edicts of Ashoka\"), the Mauryan emperor sent emissaries to various countries west of India to spread \"Dharma\", particularly in eastern provinces of the neighbouring [Seleucid Empire](Seleucid_Empire \"Seleucid Empire\"), and even farther to [Hellenistic](Hellenistic_civilization \"Hellenistic civilization\") kingdoms of the Mediterranean. It is a matter of disagreement among scholars whether or not these emissaries were accompanied by Buddhist missionaries.[412]\n\nIn central and west Asia, Buddhist influence grew, through Greek-speaking Buddhist monarchs and ancient Asian trade routes, a phenomenon known as [Greco-Buddhism](Greco-Buddhism \"Greco-Buddhism\"). An example of this is evidenced in Chinese and Pali Buddhist records, such as _[Milindapanha](Milinda_Panha \"Milinda Panha\")_ and the [Greco-Buddhist art](Greco-Buddhist_art \"Greco-Buddhist art\") of [Gandhāra](Gandhara \"Gandhara\"). The _Milindapanha_ describes a conversation between a Buddhist monk and the 2nd-century BCE Greek king [Menander](Menander_I \"Menander I\"), after which Menander abdicates and himself goes into monastic life in the pursuit of nirvana.[413][414] Some scholars have questioned the _Milindapanha_ version, expressing doubts whether Menander was Buddhist or just favourably disposed to Buddhist monks.[415]\n\nThe [Kushan Empire](Kushan_Empire \"Kushan Empire\") (30–375 CE) came to control the Silk Road trade through Central and South Asia, which brought them to interact with [Gandharan Buddhism](Gandharan_Buddhism \"Gandharan Buddhism\") and the Buddhist institutions of these regions. The Kushans patronised Buddhism throughout their lands, and many Buddhist centres were built or renovated (the Sarvastivada school was particularly favored), especially by Emperor Kanishka (128–151 CE).[416][417] Kushan support helped Buddhism to expand into a world religion through their trade routes.[418] Buddhism spread to [Khotan](Kingdom_of_Khotan \"Kingdom of Khotan\"), the [Tarim Basin](Tarim_Basin \"Tarim Basin\"), and China, eventually to other parts of the far east.[417] Some of the earliest written documents of the Buddhist faith are the [Gandharan Buddhist texts](Gandharan_Buddhist_texts \"Gandharan Buddhist texts\"), dating from about the 1st century CE, and connected to the [Dharmaguptaka](Dharmaguptaka \"Dharmaguptaka\") school.[419][420][421]\n\nThe [Islamic conquest](Muslim_conquest_of_Persia \"Muslim conquest of Persia\") of the [Iranian Plateau](Iranian_Plateau \"Iranian Plateau\") in the 7th-century, followed by the [Muslim conquests of Afghanistan](Muslim_conquests_of_Afghanistan \"Muslim conquests of Afghanistan\") and the later establishment of the [Ghaznavid kingdom](Ghaznavids \"Ghaznavids\") with Islam as the state religion in Central Asia between the 10th- and 12th-century led to the decline and disappearance of Buddhism from most of these regions.[422]\n\n## Mahāyāna Buddhism\n\nThe origins of Mahāyāna (\"Great Vehicle\") Buddhism are not well understood and there are various competing theories about how and where this movement arose. Theories include the idea that it began as various groups venerating certain texts or that it arose as a strict forest ascetic movement.[423]\n\nThe first Mahāyāna works were written sometime between the 1st century BCE and the 2nd century CE.[342][423] Much of the early extant evidence for the origins of Mahāyāna comes from early Chinese translations of Mahāyāna texts, mainly those of [Lokakṣema](Lokaksema_\\(Buddhist_monk\\) \"Lokaksema \\(Buddhist monk\\)\"). (2nd century CE). Some scholars have traditionally considered the earliest [Mahāyāna sūtras](Mahayana_sutras \"Mahayana sutras\") to include the first versions of the [Prajnaparamita](Prajnaparamita \"Prajnaparamita\") series, along with texts concerning [Akṣobhya](Akshobhya \"Akshobhya\"), which were probably composed in the 1st century BCE in the south of India.[425]\n\nThere is no evidence that Mahāyāna ever referred to a separate formal school or sect of Buddhism, with a separate monastic code (Vinaya), but rather that it existed as a certain set of ideals, and later doctrines, for bodhisattvas.[427][428] Records written by Chinese monks visiting India indicate that both Mahāyāna and non-Mahāyāna monks could be found in the same monasteries, with the difference that Mahāyāna monks worshipped figures of Bodhisattvas, while non-Mahayana monks did not.[429]\n\nMahāyāna initially seems to have remained a small minority movement that was in tension with other Buddhist groups, struggling for wider acceptance.[430] However, during the fifth and sixth centuries CE, there seems to have been a rapid growth of Mahāyāna Buddhism, which is shown by a large increase in epigraphic and manuscript evidence in this period. However, it still remained a minority in comparison to other Buddhist schools.[431]\n\nMahāyāna Buddhist institutions continued to grow in influence during the following centuries, with large monastic university complexes such as [Nalanda](Nalanda \"Nalanda\") (established by the 5th-century CE Gupta emperor, [Kumaragupta I](Kumaragupta_I \"Kumaragupta I\")) and [Vikramashila](Vikramashila \"Vikramashila\") (established under [Dharmapala](Dharmapala_\\(emperor\\) \"Dharmapala \\(emperor\\)\") c. 783 to 820) becoming quite powerful and influential. During this period of Late Mahāyāna, four major types of thought developed: Mādhyamaka, Yogācāra, Buddha-nature (_Tathāgatagarbha_), and the [epistemological tradition of Dignaga and Dharmakirti](Buddhist_logico-epistemology#The_Dignāga-Dharmakīrti_tradition \"Buddhist logico-epistemology\").[432] According to [Dan Lusthaus](Dan_Lusthaus \"Dan Lusthaus\"), Mādhyamaka and Yogācāra have a great deal in common, and the commonality stems from early Buddhism.[433]\n\n## Late Indian Buddhism and Tantra\n\nDuring the [Gupta period](Gupta_Empire \"Gupta Empire\") (4th–6th centuries) and the empire of [Harṣavardhana](Harsha \"Harsha\") (c. 590–647 CE), Buddhism continued to be influential in India, and large Buddhist learning institutions such as [Nalanda](Nalanda \"Nalanda\") and [Valabahi](Valabhi_University \"Valabhi University\") Universities were at their peak.[434] Buddhism also flourished under the support of the [Pāla Empire](Pala_Empire \"Pala Empire\") (8th–12th centuries). Under the Guptas and Palas, Tantric Buddhism or Vajrayana developed and rose to prominence. It promoted new practices such as the use of [mantras](Mantra \"Mantra\"), [dharanis](Dharani \"Dharani\"), [mudras](Mudra \"Mudra\"), [mandalas](Mandala \"Mandala\") and the visualization of deities and Buddhas and developed a new class of literature, the [Buddhist Tantras](Tantras_\\(Buddhism\\) \"Tantras \\(Buddhism\\)\"). This new esoteric form of Buddhism can be traced back to groups of wandering yogi magicians called [mahasiddhas](Mahasiddha \"Mahasiddha\").[435][436]\n\nThe question of the origins of early Vajrayana has been taken up by various scholars. [David Seyfort Ruegg](David_Seyfort_Ruegg \"David Seyfort Ruegg\") has suggested that Buddhist tantra employed various elements of a \"pan-Indian religious substrate\" which is not specifically Buddhist, Shaiva or Vaishnava.[437]\n\nAccording to Indologist [Alexis Sanderson](Alexis_Sanderson \"Alexis Sanderson\"), various classes of Vajrayana literature developed as a result of royal courts sponsoring both Buddhism and [Saivism](Shaivism \"Shaivism\"). Sanderson has argued that Buddhist tantras can be shown to have borrowed practices, terms, rituals and more form Shaiva tantras. He argues that Buddhist texts even directly copied various Shaiva tantras, especially the Bhairava Vidyapitha tantras.[438][439] Ronald M. Davidson meanwhile, argues that Sanderson's claims for direct influence from Shaiva _Vidyapitha_ texts are problematic because \"the chronology of the _Vidyapitha_ tantras is by no means so well established\"[440] and that the Shaiva tradition also appropriated non-Hindu deities, texts and traditions. Thus while \"there can be no question that the Buddhist tantras were heavily influenced by [Kapalika](Kapalika \"Kapalika\") and other Saiva movements\" argues Davidson, \"the influence was apparently mutual\".[441]\n\nAlready during this later era, Buddhism was losing state support in other regions of India, including the lands of the [Karkotas](Karkota_Empire \"Karkota Empire\"), the [Pratiharas](Gurjara-Pratihara_dynasty \"Gurjara-Pratihara dynasty\"), the [Rashtrakutas](Rashtrakuta_dynasty \"Rashtrakuta dynasty\"), the [Pandyas](Pandya_dynasty \"Pandya dynasty\") and the [Pallavas](Pallava_dynasty \"Pallava dynasty\"). This loss of support in favor of Hindu faiths like [Vaishnavism](Vaishnavism \"Vaishnavism\") and [Shaivism](Shaivism \"Shaivism\"), is the beginning of the long and complex period of the [Decline of Buddhism in the Indian subcontinent](Decline_of_Buddhism_in_the_Indian_subcontinent \"Decline of Buddhism in the Indian subcontinent\").[442] The [Islamic invasions and conquest of India](Muslim_conquests_in_the_Indian_subcontinent \"Muslim conquests in the Indian subcontinent\") (10th to 12th century), further damaged and destroyed many Buddhist institutions, leading to its eventual near disappearance from India by the 1200s.[443]\n\n## Spread to East and Southeast Asia\n\nThe [Silk Road transmission of Buddhism](Silk_Road_transmission_of_Buddhism \"Silk Road transmission of Buddhism\") to China is most commonly thought to have started in the late 2nd or the 1st century CE, though the literary sources are all open to question.[444] The first documented translation efforts by foreign [Buddhist monks](Buddhist_monk \"Buddhist monk\") in China were in the 2nd century CE, probably as a consequence of the expansion of the [Kushan Empire](Kushan_Empire \"Kushan Empire\") into the Chinese territory of the [Tarim Basin](Tarim_Basin \"Tarim Basin\").[446]\n\nThe first documented Buddhist texts translated into Chinese are those of the Parthian [An Shigao](An_Shigao \"An Shigao\") (148–180 CE).[447] The first known [Mahāyāna](Mahayana \"Mahayana\") scriptural texts are translations into Chinese by the Kushan monk [Lokakṣema](Lokaksema_\\(Buddhist_monk\\) \"Lokaksema \\(Buddhist monk\\)\") in [Luoyang](Luoyang \"Luoyang\"), between 178 and 189 CE.[448] From China, Buddhism was introduced into its neighbours [Korea](Korea \"Korea\") (4th century), [Japan](Japan \"Japan\") (6th–7th centuries), and [Vietnam](Vietnam \"Vietnam\") (c. 1st–2nd centuries).[449][450]\n\nDuring the Chinese [Tang dynasty](Tang_dynasty \"Tang dynasty\") (618–907), [Chinese Esoteric Buddhism](Chinese_Esoteric_Buddhism \"Chinese Esoteric Buddhism\") was introduced from India and [Chan Buddhism](Chan_Buddhism \"Chan Buddhism\") (Zen) became a major religion.[451][452] Chan continued to grow in the [Song dynasty](Song_dynasty \"Song dynasty\") (960–1279) and it was during this era that it strongly influenced Korean Buddhism and Japanese Buddhism.[453] [Pure Land Buddhism](Pure_Land_Buddhism \"Pure Land Buddhism\") also became popular during this period and was often practised together with Chan.[454] It was also during the Song that the entire [Chinese canon](Chinese_Buddhist_canon \"Chinese Buddhist canon\") was printed using over 130,000 wooden printing blocks.[455]\n\nDuring the Indian period of Esoteric Buddhism (from the 8th century onwards), Buddhism spread from India to Tibet and [Mongolia](Mongolia \"Mongolia\"). Johannes Bronkhorst states that the esoteric form was attractive because it allowed both a secluded monastic community as well as the social rites and rituals important to laypersons and to kings for the maintenance of a political state during succession and wars to resist invasion.[456] During the Middle Ages, Buddhism slowly declined in India,[457] while it vanished from Persia and Central Asia as Islam became the state religion.[458][459]\n\nThe [Theravada](Theravada \"Theravada\") school arrived in Sri Lanka sometime in the 3rd century BCE. Sri Lanka became a base for its later spread to [Southeast Asia](Southeast_Asia \"Southeast Asia\") after the 5th century CE ([Myanmar](Myanmar \"Myanmar\"), [Malaysia](Malaysia \"Malaysia\"), [Indonesia](Indonesia \"Indonesia\"), [Thailand](Thailand \"Thailand\"), [Cambodia](Cambodia \"Cambodia\") and coastal [Vietnam](Vietnam \"Vietnam\")).[460][461] [Theravada Buddhism](Theravada \"Theravada\") was the dominant religion in [Burma](Myanmar \"Myanmar\") during the Mon [Hanthawaddy Kingdom](Hanthawaddy_Kingdom \"Hanthawaddy Kingdom\") (1287–1552).[462] It also became dominant in the [Khmer Empire](Khmer_Empire \"Khmer Empire\") during the 13th and 14th centuries and in the Thai [Sukhothai Kingdom](Sukhothai_Kingdom \"Sukhothai Kingdom\") during the reign of [Ram Khamhaeng](Ram_Khamhaeng \"Ram Khamhaeng\") (1237/1247–1298).[463][464]\n## Schools and traditions\n\nBuddhists generally classify themselves as either [Theravāda](Theravada \"Theravada\") or [Mahāyāna](Mahayana \"Mahayana\").[465] This classification is also used by some scholars[466] and is the one ordinarily used in the English language.[467] An alternative scheme used by some scholars divides Buddhism into the following three traditions or geographical or cultural areas: Theravāda (or \"Southern Buddhism\", \"South Asian Buddhism\"), [East Asian Buddhism](East_Asian_Buddhism \"East Asian Buddhism\") (or just \"Eastern Buddhism\") and [Indo-Tibetan Buddhism](Tibetan_Buddhism \"Tibetan Buddhism\") (or \"Northern Buddhism\").[note 31]\n\nThe Theravada tradition traces its origins as the oldest tradition holding the Pali Canon as the only authority. The Mahayana tradition reveres the Canon but also derivative literature that developed in the 1st millennium CE; its roots are traceable to the 1st century BCE. The Vajrayana tradition is closer to the Mahayana, includes Tantra, and as the younger of the three is traceable to the 1st millennium CE.[468][469] Vajrayāna, often practiced in Tibetan and some East Asian contexts, emphasizes esoteric practices, tantric rituals, and rapid paths to enlightenment through deity yoga and mandalas, viewing itself as an advanced extension of Mahāyāna methods.[](https://plato.stanford.edu/entries/buddhism-tibetan/#VajrTrad)\n\nSome scholars use other schemes, such as the multi-dimensional classification in the _Encyclopedia of Religion_.[470] Buddhists themselves have a variety of other schemes. [Hinayana](Hinayana \"Hinayana\") (literally \"lesser or inferior vehicle\") is sometimes used by Mahāyāna followers to name the family of early philosophical schools and traditions from which contemporary Theravāda emerged, but as the Hinayana term is considered derogatory, a variety of other terms are used instead, including: [Śrāvakayāna](Shravakayana \"Shravakayana\"), Nikaya Buddhism, early Buddhist schools, sectarian Buddhism and conservative Buddhism.[471][472] Additionally, modern traditions like Navayāna, founded by B.R. Ambedkar in 1956, adapt Buddhism for social justice and anti-caste activism in India, influencing Dalit communities as of 2025.[](https://www.pewresearch.org/religion/2025/06/09/how-the-global-religious-landscape-changed-from-2010-to-2020/)\n\nNot all traditions of Buddhism share the same philosophical outlook or treat the same concepts as central. Each tradition, however, does have its own core concepts, and some comparisons can be drawn between them:[473][474]\n\n| Aspect | [Theravāda](Therav%C4%81da \"Theravāda\") | [Mahāyāna](Mah%C4%81y%C4%81na \"Mahāyāna\") |\n|--------|---------------------------------------|------------------------------------------|\n| Both Theravāda and Mahāyāna accept and revere [the Shakyamuni Buddha](Gautama_Buddha \"Gautama Buddha\") as the founder. | Mahāyāna also reveres numerous other Buddhas, such as [Amitabha](Amit%C4%81bha \"Amitābha\") or [Vairocana](Vairochana \"Vairocana\") as well as many other bodhisattvas not revered in Theravāda. | |\n| Both accept the [Middle Way](Middle_Way \"Middle Way\"), [Dependent origination](Prat%C4%ABtyasamutp%C4%81da \"Pratītyasamutpāda\"), the [Four Noble Truths](Four_Noble_Truths \"Four Noble Truths\"), the [Noble Eightfold Path](Noble_Eightfold_Path \"Noble Eightfold Path\"), the [Three Jewels](Refuge_\\(Buddhism\\) \"Refuge \\(Buddhism\\)\"), the [Three marks of existence](Three_marks_of_existence \"Three marks of existence\") and the _[Bodhipakṣadharmas](Bodhipakkhiy%C4%81dhamm%C4%81 \"Bodhipakkhiyādhammā\")_ (aids to awakening). | | |\n| | Theravāda only focuses on the realization of the Four Noble Truths (eliminating ignorance).[475] | Mahāyāna focuses mainly on the [bodhisattva path](Bodhisattva \"Bodhisattva\") to Buddhahood which it sees as universal and to be practiced by all persons, while Theravāda does not focus on teaching this path and teaches the realization of the Four Noble Truths (eliminating ignorance) as a worthy goal to strive towards. The bodhisattva path is not denied in Theravāda, it is generally seen as a long and difficult path suitable for only a few.[476] Thus the Bodhisattva path is normative in Mahāyāna, while it is an optional path for a heroic few in Theravāda.[477] |\n| | Since the realization of the Four Noble Truths (eliminating ignorance) requires intelligence and [wisdom](Praj%C3%B1%C4%81_\\(Buddhism\\) \"Prajñā \\(Buddhism\\)\"), Theravāda focuses on them.[478] | Mahāyāna sees the realization of the Four Noble Truths (arhatship, eliminating ignorance) as being imperfect and inferior or preliminary to full Buddhahood. It sees it as selfish, since [bodhisattvas](Bodhisattvas \"Bodhisattvas\") vow to save all beings while Theravāda can only save the [wise](Praj%C3%B1%C4%81_\\(Buddhism\\) \"Prajñā \\(Buddhism\\)\").[479] Theravāda meanwhile does not accept that the realization of the Four Noble Truths (arhat's nirvana) is an inferior or preliminary attainment, nor that it is a selfish deed to attain arhatship (eliminate ignorance) since not only are [arhats](Arhats \"Arhats\") (those who've eliminated ignorance) described as compassionate but they have destroyed the root of greed, the sense of \"I am\".[477] |\n| Both accepts the authority of the [Pali canon](Pali_canon \"Pali canon\"). | Theravāda only accepts the authority of the [Pali canon](Pali_canon \"Pali canon\") which is the original and complete _[buddhavacana](Buddhavacana \"Buddhavacana\")_ (word of the Buddha) unchanged. | Mahāyāna accepts the authority of the many Mahāyāna sutras along with the other Nikaya texts like the Agamas and the Pali canon (though it sees Mahāyāna texts as primary), while Theravāda does not accept that the Mahāyāna sutras are _[buddhavacana](Buddhavacana \"Buddhavacana\")_ (word of the Buddha) at all.[480] |\n## Monasteries and temples\n\nVarious types of Buddhist buildings\n\nBuddhist institutions are often housed and centred around [monasteries](Monasteries \"Monasteries\") (Sanskrit: _[viharas](Vih%C4%81ra \"Vihāra\")_) and temples. Buddhist monastics originally followed a life of wandering, never staying in one place for long. During the three-month rainy season (_[vassa](Vassa \"Vassa\")_) they would gather together in one place for a period of intense practice and then depart again.[481][482] Some of the earliest Buddhist monasteries were at groves (_vanas_) or woods (_araññas_), such as [Jetavana](Jetavana \"Jetavana\") and [Sarnath's Deer Park](Sarnath \"Sarnath\"). There originally seems to have been two main types of monasteries, monastic settlements (_sangharamas_) were built and supported by donors, and woodland camps (_avasas_) were set up by monks. Whatever structures were built in these locales were made out of wood and were sometimes temporary structures built for the rainy season.[483][484] Over time, the wandering community slowly adopted more settled [cenobitic](Cenobitic_monasticism \"Cenobitic monasticism\") forms of monasticism.\n\nThere are many different forms of Buddhist structures. Classic Indian Buddhist institutions mainly made use of the following structures: monasteries, rock-hewn cave complexes (such as the [Ajanta Caves](Ajanta_Caves \"Ajanta Caves\")), [stupas](Stupa \"Stupa\") (funerary mounds which contained relics), and temples such as the [Mahabodhi Temple](Mahabodhi_Temple \"Mahabodhi Temple\").[486] In Southeast Asia, the most widespread institutions are centred on [wats](Wat \"Wat\"). East Asian Buddhist institutions also use various structures including monastic halls, temples, lecture halls, bell towers and [pagodas](Pagoda \"Pagoda\"). In [Japanese Buddhist temples](Buddhist_temples_in_Japan \"Buddhist temples in Japan\"), these different structures are usually grouped together in an area termed the [garan](Shichid%C5%8D_garan \"Shichidō garan\"). In Indo-Tibetan Buddhism, Buddhist institutions are generally housed in [gompas](Gompa \"Gompa\"). They include monastic quarters, stupas and prayer halls with Buddha images. In the modern era, the Buddhist \"meditation centre\", which is mostly used by laypersons and often also staffed by them, has also become widespread.[487]\n## In the modern era\n\n### Colonial era and after\n\nBuddhism has faced various challenges and changes during the colonisation of Buddhist states by Christian countries and its persecution under modern states. Like other religions, the findings of modern science have challenged its basic premises. One response to some of these challenges has come to be called [Buddhist modernism](Buddhist_modernism \"Buddhist modernism\"). Early Buddhist modernist figures such as the American convert [Henry Olcott](Henry_Steel_Olcott \"Henry Steel Olcott\") (1832–1907) and [Anagarika Dharmapala](Anagarika_Dharmapala \"Anagarika Dharmapala\") (1864–1933) reinterpreted and promoted Buddhism as a scientific and rational religion which they saw as compatible with modern science.[488]\n\n[East Asian Buddhism](East_Asian_Buddhism \"East Asian Buddhism\") meanwhile suffered under various wars which ravaged China during the modern era, such as the [Taiping rebellion](Taiping_Rebellion \"Taiping Rebellion\") and [World War II](World_War_II \"World War II\") (which also affected [Korean Buddhism](Korean_Buddhism \"Korean Buddhism\")). During the [Republican period](Republic_of_China_\\(1912%E2%80%931949\\) \"Republic of China \\(1912–1949\\)\") (1912–49), a new movement called [Humanistic Buddhism](Humanistic_Buddhism \"Humanistic Buddhism\") was developed by figures such as [Taixu](Taixu \"Taixu\") (1899–1947), and though Buddhist institutions were destroyed during the [Cultural Revolution](Cultural_Revolution \"Cultural Revolution\") (1966–76), there has been a revival of the religion in China after 1977.[489] [Japanese Buddhism](Buddhism_in_Japan \"Buddhism in Japan\") also went through a period of modernisation during the [Meiji period](Meiji_period \"Meiji period\").[490] In [Central Asia](Central_Asia \"Central Asia\") meanwhile, the arrival of [Communist](Communism \"Communism\") repression to [Tibet](Tibet \"Tibet\") (1966–1980) and [Mongolia](Mongolia \"Mongolia\") (between 1924 and 1990) had a strong negative impact on Buddhist institutions, though the situation has improved somewhat since the 80s and 90s.[491]\n\nIn Afghanistan and Pakistan, militants have destroyed some historic Buddhist monuments.[492][493]\n\n### In the West\n\nWhile there were some encounters of Western travellers or missionaries such as St. [Francis Xavier](Francis_Xavier \"Francis Xavier\") and [Ippolito Desideri](Ippolito_Desideri \"Ippolito Desideri\") with Buddhist cultures, it was not until the 19th century that Buddhism began to be studied by Western scholars. It was the work of pioneering scholars such as [Eugène Burnouf](Eug%C3%A8ne_Burnouf \"Eugène Burnouf\"), [Max Müller](Max_M%C3%BCller \"Max Müller\"), [Hermann Oldenberg](Hermann_Oldenberg \"Hermann Oldenberg\") and [Thomas William Rhys Davids](Thomas_William_Rhys_Davids \"Thomas William Rhys Davids\") that paved the way for modern [Buddhist studies](Buddhist_studies \"Buddhist studies\") in the West. The English words such as Buddhism, \"Boudhist\", \"Bauddhist\" and Buddhist were coined in the early 19th-century in the West,[494] while in 1881, Rhys Davids founded the [Pali Text Society](Pali_Text_Society \"Pali Text Society\")—an influential Western resource of Buddhist literature in the Pali language and one of the earliest publisher of a journal on [Buddhist studies](Buddhist_studies \"Buddhist studies\").[495] It was also during the 19th century that Asian Buddhist immigrants (mainly from China and Japan) began to arrive in Western countries such as the United States and Canada, bringing with them their Buddhist religion. This period also saw the first Westerners to formally convert to Buddhism, such as [Helena Blavatsky](Helena_Blavatsky \"Helena Blavatsky\") and [Henry Steel Olcott](Henry_Steel_Olcott \"Henry Steel Olcott\").[496] An important event in the introduction of Buddhism to the West was the 1893 [World Parliament of Religions](World_Parliament_of_Religions \"World Parliament of Religions\"), which for the first time saw well-publicized speeches by major Buddhist leaders alongside other religious leaders. \n\nThe 20th century saw a prolific growth of new Buddhist institutions in Western countries, including the [Buddhist Society, London](Buddhist_Society%2C_London \"Buddhist Society, London\") (1924), [Das Buddhistische Haus](Das_Buddhistische_Haus \"Das Buddhistische Haus\") (1924) and [Datsan Gunzechoinei](Datsan_Gunzechoinei \"Datsan Gunzechoinei\") in [St Petersburg](Saint_Petersburg \"Saint Petersburg\"). The publication and translations of Buddhist literature in Western languages thereafter accelerated. After the [second world war](World_War_II \"World War II\"), further immigration from Asia, globalisation, the [secularisation](Secularisation \"Secularisation\") on Western culture as well a renewed interest in Buddhism among the 60s [counterculture](Counterculture \"Counterculture\") led to further growth in Buddhist institutions.[497] Influential figures on post-war [Western Buddhism](Buddhism_in_the_West \"Buddhism in the West\") include [Shunryu Suzuki](Shunryu_Suzuki \"Shunryu Suzuki\"), [Jack Kerouac](Jack_Kerouac \"Jack Kerouac\"), [Alan Watts](Alan_Watts \"Alan Watts\"), [Thích Nhất Hạnh](Th%C3%ADch_Nh%E1%BA%A5t_H%E1%BA%A1nh \"Thích Nhất Hạnh\"), and the [14th Dalai Lama](14th_Dalai_Lama \"14th Dalai Lama\"). While Buddhist institutions have grown, some of the central premises of Buddhism such as the cycles of rebirth and [Four Noble Truths](Four_Noble_Truths \"Four Noble Truths\") have been problematic in the West.[498][499][500] In contrast, states Christopher Gowans, for \"most ordinary [Asian] Buddhists, today as well as in the past, their basic moral orientation is governed by belief in karma and rebirth\".[501] Most Asian Buddhist laypersons, states Kevin Trainor, have historically pursued Buddhist rituals and practices seeking better rebirth,[502] not nirvana or freedom from rebirth.[503]\n\nBuddhism has spread across the world,[505][506] and Buddhist texts are increasingly translated into local languages. While [Buddhism in the West](Buddhism_in_the_West \"Buddhism in the West\") is often seen as exotic and progressive, in the East it is regarded as familiar and traditional. In countries such as [Cambodia](Cambodia \"Cambodia\") and [Bhutan](Bhutan \"Bhutan\"), it is recognised as the [state religion](State_religion \"State religion\") and receives government support. \n\n### Neo-Buddhism movements\n\nA number of modern movements in Buddhism emerged during the second half of the 20th century.[507][508] These [new forms of Buddhism](Buddhist_modernism \"Buddhist modernism\") are diverse and significantly depart from traditional beliefs and practices.[509]\n\nIn India, [B.R. Ambedkar](B.R._Ambedkar \"B.R. Ambedkar\") launched the Navayana tradition—literally, \"new vehicle\". Ambedkar's Buddhism rejects the foundational doctrines and historic practices of traditional Theravada and Mahayana traditions, such as monk lifestyle after renunciation, karma, rebirth, samsara, meditation, nirvana, Four Noble Truths and others.[510][511][512] Ambedkar's Navayana Buddhism considers these as superstitions and re-interprets the original Buddha as someone who taught about [class struggle](Class_conflict \"Class conflict\") and social equality.[513][514] Ambedkar urged low caste Indian [Dalits](Dalit \"Dalit\") to convert to his Marxism-inspired[512] reinterpretation called the [Navayana](Navayana \"Navayana\") Buddhism, also known as Bhimayana Buddhism. Ambedkar's effort led to the expansion of Navayana Buddhism in India.[515][513]\n\nThe Thai King [Mongkut](Mongkut \"Mongkut\") (r. 1851–68), and his son [Chulalongkorn](Chulalongkorn \"Chulalongkorn\") (r. 1868–1910), were responsible for modern reforms of [Thai Buddhism](Buddhism_in_Thailand \"Buddhism in Thailand\").[516] Modern Buddhist movements include [Secular Buddhism](Secular_Buddhism \"Secular Buddhism\") in many countries, [Won Buddhism](Won_Buddhism \"Won Buddhism\") in Korea, the [Dhammakaya movement](Dhammakaya_movement \"Dhammakaya movement\") in Thailand and several Japanese organisations, such as [Shinnyo-en](Shinnyo-en \"Shinnyo-en\"), [Risshō Kōsei Kai](Rissh%C5%8D_K%C5%8Dsei_Kai \"Risshō Kōsei Kai\") or [Soka Gakkai](Soka_Gakkai \"Soka Gakkai\"). \n\nSome of these movements have brought internal disputes and strife within regional Buddhist communities. For example, the Dhammakaya movement in Thailand teaches a \"true self\" doctrine, which traditional Theravada monks consider as heretically denying the fundamental _anatta_ ([not-self](Anatt%C4%81 \"Anattā\")) doctrine of Buddhism.[517][518][519]\n\n### Sexual abuse and misconduct\n\nBuddhism has not been immune from sexual abuse and misconduct scandals, with victims coming forward in various Buddhist schools such as [Zen](Zen \"Zen\") and [Tibetan](Tibetan_Buddhism \"Tibetan Buddhism\").[520][521][522] \"There are huge cover ups in the Catholic church, but what has happened within Tibetan Buddhism is totally along the same lines,\" says Mary Finnigan, an author and journalist who has been chronicling such alleged abuses since the mid-80s.[523] One notably covered [case](Sogyal_Rinpoche#Abuse_allegations \"Sogyal Rinpoche\") in media of various Western countries was that of [Sogyal Rinpoche](Sogyal_Rinpoche \"Sogyal Rinpoche\") which began in 1994,[524] and ended with his retirement from his position as [Rigpa](Rigpa_\\(organization\\) \"Rigpa \\(organization\\)\")'s spiritual director in 2017.[525]\n\n### Classification\n\nThere is consensus among religious studies scholars that Buddhism is a religion.[527] However, Buddhism has posed problems to Western scholars of religion who define religion based solely on a \"theistic conception\".[527][528] Further, some [Western Buddhists](Western_Buddhism \"Western Buddhism\") and commentators like [Alan Watts](Alan_Watts \"Alan Watts\") maintain that Buddhism does not constitute a religion but rather a philosophy, a [psychotherapy](Psychotherapy \"Psychotherapy\"), or a [way of life](Practical_philosophy \"Practical philosophy\").[529][530][528] This conception is rooted in 19th century [orientalist](Orientalism \"Orientalism\") writers, such as [theosophist](Theosophy \"Theosophy\") [Henry Steel Olcott](Henry_Steel_Olcott \"Henry Steel Olcott\"), which reinterpreted Buddhism in a [Protestant](Protestantism \"Protestantism\") lens and viewed contemporary Buddhism in Asia as representing a debased religious form of what was originally non-religious and rational.[531] Some Buddhist teachers and commentators, such as _Dharmavidya_ David Brazier, have criticized the persistence of this view.[532][533] Among Buddhists in [Sri Lanka](Sri_Lanka \"Sri Lanka\"), Buddhism is parallel to [Hinduism](Hinduism \"Hinduism\"), [Islam](Islam \"Islam\"), and [Christianity](Christianity \"Christianity\") as an _āgama_ ,[534] literally \"scripture\" or \"teaching\".[535]\n## Cultural influence\n\nBuddhism has had a profound influence on various cultures, especially in Asia. [Buddhist philosophy](Buddhist_philosophy \"Buddhist philosophy\"), [Buddhist art](Buddhist_art \"Buddhist art\"), [Buddhist architecture](Buddhist_architecture \"Buddhist architecture\"), [Buddhist cuisine](Buddhist_cuisine \"Buddhist cuisine\") and [Buddhist festivals](Buddhist_festivals \"Buddhist festivals\") continue to be influential elements of the modern [Culture of Asia](Culture_of_Asia \"Culture of Asia\"), especially in [East Asia](East_Asia \"East Asia\") and the [Sinosphere](East_Asian_cultural_sphere \"East Asian cultural sphere\") as well as in [Southeast Asia](Southeast_Asia \"Southeast Asia\") and the [Indosphere](Indosphere \"Indosphere\"). According to Litian Fang, Buddhism has \"permeated a wide range of fields, such as politics, ethics, philosophy, literature, art and customs\", in these Asian regions.[536] Buddhist teachings influenced the development of Hinduism, particularly in aspects like Advaita Vedanta and the bhakti movement, as well as other Asian religions like Taoism and Confucianism through syncretism and concepts in Neo-Confucianism.[](https://iep.utm.edu/hindu-ph/)[](https://plato.stanford.edu/entries/song-ming-confucianism/) Buddhist philosophers like [Dignaga](Dign%C4%81ga \"Dignāga\") and [Dharmakirti](Dharmakirti \"Dharmakirti\") were very influential in the development of [Indian logic](Indian_logic \"Indian logic\") and [epistemology](Pramana \"Pramana\").[537] Buddhist educational institutions like [Nalanda](Nalanda \"Nalanda\") and [Vikramashila](Vikramashila \"Vikramashila\") preserved various disciplines of classical Indian knowledge such as grammar, astronomy/astrology and medicine and taught foreign students from Asia.[538] In contemporary contexts, Buddhism has shaped global environmental movements through engaged Buddhism, as promoted by figures like Thich Nhat Hanh.[](https://www.britannica.com/topic/engaged-Buddhism)\n\nIn the Western world, Buddhism has had a strong influence on modern [New Age](New_Age \"New Age\") spirituality and other alternative spiritualities. This began with its influence on 20th century [Theosophists](Theosophists \"Theosophists\") such as [Helena Blavatsky](Helena_Blavatsky \"Helena Blavatsky\"), which were some of the first Westerners to take Buddhism seriously as a spiritual tradition.[539] More recently, Buddhist meditation practices have influenced the development of modern [psychology](Psychology \"Psychology\"), particularly the practice of [Mindfulness-based stress reduction](Mindfulness-based_stress_reduction \"Mindfulness-based stress reduction\") (MBSR) and other similar [mindfulness](Mindfulness \"Mindfulness\") based modalities.[540][541] The influence of [Buddhism on psychology](Buddhism_and_psychology \"Buddhism and psychology\") can also be seen in certain forms of modern [psychoanalysis](Psychoanalysis \"Psychoanalysis\").[542][543] As of 2025, mindfulness practices derived from Buddhism are integrated into digital health apps and corporate wellness programs worldwide.[](https://www.apa.org/monitor/2023/01/trends-mindfulness-apps)\n## Demographics\n\nBuddhism is practiced by an estimated 324 million people as of 2020, representing 4.1% of the world's total population.[](https://www.pewresearch.org/religion/2025/06/09/buddhist-population-change/) This marks a 5% decline from 343 million in 2010. Buddhism is the only major religion to have declined in absolute numbers over the last decade, primarily due to religious disaffiliation in East Asia and low birth rates in aging populations.[](https://www.pewresearch.org/religion/2025/06/09/buddhist-population-change/)\n\nChina has the largest population of Buddhists, with estimates ranging from 53 million (4% formal affiliation) to 362 million (33% holding Buddhist beliefs) as of recent surveys.[](https://www.pewresearch.org/religion/2023/08/30/buddhism/) They are mostly followers of Chinese schools of [Mahayana](Mahayana \"Mahayana\"), making this the largest body of Buddhist traditions. Mahayana, also practiced in broader [East Asia](Buddhism_in_East_Asia \"Buddhism in East Asia\"), is followed by over half of the world's Buddhists. Buddhism is the dominant religion in [Thailand](Buddhism_in_Thailand \"Buddhism in Thailand\") (93-95%), [Cambodia](Buddhism_in_Cambodia \"Buddhism in Cambodia\") (97%), [Myanmar](Buddhism_in_Myanmar \"Buddhism in Myanmar\") (88%), [Sri Lanka](Buddhism_in_Sri_Lanka \"Buddhism in Sri Lanka\") (70%), [Bhutan](Buddhism_in_Bhutan \"Buddhism in Bhutan\") ("])</script><script nonce="NjJkOTBiYzYtNmE5ZS00MDEzLThiZTAtNWYyZmEzZTUxOWY4">self.__next_f.push([1,"8:[\"$\",\"$L1e\",null,{\"state\":{\"mutations\":[],\"queries\":[{\"dehydratedAt\":1761777763184,\"state\":{\"data\":{\"page\":{\"citations\":[],\"images\":[],\"fixedIssues\":[{\"criticality\":\"Critical\",\"issueType\":\"Factual Inaccuracy\",\"problematicText\":\"Early texts have the Buddha's family name as \\\"Gautama\\\" (Pali: Gotama), while some texts give Siddhartha as his surname.\",\"explanation\":\"In Buddhist texts, \\\"Siddhattha\\\" (Pali; Sanskrit: Siddhārtha) is the personal or given name, while \\\"Gotama\\\" (Pali; Sanskrit: Gautama) is the clan or family name. Calling Siddhartha the \\\"surname\\\" reverses this and misrepresents standard nomenclature in early sources.\",\"fixedText\":\"Revise to: \\\"Early texts give his personal name as Siddhattha (Sanskrit: Siddhārtha) and his clan name as Gotama (Sanskrit: Gautama).\\\"\",\"evidenceSource\":\"Gethin (1998), pp. 13–14 [ref 35]; also standard in scholarship, e.g., Lopez (1995), p. 16 [ref 40]\"},{\"criticality\":\"Critical\",\"issueType\":\"Scope/Applicability Misstatement\",\"problematicText\":\"The Buddha's teachings were propagated by his followers, which in the last centuries of the 1st millennium BCE became various [Buddhist schools of thought](Schools_of_Buddhism \\\"Schools of Buddhism\\\"), each with its own [basket of texts](Tripi%E1%B9%ADaka \\\"Tripiṭaka\\\") containing different interpretations and authentic teachings of the Buddha;[60][61][62] these over time evolved into many traditions of which the more well known and widespread in the modern era are [Theravada](Theravada \\\"Theravada\\\"), [Mahayana](Mahayana \\\"Mahayana\\\") and [Vajrayana](Vajrayana \\\"Vajrayana\\\") Buddhism.[63][64]\",\"explanation\":\"This paragraph shifts from biography to the historical development and classification of Buddhist schools and texts, which duplicates content in later sections (\\\"History\\\" with \\\"Pre-sectarian Buddhism,\\\" \\\"Ashokan Era and the early schools\\\"; \\\"Texts\\\"; \\\"Schools and traditions\\\"). It exceeds the biographical scope of \\\"The Buddha\\\" section per article structure, potentially confusing readers and violating Wikipedia's non-duplication guideline.\",\"fixedText\":\"Remove the entire paragraph to focus solely on the Buddha's life; propagation overview belongs in \\\"History.\\\"\",\"evidenceSource\":\"Article structure outline; refs 60–64 support schools but not placement here\"},{\"criticality\":\"Critical\",\"issueType\":\"Missing Information\",\"problematicText\":\"[No specific quote; overall section lacks detail on birthplace evidence]\",\"explanation\":\"The section mentions Lumbini as birthplace but omits key archaeological confirmation (e.g., 2013 UNESCO pillar inscription dating to Ashoka's era), a factual detail supporting historicity amid noted inconsistencies in texts. This is a knowledge gap for verifiability and completeness.\",\"fixedText\":\"Add: \\\"This is supported by archaeological evidence, including an inscription at Lumbini attributed to Emperor Ashoka (3rd century BCE), confirming it as the Buddha's birthplace.[](https://whc.unesco.org/en/list/666/)\\\" after the Lumbini mention.\",\"evidenceSource\":\"UNESCO Lumbini site; ref 57 (Sarao 2020) discusses Mahabodhi but extends to Lumbini evidence\"},{\"criticality\":\"Critical\",\"issueType\":\"Source/Citation Mismatch | Mechanism/Specification Error\",\"problematicText\":\"\\\"Modern scholars believe that this was probably caused when a group of reformists called Sthaviras (\\\"elders\\\") sought to modify the Vinaya (monastic rule), and this caused a split with the conservatives who rejected this change, they were called Mahāsāṃghikas.\\\"\",\"explanation\":\"This reverses the historical roles in the Second Buddhist Council schism. Scholarly consensus holds that the Mahāsāṃghikas (majority, more liberal/reformist) supported lax Vinaya practices (the \\\"Ten Points\\\"), while the Sthaviras (elders, minority, conservative) opposed them, leading to the split. This misstates the doctrinal and disciplinary mechanism of early Buddhist schisms, potentially misleading on the origins of schools like Theravada (from Sthaviras).\",\"fixedText\":\"Revise to: \\\"Modern scholars believe this was caused by disputes over ten lax monastic practices proposed by the more liberal Mahāsāṃghikas, which the conservative Sthaviras opposed, leading to the first schism.\\\"\",\"evidenceSource\":\"[](https://en.wikipedia.org/wiki/Buddhist_councils) [](https://www.learnreligions.com/the-buddhist-councils-450076)\"},{\"criticality\":\"Critical\",\"issueType\":\"Scope/Applicability Misstatement\",\"problematicText\":\"\\\"Early Buddhist positions in the Theravada tradition had not established any deities, but were epistemologically cautious rather than directly atheist. Later Buddhist traditions were more influenced by the critique of deities within Hinduism and therefore more committed to a strongly atheist stance.\\\"\",\"explanation\":\"Early Buddhism (including Theravada sources) accepts the existence of deities (devas) as part of samsara, subject to karma and rebirth, but non-central and non-creator. The phrasing implies denial or non-establishment of deities, which is inaccurate; Buddhism is non-theistic, not strictly atheist. Later traditions (e.g., Mahayana) incorporate more deities/bodhisattvas, contradicting \\\"strongly atheist stance.\\\"\",\"fixedText\":\"Revise to: \\\"Early Buddhism, as preserved in Theravada, accepts deities (devas) as existent but impermanent beings within samsara, without positing a creator god; it is non-theistic rather than atheistic in denying all supernatural entities. Later traditions maintained this non-theistic view while incorporating devotional elements.\\\"\",\"evidenceSource\":\"[](https://en.wikipedia.org/wiki/Creator_in_Buddhism) [](https://academic.oup.com/edited-volume/37199/chapter/327368805)\"},{\"criticality\":\"Critical\",\"issueType\":\"Missing Information\",\"problematicText\":\"[Entire \\\"Pre-sectarian Buddhism\\\" subsection lacks mention of recent archaeological evidence.]\",\"explanation\":\"The subsection discusses early texts and reliability but omits key recent evidence from Gandharan manuscripts (dated ~1st century BCE–3rd CE), which provide the oldest surviving Buddhist texts and confirm continuity with non-Mahayana/Theravada doctrines, enhancing understanding of pre-sectarian Buddhism's scope and authenticity.\",\"fixedText\":\"Add after discussion of core teachings: \\\"Recent discoveries of Gandharan Buddhist manuscripts (c. 1st century BCE–3rd CE) provide the earliest physical evidence of these teachings, aligning closely with Theravada traditions and supporting their antiquity.\\\"\",\"evidenceSource\":\"[](https://www.lionsroar.com/how-the-gandharan-manuscripts-change-buddhist-history/)\"},{\"criticality\":\"Critical\",\"issueType\":\"Mechanism/Specification Error\",\"problematicText\":\"\\\"Theravāda only focuses on the elimination of ignorance (not realising the Four Noble Truths)).[475]\\\"\",\"explanation\":\"This phrasing incorrectly states that Theravāda focuses on eliminating ignorance without realizing the Four Noble Truths, contradicting core Buddhist doctrine where realizing the Four Noble Truths is the method to eliminate ignorance (avijjā). This appears multiple times in the table (e.g., under Mahāyāna descriptions), creating factual inaccuracy in describing soteriological goals.\",\"fixedText\":\"Replace all instances of \\\"elimination of ignorance (not realising the Four Noble Truths)\\\" with \\\"realization of the Four Noble Truths (eliminating ignorance)\\\" to accurately reflect Theravāda's emphasis on insight into the truths as the path to ending ignorance.\",\"evidenceSource\":\"[66] (Encyclopædia Britannica on Four Noble Truths as foundational realization); [67] (Nyanatiloka on dukkha and its cessation via truths)\"},{\"criticality\":\"Critical\",\"issueType\":\"Internal Contradiction\",\"problematicText\":\"\\\"Mahāyāna sees the elimination of ignorance (not realising the Four Noble Truths)) as being imperfect and inferior or preliminary to full Buddhahood.\\\"\",\"explanation\":\"This contradicts the prior correction and standard teachings; Mahāyāna views arhatship (realization of truths, ending ignorance) as preliminary but still a valid realization, not \\\"not realising.\\\" The negative phrasing undermines the doctrinal consistency across traditions.\",\"fixedText\":\"Revise to: \\\"Mahāyāna sees the realization of the Four Noble Truths (arhatship, eliminating ignorance) as being imperfect and preliminary to full Buddhahhood.\\\"\",\"evidenceSource\":\"[479] (Hirakawa on Mahāyāna soteriology); [69] (Williams on shared acceptance of truths)\"},{\"criticality\":\"Critical\",\"issueType\":\"Missing Information\",\"problematicText\":\"No specific mention of Vajrayāna's distinct status or modern traditions like Navayāna.\",\"explanation\":\"The section classifies Vajrayāna as part of Mahāyāna but lacks detail on its esoteric elements or independence in some schemes; omits contemporary developments like Navayāna (Ambedkarite Buddhism in India), which is listed in article intro and structure but not here, creating a knowledge gap in \\\"traditions\\\" coverage up to 2025.\",\"fixedText\":\"Add brief paragraph on Vajrayāna's features and mention Navayāna as a modern tradition, citing sources, without duplicating later sections.\",\"evidenceSource\":\"[21] (White on Vajrayāna as tantric within Mahāyāna); Pew Research (2025) on global demographics including modern movements\"},{\"criticality\":\"Critical\",\"issueType\":\"Source/Citation Mismatch\",\"problematicText\":\"\\\"Buddhist teachings influenced the development of modern Hinduism as well as other Asian religions like Taoism and Confucianism.\\\"\",\"explanation\":\"This claim makes a broad historical assertion about religious influences without any supporting citation, violating Wikipedia's verifiability standards (WP:VERIFY). While scholarly consensus supports Buddhist influences on these traditions (e.g., on Advaita Vedanta in Hinduism, Neo-Confucianism, and Taoist syncretism in China), the lack of sourcing makes it unverifiable and potentially misleading if interpreted without nuance.\",\"fixedText\":\"Add citations to authoritative scholarly sources immediately after the claim, e.g., [](https://plato.stanford.edu/entries/song-ming-confucianism/) for Confucianism and [](https://iep.utm.edu/hindu-ph/) for Hinduism. Qualify \\\"modern\\\" if needed for precision, as influences span historical periods.\",\"evidenceSource\":\"No citation provided in section; verified via external sources including Stanford Encyclopedia of Philosophy (Song-Ming Confucianism entry) and Internet Encyclopedia of Philosophy (Hindu Philosophy).\"},{\"criticality\":\"Critical\",\"issueType\":\"Missing Information\",\"problematicText\":\"N/A (section-wide gap)\",\"explanation\":\"The section lacks specific examples or recent developments in cultural influence, such as Buddhism's role in modern environmental ethics (e.g., engaged Buddhism) or pop culture (e.g., mindfulness in Western media as of 2025). This creates a knowledge gap in illustrating the \\\"profound influence,\\\" reducing depth and currency for an encyclopedic overview.\",\"fixedText\":\"Add 1-2 sourced examples of contemporary global influences, e.g., on environmentalism or digital mindfulness apps, with citations dated to 2025 or earlier.\",\"evidenceSource\":\"Article structure shows \\\"Cultural influence\\\" as a standalone section; external verification confirms ongoing influences like Thich Nhat Hanh's eco-Buddhism (post-2000).\"},{\"criticality\":\"Critical\",\"issueType\":\"Quantitative/Units Error\",\"problematicText\":\"Buddhism is practiced by an estimated 342 million in 2020, representing 4% of the world's total population.[544]\",\"explanation\":\"The cited Pew Research Center report from 2025 estimates 324 million Buddhists in 2020, a 5% decline from 343 million in 2010, representing 4.1% of the world population. The figure of 342 million mismatches the source and uses an outdated estimate.\",\"fixedText\":\"Update to: \\\"Buddhism is practiced by an estimated 324 million people as of 2020, representing 4.1% of the world's total population.\\\"\",\"evidenceSource\":\"[544] Pew Research Center (2025): https://www.pewresearch.org/religion/2025/06/09/buddhist-population-change/\"},{\"criticality\":\"Critical\",\"issueType\":\"Source/Citation Mismatch\",\"problematicText\":\"They were previously estimated 488 million,[545] 495 million,[546] or 535 million[547] people as of the 2010.\",\"explanation\":\"The latest Pew 2025 report revises the 2010 estimate to 343 million, indicating previous higher figures from older reports (e.g., 2012 Pew at 488 million) are no longer current. This creates inconsistency with the primary cited source [544].\",\"fixedText\":\"Update to reflect revised 2010 estimate: \\\"Previously estimated at 343 million as of 2010.\\\"\",\"evidenceSource\":\"[544] Pew Research Center (2025)\"},{\"criticality\":\"Critical\",\"issueType\":\"Quantitative/Units Error\",\"problematicText\":\"[China](China \\\"China\\\") is the country with the largest population of Buddhists, approximately 244 million or 18% of its total population.[545][note 32]\",\"explanation\":\"The 244 million (18%) is from a 2012 Pew report. The 2025 Pew report notes a 23 million decline in China from 2010-2020, estimating formal affiliation at around 53 million (4%) in 2020, though broader measures reach up to 33% (~362 million). This mismatch uses outdated data.\",\"fixedText\":\"Update to: \\\"China has the largest population of Buddhists, with estimates ranging from 53 million (4% formal affiliation) to 362 million (33% broader belief) as of recent surveys.\\\"\",\"evidenceSource\":\"[544] Pew Research Center (2025); Pew 2023: https://www.pewresearch.org/religion/2023/08/30/buddhism/\"},{\"criticality\":\"Critical\",\"issueType\":\"Scope/Applicability Misstatement\",\"problematicText\":\"Buddhism is the dominant religion in [Thailand](Buddhism_in_Thailand \\\"Buddhism in Thailand\\\"), [Cambodia](Buddhism_in_Cambodia \\\"Buddhism in Cambodia\\\"), [Tibet](Buddhism_in_Tibet \\\"Buddhism in Tibet\\\"), [Myanmar](Buddhism_in_Myanmar \\\"Buddhism in Myanmar\\\"), [Sri Lanka](Buddhism_in_Sri_Lanka \\\"Buddhism in Sri Lanka\\\"), [Bhutan](Buddhism_in_Bhutan \\\"Buddhism in Bhutan\\\"), [Laos](Buddhism_in_Laos \\\"Buddhism in Laos\\\"), [Mongolia](Buddhism_in_Mongolia \\\"Buddhism in Mongolia\\\"), [Japan](Buddhism_in_Japan \\\"Buddhism in Japan\\\"),[549] Hong Kong,[550] Macau, [Singapore](Buddhism_in_Singapore \\\"Buddhism in Singapore\\\"),[551] and [Vietnam](Buddhism_in_Vietnam \\\"Buddhism in Vietnam\\\").[552]\",\"explanation\":\"Buddhism is not the dominant religion in Japan, where it coexists syncretically with Shintoism, and only about 35% identify as Buddhist while many are non-religious. Tibet is an autonomous region of China, not an independent country. In Hong Kong, Macau, and Singapore, Buddhism is significant but not dominant (e.g., Hong Kong ~20-30%, Singapore ~33%). In Vietnam, estimates vary (14-50%), but it's the largest religion without clear dominance.\",\"fixedText\":\"Revise list to accurate dominant countries/regions: Thailand, Cambodia, Myanmar, Sri Lanka, Bhutan, Laos, Mongolia. Remove Japan, Hong Kong, Macau, Singapore, Vietnam, Tibet (or specify as region). Add note for where it's predominant.\",\"evidenceSource\":\"Pew Research (2020-2025); Wikipedia summaries based on censuses\"},{\"criticality\":\"Critical\",\"issueType\":\"Timeliness/Currency\",\"problematicText\":\"The Indian state of [Maharashtra](Maharashtra \\\"Maharashtra\\\") accounts for 77% of all Buddhists in India.[554]\",\"explanation\":\"The 77% figure is from the 2011 census. India's 2021 census religion data has not been fully released as of 2025, but preliminary or projected data may exist; using 14-year-old data without note is outdated for demographics.\",\"fixedText\":\"Add \\\"as of 2011 census\\\" and check for updates; if no new data, retain with qualifier.\",\"evidenceSource\":\"2011 Indian Census\"},{\"criticality\":\"Critical\",\"issueType\":\"Quantitative/Units Error\",\"problematicText\":\"In Russia, Buddhists form majority in [Tuva](Tuva \\\"Tuva\\\") (52%) and [Kalmykia](Kalmykia \\\"Kalmykia\\\") (53%). [Buryatia](Buryatia \\\"Buryatia\\\") (20%) and [Zabaykalsky Krai](Zabaykalsky Krai \\\"Zabaykalsky Krai\\\") (15%) also have significant Buddhist populations.[555]\",\"explanation\":\"Percentages vary by source; recent estimates show Tuva ~62% (2012), Kalmykia ~47-53%, Buryatia ~20%, but Zabaykalsky Krai ~6-15%. Cited source [555] is a 1993 book, outdated; 2021 census data indicates inconsistencies (e.g., Tuva 38% in some reports).\",\"fixedText\":\"Update with recent estimates: Tuva ~62%, Kalmykia ~53%, Buryatia ~20%, Zabaykalsky Krai ~6%, citing reliable source.\",\"evidenceSource\":\"Russia 2021 Census summaries; Pew Research\"},{\"criticality\":\"Critical\",\"issueType\":\"Missing Information\",\"problematicText\":\"[No specific text; overall section]\",\"explanation\":\"The section lacks updates post-2020, such as projected growth/decline to 2025 or recent trends like increasing conversions in the West or declines in specific countries. As of 2025, Pew's 2020 data is the latest comprehensive, but note ongoing disaffiliation.\",\"fixedText\":\"Add: \\\"As of 2025, estimates remain around 324 million, with continued slow decline projected due to low fertility and disaffiliation.\\\"\",\"evidenceSource\":\"Pew Research 2025\"},{\"criticality\":\"Critical\",\"issueType\":\"Source/Citation Mismatch\",\"problematicText\":\"Williams refers to Frauwallner (1973, p. 155)\",\"explanation\":\"The reference to Frauwallner (1973, p. 155) is mentioned but not included in the provided references list, making the claim unverifiable and unsupported.\",\"fixedText\":\"Remove the note as it is incomplete and unverifiable without the full reference.\",\"evidenceSource\":\"No matching reference in provided list\"},{\"criticality\":\"Critical\",\"issueType\":\"Source/Citation Mismatch\",\"problematicText\":\"Warder.[426]\",\"explanation\":\"Citation [426] refers to Nattier (2003), which does not support the quote from A.K. Warder (2000, p. 335). This misattributes the source.\",\"fixedText\":\"Correct attribution to Warder (2000, p. 335) and cite appropriately, e.g., [378] if matching Warder entry.\",\"evidenceSource\":\"[426] Nattier (2003); correct source: Warder (2000), p. 335. [](https://en.wikipedia.org/wiki/Mahayana)\"},{\"criticality\":\"Critical\",\"issueType\":\"Source/Citation Mismatch\",\"problematicText\":\"[445]\",\"explanation\":\"Citation [445] refers to Nguyen Tai Thu (2008), which does not support the reference to Hill (2009, pp. 30-31) on the Hou Hanshu text and translation.\",\"fixedText\":\"Add reference to Hill (2009) and cite as [Hill 2009, pp. 30-31] or new citation.\",\"evidenceSource\":\"[445] Nguyen (2008); correct source: Hill, John E. (2009), Through the Jade Gate to Rome, pp. 30-31. [](https://en.wikipedia.org/wiki/Silk_Road_transmission_of_Buddhism)\"}],\"slug\":\"Buddhism\",\"title\":\"Buddhism\",\"content\":\"$1f\",\"description\":\"Buddhism\\n\\nBuddhism\u003csup\u003e[a]\u003c/sup\u003e, also known as Buddhadharma and Dharmavinaya, is an Indian religion\u003csup\u003e[b]\u003c/sup\u003e based on teachings attributed to the Buddha, a wandering teacher who lived in the...\",\"metadata\":{\"categories\":[],\"lastModified\":\"1761552723\",\"contentLength\":\"121153\",\"version\":\"1.0\",\"lastEditor\":\"system\",\"language\":\"en\",\"isRedirect\":false,\"redirectTarget\":\"\",\"isWithheld\":false},\"stats\":{\"totalViews\":\"2328416\",\"recentViews\":\"2328416\",\"dailyAvgViews\":77613.8671875,\"qualityScore\":1,\"lastViewed\":\"1761777763\"},\"linkedPages\":null},\"found\":true},\"dataUpdateCount\":1,\"dataUpdatedAt\":1761777763179,\"error\":null,\"errorUpdateCount\":0,\"errorUpdatedAt\":0,\"fetchFailureCount\":0,\"fetchFailureReason\":null,\"fetchMeta\":null,\"isInvalidated\":false,\"status\":\"success\",\"fetchStatus\":\"idle\"},\"queryKey\":[\"page\",\"Buddhism\"],\"queryHash\":\"[\\\"page\\\",\\\"Buddhism\\\"]\"}]},\"children\":\"$L20\"}]\n"])</script><script nonce="NjJkOTBiYzYtNmE5ZS00MDEzLThiZTAtNWYyZmEzZTUxOWY4">self.__next_f.push([1,"c:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Buddhism | Grokipedia\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Buddhism[a], also known as Buddhadharma and Dharmavinaya, is an Indian religion[b] based on teachings attributed to the Buddha, a wandering teacher who lived in the 6th or 5th century BCE.[7] It is the world's fourth-largest religion,[8][9] with about 320 million followers, known as Buddhists, who comprise four percent of the global population.[10] It arose in the eastern Gangetic plain as a śramaṇa movement in the 5th century BCE, and gradually spread throughout much of Asia. Buddhism has...\"}],[\"$\",\"meta\",\"2\",{\"name\":\"author\",\"content\":\"system\"}],[\"$\",\"link\",\"3\",{\"rel\":\"manifest\",\"href\":\"/manifest.webmanifest\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"4\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"5\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-snippet:-1\"}],[\"$\",\"link\",\"6\",{\"rel\":\"canonical\",\"href\":\"https://grokipedia.com/page/Buddhism\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:title\",\"content\":\"Buddhism\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:description\",\"content\":\"Buddhism[a], also known as Buddhadharma and Dharmavinaya, is an Indian religion[b] based on teachings attributed to the Buddha, a wandering teacher who lived in the 6th or 5th century BCE.[7] It is the world's fourth-largest religion,[8][9] with about 320 million followers, known as Buddhists, who comprise four percent of the global population.[10] It arose in the eastern Gangetic plain as a śramaṇa movement in the 5th century BCE, and gradually spread throughout much of Asia. Buddhism has...\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:url\",\"content\":\"https://grokipedia.com/page/Buddhism\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:site_name\",\"content\":\"Grokipedia\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:locale\",\"content\":\"en\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:image\",\"content\":\"https://grokipedia.com/icon-512x512.png\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:image:width\",\"content\":\"512\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:image:height\",\"content\":\"512\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:image:alt\",\"content\":\"Buddhism\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"17\",{\"property\":\"article:modified_time\",\"content\":\"1970-01-21T09:19:12.723Z\"}],[\"$\",\"meta\",\"18\",{\"name\":\"twitter:card\",\"content\":\"summary\"}],[\"$\",\"meta\",\"19\",{\"name\":\"twitter:creator\",\"content\":\"@Grokipedia\"}],[\"$\",\"meta\",\"20\",{\"name\":\"twitter:title\",\"content\":\"Buddhism\"}],[\"$\",\"meta\",\"21\",{\"name\":\"twitter:description\",\"content\":\"Buddhism[a], also known as Buddhadharma and Dharmavinaya, is an Indian religion[b] based on teachings attributed to the Buddha, a wandering teacher who lived in the 6th or 5th century BCE.[7] It is the world's fourth-largest religion,[8][9] with about 320 million followers, known as Buddhists, who comprise four percent of the global population.[10] It arose in the eastern Gangetic plain as a śramaṇa movement in the 5th century BCE, and gradually spread throughout much of Asia. Buddhism has...\"}],[\"$\",\"meta\",\"22\",{\"name\":\"twitter:image\",\"content\":\"https://grokipedia.com/icon-512x512.png\"}],[\"$\",\"link\",\"23\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"sizes\":\"32x32\",\"type\":\"image/x-icon\"}],[\"$\",\"link\",\"24\",{\"rel\":\"icon\",\"href\":\"/images/icon-dark.png\",\"media\":\"(prefers-color-scheme: light)\",\"type\":\"image/png\"}],[\"$\",\"link\",\"25\",{\"rel\":\"icon\",\"href\":\"/images/icon-light.png\",\"media\":\"(prefers-color-scheme: dark)\",\"type\":\"image/png\"}],[\"$\",\"link\",\"26\",{\"rel\":\"apple-touch-icon\",\"href\":\"/icon-192x192.png\"}],[\"$\",\"$L21\",\"27\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n"])</script><script nonce="NjJkOTBiYzYtNmE5ZS00MDEzLThiZTAtNWYyZmEzZTUxOWY4">self.__next_f.push([1,"11:\"$c:metadata\"\n"])</script><script nonce="NjJkOTBiYzYtNmE5ZS00MDEzLThiZTAtNWYyZmEzZTUxOWY4">self.__next_f.push([1,"22:I[61172,[\"8739\",\"static/chunks/63f0ec43-8ee6a76d70472249.js\",\"2254\",\"static/chunks/8208b75a-a48e5a4507a0de91.js\",\"4684\",\"static/chunks/24cf1b50-159cca90b09285e0.js\",\"1829\",\"static/chunks/9ffa21ba-c069766d809bd4c7.js\",\"7670\",\"static/chunks/7670-def27a8af6e0c44d.js\",\"282\",\"static/chunks/282-691fffb366e24ca5.js\",\"7515\",\"static/chunks/7515-336759ef5dad2b52.js\",\"5497\",\"static/chunks/5497-ab85ef3ea59dd353.js\",\"7720\",\"static/chunks/7720-3a1e7e411adba2d3.js\",\"6281\",\"static/chunks/6281-c6e84786dade3614.js\",\"7086\",\"static/chunks/7086-1f1c4891d766e04f.js\",\"600\",\"static/chunks/600-9a9fcafaaa6c1c4c.js\",\"5002\",\"static/chunks/5002-4d6d2ca837fbfe03.js\",\"5448\",\"static/chunks/5448-004667276a0cea5b.js\",\"5855\",\"static/chunks/5855-3a8c0d1551398f00.js\",\"4393\",\"static/chunks/4393-1c8dff25ec904469.js\",\"9214\",\"static/chunks/9214-a10614844a67ba31.js\",\"8\",\"static/chunks/8-8ca70ca619d8e099.js\",\"4789\",\"static/chunks/4789-2080f6497f78b5b6.js\",\"6304\",\"static/chunks/app/page/%5Bslug%5D/page-a9340b15d5ef4a80.js\"],\"PageEditorProvider\"]\n"])</script><script nonce="NjJkOTBiYzYtNmE5ZS00MDEzLThiZTAtNWYyZmEzZTUxOWY4">self.__next_f.push([1,"23:I[63493,[\"8739\",\"static/chunks/63f0ec43-8ee6a76d70472249.js\",\"2254\",\"static/chunks/8208b75a-a48e5a4507a0de91.js\",\"4684\",\"static/chunks/24cf1b50-159cca90b09285e0.js\",\"1829\",\"static/chunks/9ffa21ba-c069766d809bd4c7.js\",\"7670\",\"static/chunks/7670-def27a8af6e0c44d.js\",\"282\",\"static/chunks/282-691fffb366e24ca5.js\",\"7515\",\"static/chunks/7515-336759ef5dad2b52.js\",\"5497\",\"static/chunks/5497-ab85ef3ea59dd353.js\",\"7720\",\"static/chunks/7720-3a1e7e411adba2d3.js\",\"6281\",\"static/chunks/6281-c6e84786dade3614.js\",\"7086\",\"static/chunks/7086-1f1c4891d766e04f.js\",\"600\",\"static/chunks/600-9a9fcafaaa6c1c4c.js\",\"5002\",\"static/chunks/5002-4d6d2ca837fbfe03.js\",\"5448\",\"static/chunks/5448-004667276a0cea5b.js\",\"5855\",\"static/chunks/5855-3a8c0d1551398f00.js\",\"4393\",\"static/chunks/4393-1c8dff25ec904469.js\",\"9214\",\"static/chunks/9214-a10614844a67ba31.js\",\"8\",\"static/chunks/8-8ca70ca619d8e099.js\",\"4789\",\"static/chunks/4789-2080f6497f78b5b6.js\",\"6304\",\"static/chunks/app/page/%5Bslug%5D/page-a9340b15d5ef4a80.js\"],\"default\"]\n"])</script><script nonce="NjJkOTBiYzYtNmE5ZS00MDEzLThiZTAtNWYyZmEzZTUxOWY4">self.__next_f.push([1,"20:[\"$\",\"$L22\",null,{\"children\":[\"$\",\"$L23\",null,{\"slug\":\"Buddhism\"}]}]\n"])</script></body></html>