 -top-[3px] overflow-hidden break-words text-[16px] [&amp;_*]:mb-0"><span class="mb-4 block break-words text-[1em] leading-7"><a href="https://www.history.com/articles/olympic-boycotts" target="_blank" rel="noopener noreferrer" class="break-all text-[1em] text-blue-500 hover:underline dark:text-blue-300">https://www.history.com/articles/olympic-boycotts</a></span></div></li><li id="https://www.cfr.org/timeline/olympics-boycott-protest-politics-history" class="mb-2 grid break-inside-avoid grid-cols-[auto_1fr] gap-2 text-sm leading-relaxed [counter-increment:item] before:font-semibold before:content-[counter(item)&#x27;.&#x27;]"><div class="relative -top-[3px] overflow-hidden break-words text-[16px] [&amp;_*]:mb-0"><span class="mb-4 block break-words text-[1em] leading-7"><a href="https://www.cfr.org/timeline/olympics-boycott-protest-politics-history" target="_blank" rel="noopener noreferrer" class="break-all text-[1em] text-blue-500 hover:underline dark:text-blue-300">https://www.cfr.org/timeline/olympics-boycott-protest-politics-history</a></span></div></li><li id="https://www.britishmuseum.org/sites/default/files/2019-09/british_museum_olympic_games.pdf" class="mb-2 grid break-inside-avoid grid-cols-[auto_1fr] gap-2 text-sm leading-relaxed [counter-increment:item] before:font-semibold before:content-[counter(item)&#x27;.&#x27;]"><div class="relative -top-[3px] overflow-hidden break-words text-[16px] [&amp;_*]:mb-0"><span class="mb-4 block break-words text-[1em] leading-7"><a href="https://www.britishmuseum.org/sites/default/files/2019-09/british_museum_olympic_games.pdf" target="_blank" rel="noopener noreferrer" class="break-all text-[1em] text-blue-500 hover:underline dark:text-blue-300">https://www.britishmuseum.org/sites/default/files/2019-09/british_museum_olympic_games.pdf</a></span></div></li><li id="https://www.olympics.com/ioc/ancient-olympic-games" class="mb-2 grid break-inside-avoid grid-cols-[auto_1fr] gap-2 text-sm leading-relaxed [counter-increment:item] before:font-semibold before:content-[counter(item)&#x27;.&#x27;]"><div class="relative -top-[3px] overflow-hidden break-words text-[16px] [&amp;_*]:mb-0"><span class="mb-4 block break-words text-[1em] leading-7"><a href="https://www.olympics.com/ioc/ancient-olympic-games" target="_blank" rel="noopener noreferrer" class="break-all text-[1em] text-blue-500 hover:underline dark:text-blue-300">https://www.olympics.com/ioc/ancient-olympic-games</a></span></div></li><li id="https://abcnews.go.com/International/history-olympics-ancient-games-date-back-776-bc/story?id=52029758" class="mb-2 grid break-inside-avoid grid-cols-[auto_1fr] gap-2 text-sm leading-relaxed [counter-increment:item] before:font-semibold before:content-[counter(item)&#x27;.&#x27;]"><div class="relative -top-[3px] overflow-hidden break-words text-[16px] [&amp;_*]:mb-0"><span class="mb-4 block break-words text-[1em] leading-7"><a href="https://abcnews.go.com/International/history-olympics-ancient-games-date-back-776-bc/story?id=52029758" target="_blank" rel="noopener noreferrer" class="break-all text-[1em] text-blue-500 hover:underline dark:text-blue-300">https://abcnews.go.com/International/history-olympics-ancient-games-date-back-776-bc/story?id=52029758</a></span></div></li><li id="https://www.metmuseum.org/perspectives/ancient-greek-olympic-games" class="mb-2 grid break-inside-avoid grid-cols-[auto_1fr] gap-2 text-sm leading-relaxed [counter-increment:item] before:font-semibold before:content-[counter(item)&#x27;.&#x27;]"><div class="relative -top-[3px] overflow-hidden break-words text-[16px] [&amp;_*]:mb-0"><span class="mb-4 block break-words text-[1em] leading-7"><a href="https://www.metmuseum.org/perspectives/ancient-greek-olympic-games" target="_blank" rel="noopener noreferrer" class="break-all text-[1em] text-blue-500 hover:underline dark:text-blue-300">https://www.metmuseum.org/perspectives/ancient-greek-olympic-games</a></span></div></li><li id="https://www.olympics.com/ioc/ancient-olympic-games/history" class="mb-2 grid break-inside-avoid grid-cols-[auto_1fr] gap-2 text-sm leading-relaxed [counter-increment:item] before:font-semibold before:content-[counter(item)&#x27;.&#x27;]"><div class="relative -top-[3px] overflow-hidden break-words text-[16px] [&amp;_*]:mb-0"><span class="mb-4 block break-words text-[1em] leading-7"><a href="https://www.olympics.com/ioc/ancient-olympic-games/history" target="_blank" rel="noopener noreferrer" class="break-all text-[1em] text-blue-500 hover:underline dark:text-blue-300">https://www.olympics.com/ioc/ancient-olympic-games/history</a></span></div></li><li id="https://www.open.edu/openlearn/history-the-arts/the-ancient-olympics-bridging-past-and-present/content-section-8.1" class="mb-2 grid break-inside-avoid grid-cols-[auto_1fr] gap-2 text-sm leading-relaxed [counter-increment:item] before:font-semibold before:content-[counter(item)&#x27;.&#x27;]"><div class="relative -top-[3px] overflow-hidden break-words text-[16px] [&amp;_*]:mb-0"><span class="mb-4 block break-words text-[1em] leading-7"><a href="https://www.open.edu/openlearn/history-the-arts/the-ancient-olympics-bridging-past-and-present/content-section-8.1" target="_blank" rel="noopener noreferrer" class="break-all text-[1em] text-blue-500 hover:underline dark:text-blue-300">https://www.open.edu/openlearn/history-the-arts/the-ancient-olympics-bridging-past-and-present/content-section-8.1</a></span></div></li><li id="https://whc.unesco.org/en/list/517/" class="mb-2 grid break-inside-avoid grid-cols-[auto_1fr] gap-2 text-sm leading-relaxed [counter-increment:item] before:font-semibold before:content-[counter(item)&#x27;.&#x27;]"><div class="relative -top-[3px] overflow-hidden break-words text-[16px] [&amp;_*]:mb-0"><span class="mb-4 block break-words text-[1em] leading-7"><a href="https://whc.unesco.org/en/list/517/" target="_blank" rel="noopener noreferrer" class="break-all text-[1em] text-blue-500 hover:underline dark:text-blue-300">https://whc.unesco.org/en/list/517/</a></span></div></li><li id="https://www.open.edu/openlearn/history-the-arts/the-ancient-olympics-bridging-past-and-present/content-section-7" class="mb-2 grid break-inside-avoid grid-cols-[auto_1fr] gap-2 text-sm leading-relaxed [counter-increment:item] before:font-semibold before:content-[counter(item)&#x27;.&#x27;]"><div class="relative -top-[3px] overflow-hidden break-words text-[16px] [&amp;_*]:mb-0"><span class="mb-4 block break-words text-[1em] leading-7"><a href="https://www.open.edu/openlearn/history-the-arts/the-ancient-olympics-bridging-past-and-present/content-section-7" target="_blank" rel="noopener noreferrer" class="break-all text-[1em] text-blue-500 hover:underline dark:text-blue-300">https://www.open.edu/openlearn/history-the-arts/the-ancient-olympics-bridging-past-and-present/content-section-7</a></span></div></li><li id="https://www.ioa.org.gr/post/the-cultural-dimensions-of-the-olympic-games-in-antiquity" class="mb-2 grid break-inside-avoid grid-cols-[auto_1fr] gap-2 text-sm leading-relaxed [counter-increment:item] before:font-semibold before:content-[counter(item)&#x27;.&#x27;]"><div class="relative -top-[3px] overflow-hidden break-words text-[16px] [&amp;_*]:mb-0"><span class="mb-4 block break-words text-[1em] leading-7"><a href="https://www.ioa.org.gr/post/the-cultural-dimensions-of-the-olympic-games-in-antiquity" target="_blank" rel="noopener noreferrer" class="break-all text-[1em] text-blue-500 hover:underline dark:text-blue-300">https://www.ioa.org.gr/post/the-cultural-dimensions-of-the-olympic-games-in-antiquity</a></span></div></li><li id="https://www.un.org/en/olympictruce" class="mb-2 grid break-inside-avoid grid-cols-[auto_1fr] gap-2 text-sm leading-relaxed [counter-increment:item] before:font-semibold before:content-[counter(item)&#x27;.&#x27;]"><div class="relative -top-[3px] overflow-hidden break-words text-[16px] [&amp;_*]:mb-0"><span class="mb-4 block break-words text-[1em] leading-7"><a href="https://www.un.org/en/olympict