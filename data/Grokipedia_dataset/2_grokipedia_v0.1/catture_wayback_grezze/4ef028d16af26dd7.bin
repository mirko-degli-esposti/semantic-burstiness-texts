100 opacity-50">Japan and Non-Western Adoption</a></li><li style="padding-left:0.75rem" class="flex items-start gap-2"><div class="bg-foreground mt-[0.5rem] h-1 w-1 flex-shrink-0 transition-opacity opacity-0"></div><a href="#second-industrial-revolution" class="transition-opacity hover:opacity-100 opacity-50">Second Industrial Revolution</a></li><li style="padding-left:1.5rem" class="flex items-start gap-2"><div class="bg-foreground mt-[0.5rem] h-1 w-1 flex-shrink-0 transition-opacity opacity-0"></div><a href="#defining-features-and-timeline" class="transition-opacity hover:opacity-100 opacity-50">Defining Features and Timeline</a></li><li style="padding-left:1.5rem" class="flex items-start gap-2"><div class="bg-foreground mt-[0.5rem] h-1 w-1 flex-shrink-0 transition-opacity opacity-0"></div><a href="#major-technological-leaps" class="transition-opacity hover:opacity-100 opacity-50">Major Technological Leaps</a></li><li style="padding-left:1.5rem" class="flex items-start gap-2"><div class="bg-foreground mt-[0.5rem] h-1 w-1 flex-shrink-0 transition-opacity opacity-0"></div><a href="#economic-and-social-distinctions" class="transition-opacity hover:opacity-100 opacity-50">Economic and Social Distinctions</a></li><li style="padding-left:0.75rem" class="flex items-start gap-2"><div class="bg-foreground mt-[0.5rem] h-1 w-1 flex-shrink-0 transition-opacity opacity-0"></div><a href="#historiographical-debates" class="transition-opacity hover:opacity-100 opacity-50">Historiographical Debates</a></li><li style="padding-left:1.5rem" class="flex items-start gap-2"><div class="bg-foreground mt-[0.5rem] h-1 w-1 flex-shrink-0 transition-opacity opacity-0"></div><a href="#pessimist-interpretations-and-critiques" class="transition-opacity hover:opacity-100 opacity-50">Pessimist Interpretations and Critiques</a></li><li style="padding-left:1.5rem" class="flex items-start gap-2"><div class="bg-foreground mt-[0.5rem] h-1 w-1 flex-shrink-0 transition-opacity opacity-0"></div><a href="#