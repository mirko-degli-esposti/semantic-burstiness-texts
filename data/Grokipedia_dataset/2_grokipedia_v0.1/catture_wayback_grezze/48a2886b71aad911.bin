4.js\",\"7086\",\"static/chunks/7086-1f1c4891d766e04f.js\",\"600\",\"static/chunks/600-9a9fcafaaa6c1c4c.js\",\"5002\",\"static/chunks/5002-9735c25beda556ba.js\",\"5448\",\"static/chunks/5448-2a3cfd853d899c9a.js\",\"5855\",\"static/chunks/5855-ff80eae88c248549.js\",\"4393\",\"static/chunks/4393-8a68969d02bf05c7.js\",\"9214\",\"static/chunks/9214-a10614844a67ba31.js\",\"6049\",\"static/chunks/6049-cddc8492d6c32af0.js\",\"4341\",\"static/chunks/4341-6051b2037c635ccb.js\",\"6304\",\"static/chunks/app/page/%5Bslug%5D/page-6dd6885cfe513314.js\"],\"HydrationBoundary\"]\n"])</script><script nonce="Yzc3ODQ1MzItMTYyZC00ZTgxLTk1ODYtZDljZGJhZDU5OGFi">self.__next_f.push([1,"22:I[6367,[],\"IconMark\"]\n20:T220fe,"])</script><script nonce="Yzc3ODQ1MzItMTYyZC00ZTgxLTk1ODYtZDljZGJhZDU5OGFi">self.__next_f.push([1,"# Nelson Mandela\n\n![Nelson Mandela in 1994](./_assets_/Nelson_Mandela_1994.jpg)\nNelson Rolihlahla Mandela (18 July 1918 – 5 December 2013) was a South African anti-apartheid revolutionary, politician, and the first president elected by universal suffrage, serving from 1994 to 1999.[](https://www.nobelprize.org/prizes/peace/1993/mandela/biographical/)[](https://www.nelsonmandela.org/biography) A prominent leader in the African National Congress (ANC), Mandela initially pursued nonviolent resistance against the apartheid system's racial segregation and disenfranchisement but co-founded its paramilitary wing, Umkhonto we Sizwe (MK), in 1961 to conduct sabotage operations targeting government infrastructure after events like the Sharpeville massacre rendered peaceful protest ineffective.[](https://sahistory.org.za/article/umkhonto-wesizwe-mk) Convicted in the 1964 Rivonia Trial of sabotage and sentenced to life imprisonment, he spent 27 years incarcerated, primarily on Robben Island, where harsh labor and isolation defined his resistance.[](https://www.nobelprize.org/prizes/peace/1993/mandela/biographical/) Released in 1990 amid international pressure and internal unrest, Mandela guided the ANC in negotiations that dismantled apartheid, leading to multiracial elections in which the ANC secured victory; for these efforts, he shared the 1993 Nobel Peace Prize with F. W. de Klerk.[](https://www.nobelprize.org/prizes/peace/1993/mandela/speedread/)\n\nMandela's early activism in the 1940s and 1950s involved legal challenges, boycotts, and the Defiance Campaign against discriminatory laws, reflecting his training as a lawyer and roots in the Thembu royal family.[](https://www.nobelprize.org/prizes/peace/1993/mandela/biographical/) His shift to armed struggle via MK marked a pragmatic turn, influenced by alliances including with the South African Communist Party, of which archival evidence confirms he was a member of the Central Committee in the early 1960s, though he later emphasized African nationalism over ideology.[](https://www.ascleiden.nl/news/research-stephen-ellis-confirmed-nelson-mandela-was-member-south-african-communist-party) During his presidency, Mandela prioritized reconciliation through the Truth and Reconciliation Commission to address apartheid-era atrocities from all sides, while implementing policies aimed at economic redistribution and nation-building, though these faced criticism for insufficiently curbing post-apartheid inequality and violence.[](https://www.nelsonmandela.org/biography) His global icon status stems from embodying forgiveness after militancy, yet controversies persist over MK's civilian casualties in bombings and his post-presidency associations with authoritarian figures like Fidel Castro and Muammar Gaddafi, whom he defended as anti-imperialist allies.[](https://time.com/5338569/nelson-mandela-terror-list/)\n\nMandela's legacy encapsulates causal tensions between revolutionary violence and democratic transition: empirical data show apartheid's coercion provoked ANC escalation, but MK operations, under Mandela's initial oversight, caused deaths that fueled regime entrenchment before negotiations prevailed.[](https://sahistory.org.za/article/umkhonto-wesizwe-mk) Posthumously, while academia and media often portray him as an unalloyed moral exemplar—potentially downplaying armed phase due to ideological alignments—primary accounts reveal a calculated leader who subordinated ideology to liberation, retiring after one term to avert power consolidation risks observed in other African states.[](https://www.nelsonmandela.org/biography)\n\n## Early Life\n\n### Childhood and Family Background: 1918–1934\n\nRolihlahla Dalibhunga Mandela was born on July 18, 1918, in the village of Mvezo in the Eastern Cape region of South Africa, then part of the Transkei territory under colonial administration.[](https://www.nelsonmandela.org/biography)[](https://www.cnn.com/2012/12/11/africa/nelson-mandela-fast-facts) He belonged to the Madiba clan of the Thembu people, a subgroup of the Xhosa ethnic group known for their monarchical traditions and pastoral lifestyle.[](https://www.nelsonmandela.org/biography) His father, Nkosi Mphakanyiswa Gadla Mandela (also known as Gadla Henry Mphakanyiswa), served as a principal counsellor and local chief to the acting Thembu king, holding authority over customary law and disputes in the region after his appointment around 1915.[](https://www.nelsonmandela.org/biography)[](https://www.cnn.com/2012/12/11/africa/nelson-mandela-fast-facts) His mother, Nonqaphi Nosekeni (also referred to as Nosekeni Fanny), was the third of his father's four wives in a polygamous household that produced at least thirteen children, including Mandela as one of four sons.[](https://www.nelsonmandela.org/biography)[](https://www.cnn.com/2012/12/11/africa/nelson-mandela-fast-facts)\n\nMandela's early childhood unfolded in the rural village of Qunu, approximately 5 kilometers from Mvezo, where the family relocated after his birth amid local disputes involving his father.[](https://www.nelsonmandela.org/biography) From around age five, he participated in traditional pastoral duties as a herd-boy, tending to sheep, calves, and later cattle across the rolling hills, learning survival skills, Xhosa customs, and the value of communal responsibility in a landscape dotted with thatched huts and grazing lands.[](https://brandsouthafrica.com/94333/mandela-day-month/photos-mandela-remembers-qunu-his-childhood-village/)[](https://www.theguardian.com/world/2013/dec/06/qunu-nelson-mandela-home) No immediate family members had prior formal education, but Mandela attended a local Methodist mission primary school in Qunu, where his teacher, Miss Mdingane, bestowed the English name \"Nelson\" upon him in line with colonial-era practices encouraging Western names.[](https://www.nelsonmandela.org/biography)\n\nIn 1930, at age twelve, Mandela's father died, likely from untreated lung disease following a dispute with colonial authorities over cattle fines, leaving the family without direct support.[](https://www.nelsonmandela.org/biography) As a result, young Mandela and his mother were taken in by Jongintaba Dalindyebo, the regent and acting paramount chief of the Thembu at the Great Place in Mqhekezweni, who assumed guardianship responsibilities under customary law to preserve clan alliances and educate potential heirs.[](https://www.nelsonmandela.org/biography) This transition exposed him to royal court proceedings, elder deliberations on governance, and the tensions between traditional authority and encroaching colonial rule, shaping his initial understanding of leadership and justice before his formal secondary education began in 1934.[](https://www.nelsonmandela.org/biography)\n\n![Young Mandela](./_assets_/Young_Mandela.jpg)\n\n### Education at Clarkebury, Healdtown, and Fort Hare: 1934–1940\n\n![Young Mandela](./_assets_/Young_Mandela.jpg)\nIn 1934, following his traditional Xhosa initiation rite at age 16, Nelson Mandela was enrolled by Thembu regent Jongintaba Dalindyebo at Clarkebury Boarding Institute in Engcobo, Eastern Cape, a Methodist mission school.[](https://www.nelsonmandela.org/timeline-2)[](https://southafrica-info.com/history/nelson-mandela-timeline/) There, he completed his Junior Certificate examination, adapting to a structured environment that emphasized discipline and Western education alongside Christian teachings, though he initially struggled with unfamiliar aspects like wearing shoes.[](https://www.theheritageportal.co.za/article/mission-schoolboy-nelson-mandela-and-missionary-education)[](https://www.nelsonmandela.org/biography)\n\nMandela transferred in 1937 to Healdtown Wesleyan College in Fort Beaufort, another prominent Methodist secondary institution known for its rigorous academic standards and as one of the largest schools for black students south of the equator at the time, accommodating over a thousand pupils.[](https://www.nelsonmandela.org/biography)[](https://www.theheritageportal.co.za/article/upon-eagles-wings-healdtown-mission-institute-and-struggle-south-africas-freedom) He matriculated there in 1939, excelling in subjects such as English, history, and Xhosa, while participating in extracurricular activities that fostered leadership skills amid the school's emphasis on moral and intellectual development.[](https://www.nelsonmandela.org/timeline-2)[](https://artsandculture.google.com/story/a-virtual-exhibition-on-the-life-and-times-of-nelson-mandela-nelson-mandela-centre-of-memory/7wURCwoZmy8vJw?hl=en)\n\nIn 1939, Mandela enrolled at the University College of Fort Hare, the only residential institution in South Africa then offering degrees to black Africans, initially pursuing a Bachelor of Arts in humanities.[](https://www.ufh.ac.za/about-us/history) He was elected to the Students' Representative Council but refused to serve, joining a boycott of a dinner protesting poor food quality and inadequate student representation, which led to his expulsion in 1940 after declining the administration's ultimatum to accept the position or withdraw.[](https://sahistory.org.za/article/nelson-mandela-timeline-1940-1949)[](https://www.mandela.ac.za/About-us/Nelson-Mandela-The-Man/Biography) This episode marked his early resistance to authority, prompting his move to Johannesburg later that year.[](https://sahistory.org.za/article/nelson-mandela-timeline-1940-1949)\n\n### Move to Johannesburg and Initial Employment: 1941–1943\n\n![Young Nelson Mandela](./_assets_/Young_Mandela.jpg)\nIn 1941, Nelson Mandela and his cousin Justice fled the Transkei to avoid arranged marriages orchestrated by their guardian, Jongintaba Dalindyebo, the acting regent of the Thembu people, and arrived in Johannesburg.[](https://www.nelsonmandela.org/biography) [](https://sahistory.org.za/article/nelson-mandela-timeline-1940-1949) Upon arrival, Mandela secured employment as a night watchman at the Crown Mines compound, a gold mining operation on Johannesburg's Central Rand, marking his initial exposure to industrial labor conditions.[](https://www.jda.org.za/mandelas-joburg/)  However, this position lasted only a few days; Dalindyebo contacted mine authorities, demanding Mandela's dismissal and return, leading to his firing as he was not authorized to work there without permission.[](https://sahistory.org.za/article/nelson-mandela-timeline-1940-1949) \n\nFollowing his dismissal, Mandela connected with Walter Sisulu, a real estate agent and early political associate, who facilitated an introduction to Lazar Sidelsky, a partner at the Jewish-owned law firm Witkin, Edelman and Sidelsky.[](https://www.nelsonmandela.org/biography) [](https://www.nelsonmandela.org/learners-biography) This led to Mandela's employment as an articled clerk at the firm starting in 1941, where he performed clerical duties such as filing and typing while gaining exposure to legal practice in a racially segregated environment.[](https://www.nelsonmandela.org/learners-biography) [](https://www.jda.org.za/mandelas-joburg/) The role, unusual for a black man at the time due to apartheid restrictions, allowed Mandela to reside in Johannesburg and pursue further education; he enrolled for a Bachelor of Arts degree by correspondence through the University of South Africa during this period.[](https://www.nelsonmandela.org/biography)\n\nBy late 1941, the ailing Dalindyebo visited Mandela in Johannesburg but, rather than enforcing a return, relented after discussions, permitting him to remain and continue his clerical work and studies through 1943.[](https://sahistory.org.za/article/nelson-mandela-timeline-1940-1949) This phase solidified Mandela's transition from rural Thembu life to urban professional aspirations, amid the harsh realities of economic disparity and racial barriers in Johannesburg's mining and legal sectors.\n\n## Entry into Politics\n\n### Legal Studies and Founding of ANC Youth League: 1943–1949\n\n![Young Nelson Mandela](./_assets_/Young_Mandela.jpg)\nIn 1943, Nelson Mandela enrolled as a part-time student for a Bachelor of Laws (LLB) degree at the University of the Witwatersrand in Johannesburg, where he was exposed to students of various races and political ideologies, including liberal and radical views.[](https://sahistory.org.za/article/nelson-mandela-timeline-1940-1949) He had already begun his legal articles in late 1941 or early 1942 with the firm Witkin, Sidelsky and Eidelman, arranged through Walter Sisulu's introduction to senior partner Lazar Sidelsky, a progressive Jewish attorney who employed black clerks despite racial barriers.[](http://www.mandela.gov.za/chronology/) [](https://www.sanews.gov.za/features-south-africa/biography-nelson-mandela) Mandela continued his clerkship while studying, handling tasks such as legal research and court preparations amid the firm's workload, which provided practical experience but highlighted the discriminatory practices limiting black lawyers' opportunities.[](https://www.lawyer.co.za/Mandela.html)\n\nMandela struggled academically at Witwatersrand, facing financial hardships, part-time work demands, and racial isolation, leading him to fail the final LLB examinations three times between 1947 and 1949.[](https://www.wits.ac.za/curiosity/stories/the-46-year-long-wits-llb-that-never-was.html) He ultimately left the university without completing the degree in 1949, later obtaining his LLB through the University of South Africa in 1989 while imprisoned.[](https://www.wits.ac.za/curiosity/stories/the-46-year-long-wits-llb-that-never-was.html) During this period, Mandela qualified to practice law via a two-year diploma supplementing his earlier BA, though full admission to the bar remained restricted by apartheid regulations.[](https://www.nelsonmandela.org/biography)\n\nParallel to his legal pursuits, Mandela co-founded the African National Congress Youth League (ANCYL) on April 2, 1944, in Soweto, alongside Anton Lembede, Ashby Mda, Walter Sisulu, and others, marking his formal entry into the ANC.[](https://ancylekurhuleni.org/our-history/) The ANCYL's inception stemmed from discussions in 1943 at Sisulu's home, aiming to invigorate the ANC with a more assertive African nationalist stance against white minority rule, rejecting reliance on white allies and advocating self-reliance and mass mobilization.[](https://www.nelsonmandela.org/biography) Mandela served as a branch secretary and contributed to the league's 1944 manifesto, which emphasized Africanism and criticized the ANC's older, accommodationist leadership.[](https://ancylekurhuleni.org/our-history/) By 1947, he had risen to ANCYL presidency following Lembede's death, steering it toward campaigns like boycotts of discriminatory facilities, though internal tensions arose over ideological shifts toward alliances with communists, which some founders opposed.[](https://www.nelsonmandela.org/biography)\n\n### Defiance Campaign and Leadership Rise: 1950–1954\n\nIn response to the National Party's consolidation of apartheid policies, including the Population Registration Act of 1950, which mandated racial classification for all South Africans, and the Group Areas Act of the same year, which enforced residential segregation by race, the African National Congress (ANC) intensified its opposition.[](https://sahistory.org.za/article/group-areas-act-1950) The ANC's Programme of Action, adopted on December 17, 1949, and influenced by the militant stance of the ANC Youth League (ANCYL)—where Nelson Mandela served as national president—called for boycotts, strikes, and non-violent direct action against discriminatory laws.[](https://sahistory.org.za/dated-event/anc-adopts-programme-action)[](https://www.nelsonmandela.org/biography) Mandela, as ANCYL leader, advocated for this shift from petitions to mass mobilization, arguing that passive resistance could overwhelm the government's enforcement capacity.[](https://www.nelsonmandela.org/biography)\n\nPlanning for the Defiance Campaign began in 1951 through collaboration between the ANC and the South African Indian Congress, drawing inspiration from Gandhian satyagraha while adapting it to local conditions of widespread legal injustice. Mandela played a key role in these discussions as a member of the ANC's National Action Committee, helping select target laws such as pass regulations, the vagrancy act, and train segregation rules for deliberate violation to provoke arrests and expose the system's moral bankruptcy.[](https://www.anc1912.org.za/defiance-campaign-1952-the-story-of-defiance/) The campaign aimed to recruit 50,000 volunteers to court imprisonment, thereby straining prison resources and generating international sympathy.\n\nThe Defiance Campaign officially launched on June 26, 1952—Freedom Day—with Mandela appointed as national volunteer-in-chief, responsible for coordinating defiance across provinces.[](https://www.anc1912.org.za/defiance-campaign-1952-the-defiance-campaign-in-south-africa-recalled/) He led the first batch of defiers in Johannesburg, entering a \"whites-only\" area without passes, resulting in his arrest alongside figures like Walter Sisulu and Yusuf Dadoo.[](https://sahistory.org.za/article/defiance-campaign-1952) Over the following months, volunteers systematically breached curfews, used segregated facilities unlawfully, and refused compliance with petty apartheid edicts, leading to more than 8,000 arrests by December 1952, primarily in the Eastern Cape and Transvaal.[](https://sahistory.org.za/article/defiance-campaign-1952) Mandela traveled extensively to recruit and train participants, emphasizing disciplined non-violence despite police violence, which included beatings and shootings that killed at least one volunteer.\n\nThe campaign's success in mobilizing mass participation—ANC membership surged from approximately 20,000 to over 100,000—propelled Mandela's leadership ascent. In 1952, he was elected president of the Transvaal ANC, succeeding the banned J.B. Marks, and simultaneously became one of the ANC's four deputy national presidents under Chief Albert Luthuli, recognizing his organizational prowess and ability to inspire crowds.[](https://sahistory.org.za/people/nelson-rolihlahla-mandela) By 1954, as deputy president, Mandela continued advocating for sustained defiance amid government reprisals, including bans on ANC leaders, solidifying his transition from youth agitator to senior strategist, though internal debates over non-violence persisted.[](https://sahistory.org.za/people/nelson-rolihlahla-mandela) The government's partial concessions, such as easing some pass enforcement to avoid jail overcrowding, underscored the campaign's tactical pressure but also highlighted apartheid's resilience, prompting Mandela to question the limits of purely non-violent methods.[](https://sahistory.org.za/article/defiance-campaign-1952)\n\n### Congress of the People, Treason Trial, and Non-Violent Resistance: 1955–1961\n\n![Young Mandela](./_assets_/Young_Mandela.jpg)  \nThe Congress of the People, convened by the Congress Alliance—a coalition comprising the African National Congress (ANC), South African Indian Congress, South African Coloured People's Congress, Congress of Democrats, and South African Congress of Trade Unions—took place on 25 and 26 June 1955 in Kliptown, near Johannesburg.[](https://sahistory.org.za/article/congress-people-and-freedom-charter) Approximately 3,000 delegates representing workers, peasants, intellectuals, women, youth, and students from all racial groups attended to articulate demands for political, social, and economic reform.[](https://sahistory.org.za/article/congress-people-and-freedom-charter) On 26 June, participants adopted the Freedom Charter, a document proclaiming \"South Africa belongs to all who live in it, united in our diversity,\" and calling for universal suffrage, land reform, nationalization of mines and banks, and abolition of restrictive laws.[](https://blackpast.org/global-african-history/african-national-congress-freedom-charter/) Nelson Mandela, then serving as a prominent ANC leader and subject to a banning order restricting attendance at public gatherings, supported the event's preparatory efforts but observed proceedings discreetly due to legal constraints.[](https://www.aamarchives.org/archive/history/1960s/mda02-free-nelson-mandela/download.html)\n\nIn retaliation against the Congress and the Charter's perceived threat to the apartheid state, South African police arrested 156 activists, including Mandela, in coordinated raids beginning on 5 December 1956, charging them with high treason for allegedly conspiring to overthrow the government via violent revolution and establish a communist regime.[](https://sahistory.org.za/article/treason-trial-1956-1961) The case, initiated in Johannesburg Magistrates' Court and later moved to Pretoria's Supreme Court, spanned over four years, marking the longest treason trial in South African history.[](https://sahistory.org.za/article/treason-trial-1956-1961) Prosecutors presented the Freedom Charter as evidence of subversive intent, while the defense maintained that ANC activities sought constitutional change through non-violent means.[](https://sahistory.org.za/article/treason-trial-1956-1961) Charges were progressively dropped: 73 accused were discharged before the prosecution rested, and further reductions left 30 defendants, including Mandela, by mid-1958; 61 others faced separate proceedings that were ultimately dismissed.[](https://sahistory.org.za/article/treason-trial-1956-1961)\n\nMandela actively participated in the defense, testifying on the ANC's organizational structure and commitment to peaceful protest, arguing that the group's actions, such as the earlier Defiance Campaign, aimed at civil disobedience rather than armed insurrection.[](https://omalley.nelsonmandela.org/index.php/site/q/03lv01538/04lv01600/05lv01615/06lv01616.htm) The trial intersected with escalating tensions, including the Sharpeville massacre on 21 March 1960, where police fired on 5,000 unarmed protesters against pass laws, killing 69 and wounding over 180, which prompted a national state of emergency on 30 March and the banning of the ANC and Pan Africanist Congress on 8 April.[](https://www.nelsonmandela.org/trials-and-prison-chronology) Despite the bans, the proceedings continued under heavy security at Fort Prison in Johannesburg, with defendants organizing internal resistance efforts.[](https://sahistory.org.za/article/treason-trial-1956-1961)\n\nThroughout 1955–1961, the ANC under leaders like Mandela adhered to a policy of non-violent resistance, employing boycotts, strikes, and mass demonstrations to challenge apartheid laws, viewing such tactics as a strategic means to expose regime injustices and garner international sympathy without resorting to force.[](https://www.pbs.org/wgbh/pages/frontline/shows/mandela/etc/cron.html) Mandela described non-violence not as an absolute moral imperative but as a pragmatic approach, effective only insofar as it pressured authorities without provoking unchecked retaliation; however, repeated state violence, as at Sharpeville, eroded confidence in its sustainability.[](https://www.facinghistory.org/resource-library/mandela-trial) On 29 March 1961, the court acquitted all remaining accused, ruling that the prosecution failed to demonstrate intent to use violence or that the ANC promoted communism, though this vindication occurred amid intensified government crackdowns that foreshadowed the organization's pivot to armed actions later that year.[](https://sahistory.org.za/article/treason-trial-1956-1961)[](https://www.nelsonmandela.org/trials-and-prison-chronology)\n\n## Shift to Armed Struggle\n\n### Formation of Umkhonto weSizwe (MK) and Sabotage Campaigns: 1961–1962\n\n![Liliesleaf Farm safe house](./_assets_/Liliesleaf_hut1.jpg)\n\nFollowing the Sharpeville Massacre on March 21, 1960, where police killed 69 unarmed protesters, and the subsequent banning of the African National Congress (ANC) and Pan Africanist Congress in April 1960, ANC leaders concluded that non-violent resistance had failed to compel government reform.[](https://sahistory.org.za/article/umkhonto-wesizwe-mk)[](https://sahistory.org.za/article/armed-struggle-and-state-repression-1960s) This shift was driven by escalating state repression, including mass arrests and the state of emergency, which convinced key figures, including Nelson Mandela, that armed action was necessary to sustain the liberation struggle.[](https://sahistory.org.za/article/umkhonto-wesizwe-mk)\n\nIn mid-1961, Mandela, operating underground after evading arrest, organized the All-African National Action Council to coordinate stay-at-home strikes in May and June 1961, but these were suppressed by police violence.[](https://omalley.nelsonmandela.org/index.php/site/q/03lv02167/04lv02264/05lv02303/06lv02304/07lv02305/08lv02311.htm) Recognizing the limits of passive resistance, Mandela, alongside ANC and South African Communist Party (SACP) members such as Joe Slovo and Walter Sisulu, established Umkhonto we Sizwe (MK), meaning \"Spear of the Nation,\" as the ANC's paramilitary wing in late 1961.[](https://www.tandfonline.com/doi/full/10.1080/03057070.2021.1974224) MK was formed jointly by ANC and SACP leaders to conduct sabotage against economic and infrastructural targets, explicitly avoiding civilian casualties to differentiate from terrorism and maintain moral legitimacy.[](https://www.un.org/en/events/mandeladay/court_statement_1964.shtml) Liliesleaf Farm in Rivonia, purchased by the ANC in 1961, served as a clandestine headquarters for MK planning and operations.[](https://www.sahra.org.za/liliesleaf-farm/)\n\nMK publicly launched on December 16, 1961—chosen to coincide with the Day of the Covenant—with the release of its manifesto, drafted primarily by Mandela, declaring war on white supremacy through targeted sabotage to disrupt the apartheid economy and force negotiations.[](https://omalley.nelsonmandela.org/index.php/site/q/03lv02424/04lv02730/05lv02918/06lv02950.htm)[](https://sahistory.org.za/article/umkhonto-wesizwe-mk) On the same day, MK units executed initial attacks, detonating explosives at unoccupied government buildings, power transmission lines, and administrative offices in Johannesburg, Port Elizabeth, and Durban, marking the start of the sabotage campaign without reported injuries.[](https://sahistory.org.za/article/umkhonto-wesizwe-mk) Mandela served as MK's initial commander-in-chief, directing operations from hiding and later traveling abroad in January 1962 for military training in Algeria and Ethiopia to prepare for potential escalation.[](https://www.un.org/en/events/mandeladay/court_statement_1964.shtml)[](http://samilitaryhistory.org/vol115rw.html)\n\nThroughout 1962, MK intensified its sabotage efforts, striking over 100 targets including railway lines, telephone exchanges, and industrial sites to impose economic costs on the regime while adhering to directives against loss of life.[](https://omalley.nelsonmandela.org/index.php/site/q/03lv02424/04lv02730/05lv02918/06lv02946.htm) These actions, coordinated by a multi-racial high command including whites and Indians, aimed to signal resolve and internationalize the anti-apartheid cause, though they provoked harsher security measures, culminating in Mandela's arrest on August 5, 1962.[](https://academic.oup.com/past/article/245/1/221/5580560)[](https://sahistory.org.za/article/umkhonto-wesizwe-mk) The campaign's restraint in targeting only property reflected a calculated strategy to retain domestic and global sympathy, contrasting with the government's framing of MK as a terrorist threat.[](https://www.un.org/en/events/mandeladay/court_statement_1964.shtml)\n\n### International Alliances and Ideological Commitments: 1961–1962\n\nIn early 1962, Nelson Mandela departed South Africa clandestinely on January 5, traveling via Botswana to Ethiopia to garner international support for the African National Congress (ANC) and its newly formed armed wing, Umkhonto we Sizwe (MK).[](https://www.nelsonmandela.org/news/entry/nelson-mandela-travels-through-africa) Granted an Ethiopian passport by Emperor Haile Selassie, he addressed the Pan-African Freedom Movement conference in Addis Ababa on January 29, outlining the ANC's shift to armed resistance against apartheid while emphasizing non-racial principles and seeking military training, financial aid, and diplomatic recognition from independent African states.[](https://blackpast.org/global-african-history/1962-nelson-mandela-address-conference-pan-african-freedom-movement-east-and-central-africa/) [](https://sahistory.org.za/article/nelson-mandela-timeline-1960-1969) His itinerary extended to Algeria, where he underwent three weeks of military instruction from June 1 to July 24, focusing on sabotage tactics suitable for MK's initial operations; he also visited Tunisia, Morocco, Sudan, Egypt, Libya, Mali, Guinea, Sierra Leone, Liberia, Ghana, and Nigeria, meeting government officials and liberation groups to secure pledges of assistance, including training facilities and arms supplies, amid widespread African solidarity post-Sharpeville.[](https://www.dailymaverick.co.za/article/2020-07-17-nelson-mandela-in-sudan-a-historic-1962-journey/) [](https://sahistory.org.za/article/nelson-mandela-timeline-1960-1969)\n\nMandela's alliances prioritized pan-African networks, with over a dozen newly sovereign states offering verbal commitments to host MK recruits for guerrilla training, though material support remained limited in 1962 due to their own nascent instabilities.[](https://international.mandela.ac.za/About-Us/African-Footprint) Ideologically, these efforts aligned the ANC with anti-colonial movements but revealed deepening ties to the South African Communist Party (SACP), which co-initiated MK on December 16, 1961, alongside ANC leaders; Mandela, appointed to MK's High Command, collaborated closely with SACP figures like Joe Slovo, integrating communist expertise in explosives and strategy while maintaining ANC oversight to prevent ideological dominance.[](https://sahistory.org.za/article/mandela-and-south-african-communist-party) [](https://sahistory.org.za/article/umkhonto-wesizwe-mk-timeline-1961-1990)\n\nThough Mandela rejected full SACP membership and Marxism-Leninism as the ANC's doctrine—viewing communism instrumentally as a tactical ally against apartheid shared by African nationalists—he acknowledged in later reflections that such partnerships bridged divides, with communists providing organizational discipline absent in broader African ranks.[](https://martinplaut.com/2015/02/25/mandela-and-the-communist-party/) This period's commitments thus blended pragmatic pan-Africanism with selective ideological convergence, prioritizing liberation over doctrinal purity, as evidenced by MK's manifesto eschewing Soviet-style revolution for targeted sabotage to coerce government reform.[](https://omalley.nelsonmandela.org/index.php/site/q/03lv02424/04lv02730/05lv02918/06lv02950.htm) Mandela returned to South Africa on July 24, 1962, to direct MK's escalation, only to face arrest weeks later.[](https://sahistory.org.za/article/nelson-mandela-timeline-1960-1969)\n\n## Imprisonment and Resistance\n\n### Arrest, Rivonia Trial, and Life Sentence: 1962–1964\n\n![Liliesleaf Farm during the raid](./_assets_/Liliesleaf_hut1.jpg)\n\nOn 5 August 1962, Nelson Mandela was arrested near Howick in Natal Province after police received a tip-off regarding his disguise as a chauffeur accompanying white businessman Cecil Williams; he faced charges of incitement to strike and leaving South Africa without an exit permit.[](https://www.famous-trials.com/nelsonmandela) In November 1962, following a trial in Johannesburg, Mandela was convicted on both counts and sentenced to five years' imprisonment, initially serving time at Pretoria Central Prison before transfer to Robben Island in May 1963.[](https://www.nelsonmandela.org/trials-and-prison-chronology)\n\nWhile Mandela was incarcerated, South African police raided Liliesleaf Farm in Rivonia on 11 July 1963, acting on informant intelligence; the site served as the clandestine headquarters for Umkhonto we Sizwe (MK), the ANC's armed wing, where documents detailing sabotage operations and plans for guerrilla warfare under \"Operation Mayibuye\" were seized.[](https://sahistory.org.za/article/rivonia-trial-1963-1964) [](https://www.theheritageportal.co.za/article/one-day-back-63-liliesleaf) The raid resulted in the arrest of several high-ranking ANC and MK leaders, including Walter Sisulu, Govan Mbeki, Ahmed Kathrada, and others, who were held alongside Mandela for the subsequent trial.[](https://sahistory.org.za/article/rivonia-trial-1963-1964)\n\nThe Rivonia Trial commenced on 9 October 1963 in the Transvaal Provincial Division of the Supreme Court in Pretoria, with Mandela and ten co-defendants indicted under the Sabotage Act for over 190 acts of sabotage, recruiting for guerrilla war, and conspiring to overthrow the government through violence; the prosecution presented evidence from seized documents linking the accused to MK's campaign of targeting infrastructure to disrupt the economy without initially harming civilians.[](https://www.famous-trials.com/nelsonmandela) [](https://sahistory.org.za/article/rivonia-trial-1963-1964) The defense, led by lawyers including Bram Fischer, acknowledged the political aims of armed resistance as a response to apartheid repression but contested the extent of personal involvement in specific acts; on 20 April 1964, Mandela delivered his famous \"I Am Prepared to Die\" speech from the dock, justifying the turn to arms after non-violent efforts failed post-Sharpeville Massacre and ANC banning.[](https://www.un.org/en/events/mandeladay/court_statement_1964.shtml)\n\nAfter deliberations, on 12 June 1964, Judge Quartus de Wet convicted Mandela, Sisulu, Mbeki, Elias Motsoaledi, Andrew Mlangeni, Raymond Mhlaba, Ahmed Kathrada, and Denis Goldberg on all counts, sentencing them to life imprisonment; the judge noted the gravity of the revolutionary plans but spared the death penalty, citing lack of intention to massacre civilians.[](https://www.nelsonmandela.org/news/entry/nelson-mandela-sentenced-to-life-imprisonment-44-years-ago) [](https://sahistory.org.za/article/rivonia-trial-1963-1964) The eight were transported to Robben Island to begin their sentences, marking a severe blow to ANC leadership amid escalating state crackdowns.[](https://www.famous-trials.com/nelsonmandela)\n\n### Robben Island Confinement and Internal ANC Dynamics: 1964–1982\n\n![Robben Island quarry](./_assets_/RobbenIslandSteinbruchA.JPG)\n\nFollowing the Rivonia Trial verdict on 12 June 1964, Nelson Mandela, along with Walter Sisulu, Ahmed Kathrada, Govan Mbeki, Raymond Mhlaba, Elias Motsoaledi, Andrew Mlangeni, and Denis Goldberg, was transferred to Robben Island's maximum-security section, where Mandela was assigned prisoner number 466/64.[](https://www.nelsonmandela.org/trials-and-prison-chronology) The group arrived during South Africa's coldest winter in 30 years, enduring initial isolation and harsh environmental conditions in a facility designed to suppress political dissent through isolation and manual labor.[](https://www.apartheidmuseum.org/uploads/files/PRISONER-theme4.pdf)\n\nPrisoners classified as political offenders, including Mandela's cohort, faced daily hard labor from dawn until late afternoon, primarily in the island's lime quarry, where they broke rocks into gravel under strict no-talking rules, leading to physical strain and long-term health issues such as Mandela's damaged eyesight from lime dust exposure. Diets were racially differentiated, with Black prisoners receiving inferior portions compared to Colored or Indian inmates, exacerbating nutritional deficiencies amid limited medical care.[](https://www.marxists.org/archive/alexander/rip-dossier.pdf) Mandela later described the labor as back-breaking but purposeful, as it allowed covert discussions among ANC members during work.[](https://artsandculture.google.com/story/in-his-own-words-nelson-mandela-s-prison-years-nelson-mandela-centre-of-memory/IwWB0EVYSJpvJg?hl=en-US)\n\nDespite restrictions, Mandela pursued legal studies through University of London correspondence courses starting in 1964, though privileges were intermittently revoked—such as a four-year ban after warders discovered study notes in 1969—delaying progress on his LLB, which he ultimately completed in 1989 from prison.[](https://brandsouthafrica.com/102976/mandela-day-month/robbenisland-university/) Robben Island evolved into an informal \"university,\" where senior ANC prisoners like Mandela organized classes in history, politics, and languages for younger inmates, fostering intellectual resistance and cadre training under clandestine structures mimicking ANC branches.[](https://www.nelsonmandela.org/trials-and-prison-chronology)\n\nWithin the ANC, Robben Island served as a microcosm of internal dynamics, with Mandela asserting leadership over a unified yet ideologically diverse group, including communists like Govan Mbeki, through structured debates on strategy, non-racialism, and the armed struggle's continuation.[](https://www.bbc.com/news/magazine-25256818) Tensions arose from factional pulls between African nationalists aligned with Mandela and more doctrinaire communists, but Mandela enforced discipline and consensus, preventing fragmentation and maintaining alignment with the exiled leadership via smuggled messages through lawyers and visitors—limited to one every six months initially.[](https://www.nelsonmandela.org/trials-and-prison-chronology) [](https://oxfordre.com/africanhistory/display/10.1093/acrefore/9780190277734.001.0001/acrefore-9780190277734-e-686) This prison-based command structure bolstered morale and ideological cohesion, contrasting with delayed external communications that sometimes highlighted divergences between island and exile ANC elements.[](https://www.nelsonmandela.org/news/entry/the-mandela-i-knew-prof-saths-cooper)\n\nOver the years, minor concessions emerged, such as permission for a small garden plot in the late 1970s, symbolizing incremental resistance, but core restrictions persisted until Mandela's transfer to Pollsmoor Prison on 31 March 1982, alongside Sisulu, Mhlaba, and Mlangeni, ostensibly for security reasons amid growing international pressure.[](https://www.nelsonmandela.org/trials-and-prison-chronology) During this period, the island's ANC prisoners solidified Mandela's symbolic authority, using organized sports, cultural activities, and mutual support to counter regime attempts at dehumanization.[](https://www.pbs.org/wgbh/pages/frontline/shows/mandela/prison/alexander.html)\n\n![Robben Island prison section B](./_assets_/Robben_Island_f%C3%A6ngslet_Sektion_B.jpg)\n\n### Transfers to Pollsmoor and Victor Verster Prisons: 1982–1990\n\nOn 31 March 1982, Nelson Mandela was transferred from Robben Island to Pollsmoor Prison in Cape Town, along with fellow prisoners Walter Sisulu, Raymond Mhlaba, and Andrew Mlangeni; Ahmed Kathrada joined them in October of that year.[](https://www.nelsonmandela.org/trials-and-prison-chronology)[](https://www.nelsonmandela.org/biography) Mandela was assigned prisoner number 220/82 at Pollsmoor, a maximum-security facility where conditions marked an improvement over Robben Island, including larger cells and reduced manual labor, though the prison remained overcrowded and damp.[](https://www.nelsonmandela.org/trials-and-prison-chronology)[](https://www.history.co.uk/article/nelson-mandela-the-prison-years)\n\nAt Pollsmoor, Mandela continued legal studies and maintained correspondence with ANC leadership, while the group of senior prisoners operated as a collective, discussing political strategy despite isolation from broader inmate populations.[](https://artsandculture.google.com/story/in-his-own-words-nelson-mandela-s-prison-years-nelson-mandela-centre-of-memory/IwWB0EVYSJpvJg?hl=en-US) The damp environment contributed to respiratory issues, exacerbating Mandela's longstanding eye damage from quarry work on Robben Island.[](https://www.bbc.com/culture/article/20240207-in-history-nelson-mandela-walks-out-of-prison-a-free-man) In December 1985, Mandela underwent surgery for an enlarged prostate gland causing urinary blockage, performed at Volks Hospital in Cape Town under heavy security.[](https://international.astroawani.com/global-news/mandelas-health-scares-over-years-17135)\n\nBy mid-1988, health deterioration intensified; on 12 August, Mandela was admitted to Tygerberg Hospital with a pleural effusion—a fluid buildup around the left lung—later diagnosed as tuberculosis, linked to Pollsmoor's humid conditions.[](https://www.npr.org/sections/parallels/2013/07/01/197674511/nelson-mandelas-prison-adventures)[](https://www.nytimes.com/1988/08/17/world/mandela-hospitalized-with-tuberculosis-lawyer-says.html) He received treatment at Tygerberg and then Constantiaberg Mediclinic, a whites-only facility at the time, for several months, during which he was guarded around the clock.[](https://www.nelsonmandela.org/trials-and-prison-chronology)\n\nFollowing recovery, Mandela was transferred in December 1988 to Victor Verster Prison (now Drakenstein Correctional Centre) near Paarl, approximately 60 km east of Cape Town, to accommodate his medical needs with milder climate and facilities.[](https://artsandculture.google.com/story/in-his-own-words-nelson-mandela-s-prison-years-nelson-mandela-centre-of-memory/IwWB0EVYSJpvJg?hl=en-US)[](https://www.npr.org/sections/parallels/2013/07/01/197674511/nelson-mandelas-prison-adventures) Conditions at Victor Verster were significantly less restrictive: Mandela resided in a private cottage with a study, kitchen, and garden, permitted daily exercise, reading materials, and family visits, though under constant surveillance and without freedom of movement.[](https://solitarywatch.org/2013/12/07/mandela-solitary/)[](https://www.facebook.com/ICRC/posts/nelson-mandela-spent-27-years-in-prison-and-during-that-time-we-visited-him-regu/1204911435009304/) This setup allowed limited personal autonomy, such as tending a vegetable garden, while serving as a de facto house arrest until early 1990.[](https://www.npr.org/sections/parallels/2013/07/01/197674511/nelson-mandelas-prison-adventures)\n\n### Secret Negotiations and Release: 1988–1990\n\nIn December 1988, following treatment for tuberculosis, Nelson Mandela was transferred from Pollsmoor Prison to Victor Verster Prison near Paarl, where he was housed in a private warder's residence under relatively lenient conditions, including the use of a study and kitchen, to ease potential transition to freedom.[](https://www.nelsonmandela.org/trials-and-prison-chronology)[](https://artsandculture.google.com/story/a-unique-bond-nelson-mandela-and-his-last-warder-nelson-mandela-centre-of-memory/7wWRwcfzXslfIg?hl=en-US) This move followed ongoing secret discussions initiated earlier, with weekly then irregular meetings between Mandela and a government working group led by Justice Minister Kobie Coetsee and National Intelligence Service head Niel Barnard, focusing on prerequisites for negotiations such as the African National Congress (ANC) renouncing armed struggle, which Mandela viewed as a defensive response to apartheid violence.[](https://fwdeklerk.org/meetings-between-nelson-mandela-and-the-pw-botha-government/)\n\nOn 5 July 1989, Mandela held a brief, secret meeting with President P. W. Botha at Tuynhuys in Cape Town, arranged amid economic pressures from sanctions and internal unrest signaling apartheid's weakening viability; Botha, despite his role in repressive policies, treated Mandela courteously, marking an initial step toward formal dialogue between adversaries.[](https://sahistory.org.za/dated-event/nelson-mandela-meets-president-pw-botha-begin-negotiating-end-apartheid) Following the encounter, on 12 July 1989, Mandela publicly stated that negotiations with the ANC were essential to halt violence and achieve peace.[](https://www.nelsonmandela.org/omalley/cis/omalley/OMalleyWeb/03lv01538/04lv01539/05lv01573/06lv01583.htm)\n\nBotha's deteriorating health led to his resignation in August 1989, with F. W. de Klerk assuming the presidency; on 13 December 1989, de Klerk met Mandela secretly in his Tuynhuys office under cover of darkness, discussing South Africa's political future amid persistent government demands for the ANC to abandon violence, though no immediate agreement was reached.[](https://fwdeklerk.org/fw-de-klerks-first-meeting-with-nelson-mandela/)[](https://www.nelsonmandela.org/omalley/cis/omalley/OMalleyWeb/03lv01538/04lv01539/05lv01573/06lv01583.htm)\n\nOn 2 February 1990, de Klerk announced in parliament the unbanning of the ANC, South African Communist Party, and Pan Africanist Congress, along with the imminent release of Mandela, bypassing prior conditional offers for his freedom that required personal renunciation of violence, which Mandela had rejected; Mandela was released unconditionally on 11 February 1990 from Victor Verster, emerging after 27 years of imprisonment to address crowds, emphasizing continued commitment to negotiation while upholding ANC principles.[](https://sahistory.org.za/dated-event/fw-de-klerk-announces-nelson-mandela-will-be-freed-11-february)[](https://www.history.com/this-day-in-history/february-11/nelson-mandela-released-from-prison)[](https://www.nelsonmandela.org/news/entry/nelson-mandelas-release-from-prison-33-years-on)\n\n## Dismantling Apartheid\n\n### Initial Talks and ANC Unbanning: 1990–1991\n\nOn February 2, 1990, President F. W. de Klerk addressed Parliament, announcing the unbanning of the African National Congress (ANC), the South African Communist Party (SACP), the Pan Africanist Congress (PAC), and other previously prohibited organizations, while committing to the release of Nelson Mandela and additional political prisoners.[](https://theconversation.com/fw-de-klerk-made-a-speech-31-years-ago-that-ended-apartheid-why-he-did-it-130803)[](https://omalley.nelsonmandela.org/index.php/site/q/03lv02039/04lv02103/05lv02104/06lv02105.htm) This decision followed secret preliminary contacts between Mandela, held at Victor Verster Prison, and government representatives, amid mounting internal unrest, economic pressures, and international isolation that had rendered apartheid unsustainable.[](https://fwdeklerk.org/constitutional-transformation-of-south-africa/) De Klerk's reforms aimed to initiate a negotiated transition to a new constitutional order granting equal rights, though implementation hinged on reciprocal commitments from unbanned groups to cease violence.[](https://omalley.nelsonmandela.org/index.php/site/q/03lv02039/04lv02103/05lv02104/06lv02105.htm)\n\nMandela was released unconditionally on February 11, 1990, after 27 years of imprisonment, emerging from Victor Verster Prison to address crowds in Cape Town, where he reaffirmed the ANC's commitment to dismantling apartheid through negotiation while cautioning against premature optimism amid ongoing hostilities.[](https://www.history.com/this-day-in-history/february-11/nelson-mandela-released-from-prison)[](https://www.bbc.com/culture/article/20240207-in-history-nelson-mandela-walks-out-of-prison-a-free-man) The release facilitated the return of ANC exiles and the resumption of open political activity, but it also intensified clashes between ANC supporters and rival groups like the Inkatha Freedom Party, complicating the path to dialogue.[](https://www.nelsonmandela.org/news/entry/nelson-mandelas-release-from-prison-33-years-on)\n\nInitial bilateral talks between the ANC and government commenced on May 2–4, 1990, at Groote Schuur in Cape Town, producing the Groote Schuur Minute, which outlined mutual pledges to end violence and intimidation, establish working groups on prisoner releases, exile returns, and the lifting of the state of emergency, and create a framework for substantive negotiations.[](https://omalley.nelsonmandela.org/index.php/site/q/03lv02039/04lv02103/05lv02104/06lv02106.htm)[](https://ourconstitution.wethepeoplesa.org/meeting-the-enemy-groote-schuur-may-1990/) These discussions addressed ANC demands for the removal of obstacles to free political activity, including the release of approximately 2,000 political prisoners and indemnities for exiles, while the government sought assurances against renewed sabotage by Umkhonto we Sizwe (MK), the ANC's armed wing.[](https://sahistory.org.za/dated-event/talks-between-government-and-anc-negotiations-proceed)\n\nProgress stalled over unresolved violence, prompting further meetings; on August 6, 1990, in Pretoria, the parties signed the Pretoria Minute, wherein the ANC suspended all armed actions with immediate effect, halting MK infiltrations and military preparations to advance peaceful settlement, in exchange for government commitments to accelerate prisoner releases, review security laws, and end the Natal state of emergency.[](https://www.upi.com/Archives/1990/08/06/South-Africa-ANC-agrees-to-suspend-armed-struggle/3983649915200/)[](https://fwdeklerk.org/the-pretoria-minute-6-august-1990/) Mandela emphasized that the suspension was tactical, contingent on negotiation breakthroughs, and not a permanent renunciation of force if talks failed.[](https://www.latimes.com/archives/la-xpm-1990-08-07-mn-150-story.html) Into 1991, working groups from these accords facilitated the return of over 10,000 exiles and phased prisoner amnesties, though sporadic violence persisted, undermining trust and delaying multilateral forums.[](https://omalley.nelsonmandela.org/index.php/site/q/03lv02039/04lv02103/05lv02104/06lv02107.htm) These preliminary accords laid groundwork for broader talks but highlighted tensions, as ANC-aligned groups faced accusations of ongoing intimidation, while government forces were implicated in covert operations against activists.[](https://www.hrw.org/reports/1992/southafrica/2.htm)\n\n### CODESA Negotiations and Constitutional Talks: 1991–1993\n\n![Frederik de Klerk with Nelson Mandela at Davos 1992](./_assets_/Frederik_de_Klerk_with_Nelson_Mandela_-_World_Economic_Forum_Annual_Meeting_Davos_1992.jpg)\n\nThe Convention for a Democratic South Africa (CODESA) commenced on December 20, 1991, at the World Trade Centre in Kempton Park, near Johannesburg, involving 19 political organizations, including the National Party government led by F.W. de Klerk, the African National Congress (ANC) headed by Nelson Mandela, the Inkatha Freedom Party, and other groups representing various racial and political interests.[](https://sahistory.org.za/article/convention-democratic-south-africa-codesa) The initial plenary session focused on establishing general constitutional principles, such as a united and democratic South Africa, but revealed deep divisions over the transition mechanism, with the ANC advocating for an elected constituent assembly to draft a new constitution, while the government insisted on entrenched minority protections and a 75% supermajority for constitutional changes.[](https://sahistory.org.za/article/convention-democratic-south-africa-codesa-codesa-1) Mandela, as ANC president, engaged in direct exchanges with de Klerk, highlighting unresolved issues like the government's demand for veto powers over security matters and the ANC's push for immediate abandonment of apartheid structures.[](https://sahistory.org.za/article/convention-democratic-south-africa-codesa-codesa-1)\n\nCODESA II convened in May 1992 amid escalating violence, including clashes between ANC supporters and Inkatha members, which both sides blamed on the other and alleged state complicity. Negotiations collapsed on June 17, 1992, following the Boipatong massacre, where 45 residents were killed in an attack by hostel dwellers, prompting the ANC to suspend talks and issue 14 demands, including a commission of inquiry into government infiltration of security forces and the release of political prisoners.[](https://fwdeklerk.org/the-south-african-constitutional-negotiations/) [](https://www.saha.org.za/news/2011/December/codesa_negotiations_began_in_december_1991_a_significant_transitional_step_towards_a_democratic_south_africa.htm) Mandela accused de Klerk's administration of failing to curb violence orchestrated by third forces within the state apparatus, while de Klerk rejected these claims, pointing to ANC-orchestrated mass action as destabilizing.[](https://www.saha.org.za/news/2011/December/codesa_negotiations_began_in_december_1991_a_significant_transitional_step_towards_a_democratic_south_africa.htm) The breakdown reflected fundamental disagreements: the ANC sought unqualified majority rule, viewing minority vetoes as perpetuating apartheid power structures, whereas the government prioritized federal elements and sunset clauses to safeguard white interests against potential expropriation or dominance by ANC's historically Marxist-aligned factions.[](https://fwdeklerk.org/the-south-african-constitutional-negotiations/)\n\nBilateral talks between ANC secretary-general Cyril Ramaphosa and government minister Roelf Meyer resumed in secret during September 1992, culminating in the Record of Understanding on September 26, 1992, where de Klerk agreed to incorporate international norms into the interim constitution, release remaining political prisoners, and investigate violence, in exchange for the ANC suspending its mass mobilization campaigns and lifting economic sanctions.[](https://omalley.nelsonmandela.org/index.php/site/q/03lv03445/04lv03446/05lv03459.htm) Mandela endorsed the agreement despite internal ANC resistance from radicals favoring armed struggle continuation, demonstrating his strategic prioritization of negotiation to achieve power transfer.[](https://digitalcommons.pepperdine.edu/cgi/viewcontent.cgi?article=1417\u0026context=globaltides) This paved the way for the Multi-Party Negotiation Process in April 1993 at the World Trade Centre, involving 26 parties, which established technical committees to draft an interim constitution based on 34 binding principles, including universal suffrage, separation of powers, and protections for fundamental rights.[](https://c-r.org/accord/public-participation/south-africas-multi-party-constitutional-negotiation-process)\n\nThe negotiations produced the Interim Constitution on November 18, 1993, certified by a multi-party forum and adopted by Parliament on December 22, 1993, which scheduled non-racial elections for April 27, 1994, under a Government of National Unity and created the Constitutional Court to review the final constitution against the 34 principles.[](https://sahistory.org.za/article/interim-south-african-constitution-1993) [](https://fwdeklerk.org/the-south-african-constitutional-negotiations/) Mandela's insistence on majority rule prevailed, rejecting entrenched group rights that de Klerk initially sought to embed, though compromises like provincial powers and a five-year transitional executive addressed minority concerns without granting vetoes.[](https://fwdeklerk.org/the-south-african-constitutional-negotiations/) Throughout, violence persisted, with over 14,000 deaths between 1990 and 1994 attributed to political conflicts, underscoring the high stakes and mutual distrust that Mandela navigated through pragmatic concessions, such as accepting an interim bill of rights limiting property expropriation.[](https://fwdeklerk.org/the-south-african-constitutional-negotiations/)\n\n### 1994 Elections and Inauguration as President\n\n![Mandela voting in 1994](./_assets_/Mandela_voting_in_1994.jpg)\n\nThe 1994 South African general elections occurred from April 26 to 29, constituting the nation's first universal suffrage vote following the end of apartheid restrictions.[](https://www.history.com/this-day-in-history/april-27/south-africa-holds-first-multiracial-elections) Over 19.7 million ballots were cast, yielding a voter turnout of approximately 86.9 percent amid long queues that sometimes extended over a kilometer.[](http://electionresources.org/za/provinces.php?election=1994) [](https://www.apartheidmuseum.org/exhibitions/1994-election) Nelson Mandela, as leader of the African National Congress (ANC), cast his vote on April 26 in Houghton, Johannesburg, symbolizing the transition to democratic participation.[](https://www.youtube.com/watch?v=cgvDk_FCPM4)\n\nThe ANC secured a decisive victory with 12,237,655 votes, or 62.65 percent of the national vote, translating to 252 seats in the 400-member National Assembly.[](http://electionresources.org/za/provinces.php?election=1994) The National Party, formerly the governing party under F.W. de Klerk, received 20.39 percent, while the Inkatha Freedom Party garnered 10.54 percent; these results enabled a Government of National Unity.[](http://electionresources.org/za/provinces.php?election=1994) Despite logistical challenges and sporadic violence—particularly in KwaZulu-Natal, where over 400 election-related deaths occurred—the Independent Electoral Commission certified the results as free and fair overall.[](https://www.iri.org/wp-content/uploads/2021/12/south_africas_1994_presidential_and_parliamentary_elections_1-1.pdf) On May 9, the newly elected National Assembly convened and selected Mandela as president by a vote reflecting ANC dominance, with de Klerk and Thabo Mbeki as deputies.[](https://blackpast.org/global-african-history/1994-nelson-mandela-s-inaugural-address-president-south-africa/)\n\nMandela's inauguration took place on May 10, 1994, at the Union Buildings amphitheatre in Pretoria, attended by dignitaries from more than 140 countries, including Queen Elizabeth II and over 4,000 guests.[](http://news.bbc.co.uk/onthisday/hi/dates/stories/may/10/newsid_2661000/2661503.stm) Sworn in at age 77 as South Africa's first black president, Mandela emphasized reconciliation in his address, stating, \"We dedicate this day to all the heroes and heroines in this country and the rest of the world who sacrificed in many ways... that we might remain a free nation.\"[](https://www.sanews.gov.za/south-africa/read-nelson-mandelas-inauguration-speech-president-sa) The ceremony featured a 21-gun salute, a flypast by the South African Air Force, and performances by military bands, marking the formal establishment of the post-apartheid democratic order under the interim constitution.[](https://sahistory.org.za/dated-event/nelson-mandela-inaugurated-south-africas-first-black-president) This event, broadcast globally, underscored the peaceful power transfer despite prior decades of conflict.[](https://honors.ku.edu/sites/honors/files/2023-01/08-whitcomb-macdonald.pdf)\n\n## Presidency of South Africa\n\n### National Reconciliation and Truth Commission\n\nUpon assuming the presidency on May 10, 1994, Mandela prioritized national reconciliation to avert potential civil war in a society scarred by decades of apartheid-era violence, emphasizing forgiveness over retribution to foster unity among racial groups.[](https://www.ebsco.com/research-starters/history/south-africa-establishes-truth-and-reconciliation-commission) His administration promoted interracial dialogue and symbolic gestures, such as visiting predominantly Afrikaner communities and endorsing cultural institutions historically associated with white South Africans.[](https://sahistory.org.za/article/nelson-mandela-presidency-1994-1999) A pivotal example occurred during the 1995 Rugby World Cup, hosted in South Africa from May 25 to June 24; Mandela publicly supported the Springboks national team—long viewed by many black South Africans as emblematic of apartheid exclusion—by wearing their green jersey and cap at the final match on June 24, 1995, in Johannesburg, where South Africa defeated New Zealand 15-12, and he presented the William Webb Ellis Cup to captain François Pienaar.[](https://www.history.com/articles/nelson-mandela-1995-rugby-world-cup-south-african-unity) This act, leveraging sports' unifying potential, was credited with bridging divides, though its long-term impact on racial integration in rugby remained limited, with the team retaining an overwhelmingly white composition for years afterward.[](https://www.history.com/articles/nelson-mandela-1995-rugby-world-cup-south-african-unity)\n\nTo systematically address apartheid's legacies, Mandela's government enacted the Promotion of National Unity and Reconciliation Act on July 19, 1995, which commenced on December 1, 1995, establishing the Truth and Reconciliation Commission (TRC) as a restorative justice mechanism.[](https://www.justice.gov.za/legislation/acts/1995-034.pdf) Chaired by Archbishop Desmond Tutu and comprising 17 commissioners, the TRC operated from 1996 to 2002, investigating gross human rights violations—including killings, torture, and abductions—committed between March 1, 1960 (the Sharpeville massacre) and May 10, 1994 (Mandela's inauguration).[](https://atjhub.csvr.org.za/south-africa-truth-and-reconciliation-commission-1996-2002/) Its mandate focused on uncovering truths to promote healing, granting conditional amnesty to perpetrators who fully confessed politically motivated acts, thereby trading disclosure for immunity from prosecution under the principle of neither blanket impunity nor vengeance.[](https://www.ebsco.com/research-starters/history/south-africa-establishes-truth-and-reconciliation-commission) Mandela actively endorsed the TRC, appointing its leadership and framing it as essential for national catharsis, though he distanced himself from day-to-day operations to maintain executive impartiality.[](https://www.nelsonmandela.org/news/entry/failing-south-africa-the-truth-commission-30-years-on)\n\nThe TRC held public hearings, receiving over 20,000 victim statements and processing around 7,112 amnesty applications, ultimately granting amnesty in approximately 850 cases while denying others for insufficient disclosure or non-political motives.[](https://www.cambridge.org/core/books/identities-affiliations-and-allegiances/amnesty-or-impunity-a-preliminary-critique-of-the-report-of-the-truth-and-reconciliation-commission-of-south-africa/33B476F7C314707D96082397D899A01A) It documented atrocities by state security forces, the African National Congress (ANC), and other groups like the Inkatha Freedom Party, revealing uncomfortable realities such as ANC guerrilla bombings causing civilian deaths and \"necklace\" executions of suspected collaborators.[](https://muse.jhu.edu/pub/1/article/178513/pdf) Mandela's reconciliation framework, including the TRC, succeeded in averting immediate ethnic reprisals, with no widespread post-apartheid purges, but faced criticism for prioritizing truth over punitive justice, effectively shielding many high-level perpetrators—particularly from the apartheid regime and ANC—from trials. Victims' families challenged amnesty decisions in courts, arguing violations of constitutional rights to justice, while some analysts noted the process inadvertently granted de facto group amnesties when collective confessions obscured individual accountability.[](https://muse.jhu.edu/pub/1/article/178513/pdf) Despite these flaws, the TRC's final report in 2003 underscored systemic state-sponsored violence under apartheid, informing reparations recommendations, though implementation lagged, with only partial payouts to verified victims by the early 2000s.[](https://www.cambridge.org/core/books/identities-affiliations-and-allegiances/amnesty-or-impunity-a-preliminary-critique-of-the-report-of-the-truth-and-reconciliation-commission-of-south-africa/33B476F7C314707D96082397D899A01A) Mandela maintained that such mechanisms, rooted in pragmatic avoidance of cycles of revenge, laid groundwork for democratic stability, even as persistent socioeconomic disparities later strained the reconciliation narrative.[](https://www.clingendael.org/publication/nelson-mandela-leadership-and-reconciliation)\n\n### Economic Policies and GEAR Framework\n\nUpon assuming the presidency in May 1994, Nelson Mandela's government initially pursued the Reconstruction and Development Programme (RDP), a policy framework emphasizing social spending on housing, water access, electrification, and land reform to address apartheid-era inequalities.[](https://sahistory.org.za/article/south-africas-key-economic-policies-changes-1994-2013) The RDP aimed at integrating economic growth with redistribution but faced fiscal constraints, including high public debt from the apartheid regime—equivalent to 25% of the annual budget—and inherited structural issues like low investor confidence.[](https://www.marxists.org/history/etol/newspape/atc/1800.html) By 1996, these pressures prompted a pivot to a more market-oriented macroeconomic strategy.\n\nIn June 1996, Finance Minister Trevor Manuel unveiled the Growth, Employment and Redistribution (GEAR) framework, which prioritized fiscal discipline, deficit reduction to 3% of GDP by 2000, trade liberalization, privatization of state assets, and export-led growth targeting 6% annual GDP expansion and 400,000 new jobs by 2000.[](https://www.treasury.gov.za/publications/other/gear/chapters.pdf)[](https://www.gov.za/blog/former-president-nelson-mandelas-economic-legacy-lives) GEAR sought to stabilize the economy by restoring international creditworthiness and attracting foreign investment, reflecting a pragmatic departure from the ANC's earlier socialist rhetoric toward neoliberal elements, including wage restraint and reduced public spending growth.[](https://journals.co.za/doi/pdf/10.10520/EJC-ae480ac06) Mandela endorsed GEAR as essential for sustainable development, publicly declaring it \"non-negotiable\" in 1996 despite opposition from ANC allies like the Congress of South African Trade Unions (COSATU), who criticized it for undermining redistribution and job creation in favor of investor appeasement.[](https://tpy.nelsonmandela.org/pages/part-vi-anc-and-the-transition/17-anc-and-the-transition/17-6-alliance-contestation-around-gear)[](https://www.anc1912.org.za/wp-content/uploads/2021/07/Umrabulo-Issue-2-2nd-Quarter-1997.pdf)\n\nEmpirical outcomes under GEAR during Mandela's tenure showed moderate stabilization but fell short of ambitious targets. Real GDP grew at an average of 3.2% annually from 1994 to 1999, roughly doubling the economy's size by 2013, while total employment rose by over 3.5 million jobs since 1994 through expansions in services and construction.[](https://www.bbc.com/news/business-23041513)[](https://www.gov.za/blog/former-president-nelson-mandelas-economic-legacy-lives) However, unemployment increased from around 20% in 1994 to over 30% by 1999, with annual job losses of 1-4% in the late 1990s amid slow manufacturing recovery and skills mismatches; inequality metrics, such as the Gini coefficient, remained among the world's highest at approximately 0.63, as growth disproportionately benefited skilled workers and capital owners rather than broad-based redistribution.[](https://monthlyreview.org/articles/south-africas-frustrating-decade-of-freedom-from-racial-to-class-apartheid/)[](https://ecommons.cornell.edu/server/api/core/bitstreams/ab640846-6c29-4087-b46e-c38cd1c41e32/content) Critics, including left-leaning economists, attributed persistent poverty—affecting over 50% of the population—to GEAR's emphasis on austerity over transformative spending, though proponents argued it averted fiscal collapse and laid groundwork for later expansions.[](https://www.tandfonline.com/doi/full/10.1080/0376835042000219541)[](https://jefjournal.org.za/index.php/jef/article/download/72/69) Mandela defended the approach as a necessary compromise to prevent capital flight, prioritizing political stability over ideological purity.[](https://www.bbc.com/news/business-23041513)\n\n### Domestic Challenges: Crime, Corruption, and Social Issues\n\nDuring Mandela's presidency, South Africa grappled with persistently high levels of violent crime, which showed minimal decline despite police reforms and community policing initiatives. The murder rate stood at approximately 67 per 100,000 population in 1994, decreasing slightly to 65 in 1995 and 61 in 1996, before stabilizing around 59 in 1998.[](https://data.worldbank.org/indicator/VC.IHR.PSRC.P5?locations=ZA)[](https://pure.ulster.ac.uk/files/11223466/Hamber_Fear_in_the_Land.pdf) These figures far exceeded global averages, with factors including socioeconomic disparities, firearm proliferation from apartheid-era stockpiles, and inadequate institutional capacity in the South African Police Service contributing to ongoing instability in townships and urban areas. Robbery and assault rates also remained elevated, straining the transition to a unified national policing framework.\n\nCorruption emerged as an early challenge within the African National Congress-led government, though major systemic scandals intensified post-1999. A prominent case was the 1995 Sarafina II controversy, where the Health Ministry under Minister Nkosazana Dlamini-Zuma allocated R14.27 million (about US$3.45 million) from donor funds—intended as a no-cost contribution from the U.S. Agency for International Development—for an AIDS-awareness musical production, bypassing standard tender procedures and involving alleged kickbacks to producer Mbongeni Ngema.[](https://www.nytimes.com/1996/10/08/world/south-africa-scandal-over-sarafina-spotlights-corruption-in-the-anc.html)[](https://pubmed.ncbi.nlm.nih.gov/8596329/) The Public Protector's investigation revealed procedural irregularities and misrepresentation to Parliament, leading to ministerial reprimands but no prosecutions, highlighting nascent issues of patronage and oversight weaknesses in the new administration. Mandela's government established anti-corruption units, such as the Special Investigating Unit in 1996, yet enforcement remained limited amid cadre deployment practices that prioritized political loyalty.[](https://www.gov.za/documents/other/investigation-concerning-sarafina-ii-donor-public-protector-report-11-sep-1996)\n\nSocial issues compounded these problems, with inequality worsening as measured by the Gini coefficient, which rose from 0.672 in 1993 to 0.685 by 1999, reflecting entrenched apartheid legacies and limited redistribution under the Reconstruction and Development Programme.[](https://journals.sagepub.com/doi/10.1007/s12114-017-9260-2) Unemployment climbed from about 20% in 1994 to 23.3% in 1999, driven by structural mismatches, skills gaps, and slow private-sector job creation amid economic liberalization.[](http://www.statssa.gov.za/publications/SALabourMarket/SALabourMarket.pdf) The HIV/AIDS epidemic accelerated unchecked, with adult prevalence surging from roughly 7.7% in 1994 to 22.4% by 2000, as government response prioritized other priorities like housing over aggressive prevention and treatment campaigns; Mandela personally addressed the issue sparingly during his term, later acknowledging the oversight.[](https://academic.oup.com/ije/article/31/1/37/655915) These factors perpetuated poverty affecting over 50% of the population and fueled social unrest, including service delivery protests, underscoring the limits of symbolic reconciliation without robust economic interventions.\n\n### Foreign Affairs and International Relations\n\n![President Bill Clinton with Nelson Mandela](./_assets_/President_Bill_Clinton_with_Nelson_Mandela.jpg)\nDuring his presidency from 1994 to 1999, Nelson Mandela's foreign policy emphasized the reintegration of South Africa into the global community after decades of isolation under apartheid, guided by principles including the promotion of human rights, democracy, respect for international law, and prioritization of African interests.[](https://ciaotest.cc.columbia.edu/olj/sa/sa_mar01ber01.html) This approach sought to leverage Mandela's international prestige for \"ethical\" diplomacy, focusing on multilateralism, conflict resolution, and economic partnerships while acknowledging South Africa's \"African destiny.\"[](https://theafrican.co.za/politics/2024-06-30-foreign-policy-driven-by-a-culture-of-human-rights/) The policy balanced liberal ideals with pragmatic engagement, including debt servicing inherited from the apartheid era, which consumed significant resources without substantial relief during his term.[](http://www.africafocus.org/docs98/debt9807.php)\n\nMandela prioritized continental stability, exemplified by South Africa's military intervention in Lesotho in September 1998, where approximately 700 South African troops, alongside Botswana forces under SADC auspices, entered to quell violent unrest following disputed elections and prevent a potential coup against Prime Minister Bethuel Pakalitha Mosisili's government.[](https://www.tandfonline.com/doi/abs/10.1080/10220461.2019.1585282) The operation, authorized by Mandela, restored order amid fierce resistance that resulted in dozens of deaths and damage to infrastructure, marking South Africa's first major post-apartheid foreign military action and drawing criticism for its forceful nature despite Mandela's image as a reconciler.[](https://www.latimes.com/archives/la-xpm-1998-sep-23-mn-25634-story.html) Similarly, his administration supported regional efforts in Burundi, pushing for international peacekeeping deployments in 1996–1997 to address ethnic violence, though full mediation occurred later.[](https://www.tandfonline.com/doi/full/10.1080/13533312.2025.2560898?src=exp-la)\n\nRelations with Western powers strengthened, as evidenced by Mandela's state visit to the United States on October 4, 1994, where he was hosted by President Bill Clinton at the White House, fostering economic and diplomatic ties amid discussions on trade and investment.[](https://www.presidency.ucsb.edu/documents/remarks-state-dinner-for-president-nelson-mandela-south-africa) A follow-up working visit in September 1998 further solidified U.S.-South Africa collaboration, though tensions arose over issues like pharmaceutical patents for HIV/AIDS treatment.[](https://history.state.gov/departmenthistory/visits/south-africa)\n\nMandela maintained ties with former anti-apartheid allies despite international pressure, notably during his October 22–23, 1997, state visit to Libya, where he met Muammar Gaddafi, embraced him publicly, and defended the trip against U.S. and UN sanctions related to the Lockerbie bombing, arguing that such measures were one-sided and that Libya had supported the ANC during its struggle.[](https://www.nytimes.com/1997/10/23/world/despite-un-ban-mandela-meets-qaddafi-in-libya.html) This reflected a policy of reciprocity over strict human rights consistency, prioritizing loyalty to regimes that aided liberation efforts.[](https://www.washingtonpost.com/archive/politics/1997/10/23/mandela-in-libya-against-us-wishes-says-foes-of-visit-are-without-morals/be28ca08-88cd-486d-802d-24eaa7fcb4b8/)\n\n### Withdrawal from Office: 1999\n\n![Nelson Mandela in 1998](./_assets_/Nelson_Mandela_1998.JPG)\n\nNelson Mandela, who had served as President of South Africa since May 10, 1994, announced on March 3, 1999, that the country's second democratic general elections would occur on June 2, 1999, and confirmed he would not seek re-election, having already completed one full term.[](http://archive.ipu.org/parline-e/reports/arc/2291_99.htm) This decision aligned with his earlier resignation as president of the African National Congress (ANC) on December 16, 1997, when he endorsed Deputy President Thabo Mbeki as his successor within the party.[](https://www.ebsco.com/research-starters/history/mandela-makes-way-mbeki) Mandela's choice to limit himself to a single term, despite constitutional allowance for two, underscored his commitment to democratic norms and peaceful transitions of power, setting a precedent against indefinite leadership.[](https://www.tpr.org/2013-12-08/nelson-mandela-and-the-virtue-of-compromise)\n\nIn the June 2, 1999, elections, the ANC secured a decisive victory with approximately 66% of the vote, enabling Mbeki to assume the presidency on June 16, 1999, following Mandela's formal handover.[](https://sahistory.org.za/article/south-african-general-elections-1999) During a farewell address to Parliament on March 26, 1999, Mandela reflected on achievements in reconciliation and economic stabilization while urging continued focus on poverty alleviation, education, and crime reduction, emphasizing institutional continuity over personal legacy.[](https://sahistory.org.za/archive/farewell-madiba-national-assembly-cape-town-march-261999) At a state banquet hosted by Mbeki on June 16, 1999, Mandela expressed gratitude for public support and reiterated his intent to retire from active politics, allowing the new administration to address ongoing challenges without his direct involvement.[](http://www.mandela.gov.za/mandela_speeches/1999/990616_farewell.htm)\n\nMandela's withdrawal was characterized by restraint and forward-looking optimism, avoiding entanglement in electoral campaigning to preserve the integrity of the democratic process he had helped establish.[](https://www.npr.org/2013/06/28/196691621/mandelas-graceful-departure-a-hallmark-of-his-presidency) By stepping aside at age 80, he prioritized generational renewal within the ANC and national governance, contributing to South Africa's image of stable post-apartheid leadership amid persistent socioeconomic disparities.[](https://sahistory.org.za/article/nelson-mandela-presidency-1994-1999) This move contrasted with historical African precedents of prolonged rule, reinforcing constitutional term limits as a bulwark against authoritarianism.[](https://www.tpr.org/2013-12-08/nelson-mandela-and-the-virtue-of-compromise)\n\n## Post-Presidency\n\n### Philanthropy, AIDS Advocacy, and Global Activism: 1999–2004\n\n![Nelson Mandela in 2000](./_assets_/Nelson_Mandela%252C_2000_\\(4\\))\nFollowing his retirement from the South African presidency on June 16, 1999, Nelson Mandela established the Nelson Mandela Foundation as a non-profit organization to serve as his post-presidential office, focusing on advancing reconciliation, dialogue, and advocacy for human rights, poverty reduction, and HIV/AIDS response.[](https://www.nelsonmandela.org/overview) The foundation preserved Mandela's archival materials, facilitated public engagement on societal issues, and supported initiatives aligned with his vision of equality and freedom.[](https://www.nelsonmandela.org/overview) Through this entity and the earlier-established Nelson Mandela Children's Fund, Mandela directed philanthropic efforts toward improving education, health, and welfare for vulnerable children in South Africa, providing grants for community-based projects.[](https://artsandculture.google.com/story/what-nelson-mandela-did-after-he-retired-as-president-nelson-mandela-centre-of-memory/8AVxTGGTamC3JA?hl=en)\n\nMandela's advocacy on HIV/AIDS gained prominence after leaving office, contrasting with the limited emphasis during his presidency amid South Africa's escalating epidemic.[](https://www.pbs.org/wgbh/frontline/article/nelson-mandelas-mixed-legacy-on-hivaids/) At the 13th International AIDS Conference in Durban on July 9, 2000, he called for intensified global and national action, acknowledging the disease's devastating impact and urging treatment access despite prevailing government skepticism under President Thabo Mbeki.[](https://www.theguardian.com/world/2013/dec/06/nelson-mandela-aids-south-africa) He promoted education on safe sex practices, increased research funding, and expanded antiretroviral therapy availability, positioning himself as a countervoice to official denialism that hindered public health responses.[](https://www.bbc.com/news/world-africa-10529266)\n\nIn November 2003, Mandela launched the 46664 campaign, named after his Robben Island prisoner identification number, as a global music-driven initiative to combat HIV/AIDS stigma and raise funds for prevention and treatment in Africa.[](https://brandsouthafrica.com/103076/mandela-day-month/46664-global-campaign-for-change/) The inaugural concert on November 29, 2003, in Cape Town featured international artists including Bono and members of Queen, drawing over 30,000 attendees and broadcast worldwide to amplify awareness of the pandemic's scale, which Mandela described as surpassing the toll of all wars, famines, and floods combined.[](http://www.mandela.gov.za/mandela_speeches/2003/031129_46664.htm) Subsequent events, including a London launch, mobilized citizen support for policy changes and resource allocation.[](https://www.unaids.org/es/resources/presscentre/pressreleaseandstatementarchive/2003/october/2003-10-21nelsonmandelamusiciansjoinforcesinfighta)\n\nMandela's global activism during this period extended to poverty eradication and peace promotion, leveraging his elder statesman status to endorse international campaigns for debt relief and equitable development.[](https://www.looktothestars.org/celebrity/nelson-mandela) He engaged with world leaders and organizations, such as the United Nations, to advocate for human rights and conflict resolution, drawing on his anti-apartheid experience to influence global discourse on inequality.[](https://www.un.org/en/exhibits/page/building-legacy-nelson-mandela) These efforts culminated in heightened international recognition, though by 2004, Mandela began scaling back public commitments to focus on health and family.[](https://www.nelsonmandela.org/timeline-2)\n\n### Semi-Retirement and Family Matters: 2004–2010\n\nOn 1 June 2004, at the age of 85, Nelson Mandela announced his retirement from public life in a speech at the Nelson Mandela Foundation offices in Johannesburg, expressing a desire to spend his remaining years in quieter pursuits with family and friends, including reading and reflection.[](http://www.mandela.gov.za/mandela_speeches/2004/040601_retire.htm)[](https://www.aljazeera.com/news/2004/6/1/mandela-retires-from-public-life) He famously advised, \"Don't call me, I'll call you,\" signaling a deliberate withdrawal from scheduled engagements to prioritize personal time after decades of activism and governance.[](https://brandsouthafrica.com/109264/news-facts/mandela-retirement/) This decision followed his post-presidential philanthropy but reflected growing health concerns and fatigue, though he retained influence through his foundation's initiatives on issues like HIV/AIDS and poverty alleviation.[](https://www.cnn.com/2013/12/05/world/africa/nelson-mandela-retirement-years)\n\nMandela's semi-retirement involved residing primarily at his Houghton home in Johannesburg and rural property in Qunu, Eastern Cape, where he focused on family interactions amid selective public appearances, such as occasional foundation events and the 2010 FIFA World Cup closing ceremony in Soccer City, Johannesburg, on 11 July.[](https://www.timesofisrael.com/major-events-in-the-life-of-nelson-mandela/) Despite the announced retreat, he lent symbolic support to causes like the 46664 HIV/AIDS awareness concerts into the late 2000s, though at a reduced pace compared to his earlier post-presidency activism.[](https://www.cnn.com/2013/12/05/world/africa/nelson-mandela-retirement-years) His wife, Graça Machel, remained a constant companion, providing support during this period of diminished visibility.\n\nA profound family tragedy struck on 6 January 2005, when Mandela's eldest and only surviving son, Makgatho Lewanika Mandela, aged 54, died in Johannesburg's Linksfield hospital from AIDS-related complications, including pneumonia and septic shock.[](https://www.theguardian.com/world/2005/jan/06/southafrica.aids)[](https://www.cnn.com/2005/WORLD/africa/01/07/mandela.son/) Mandela publicly disclosed the cause of death during a press conference at his home, urging openness to reduce stigma and encourage testing and treatment in South Africa, where HIV prevalence remained high.[](https://www.cbsnews.com/news/mandelas-son-dies-of-aids/) Makgatho's passing left Mandela without living sons from his first marriage to Evelyn Mase, compounding earlier losses like the 1969 death of his son Madiba Thembekile in a car accident.[](https://www.theguardian.com/world/2005/jan/16/southafrica.aids) The family gathered for the funeral, with Mandela's grandson Mandla expressing resolve to combat AIDS in tribute.[](https://www.theguardian.com/world/2005/jan/16/southafrica.aids)\n\nFamily tensions surfaced over property and inheritance, exemplified by a 2009 High Court ruling in Johannesburg granting Mandela's grandson, Inkosi Zwelivelile Mandla Mandela, the right to evict relatives from a house originally bought by Nelson Mandela in the 1950s as an investment.[](https://www.theguardian.com/world/2009/sep/02/nelson-mandela-grandson-court-battle) Mandla, who had been positioning himself as a traditional leader in the Eastern Cape, argued the property's historical ties justified his control, highlighting strains within the extended Mandela family over assets amid Mandela's semi-secluded status.[](https://www.theguardian.com/world/2009/sep/02/nelson-mandela-grandson-court-battle) These disputes underscored broader challenges in managing the Mandela legacy, though Nelson Mandela himself avoided direct public involvement, consistent with his retirement stance.[](https://www.cnn.com/2013/12/05/world/africa/nelson-mandela-retirement-years)\n\n### Final Illness, Hospitalizations, and Death: 2011–2013\n\nIn January 2011, Mandela, then aged 92, was admitted to a Johannesburg hospital for an acute respiratory infection and discharged after two nights of treatment.[](https://www.bloomberg.com/news/articles/2013-12-05/milestones-in-life-of-south-africa-s-nelson-mandela-timeline) [](https://www.bbc.com/news/world-africa-20713377)\n\nOn December 8, 2012, he was admitted to the Mediclinic Heart Hospital in Pretoria for scheduled medical tests on a recurring lung infection; doctors later performed a procedure to remove gallstones on December 15.[](https://www.cnn.com/2013/03/09/world/africa/mandela-hospitalized) [](https://www.reuters.com/article/world/factbox-a-timeline-of-mandela-s-health-problems-idUSBRE957062/) He remained hospitalized until January 6, 2013, responding to treatment for the infection, which stemmed from damage incurred during his 27 years of imprisonment, including tuberculosis contracted in 1988.[](https://www.bbc.com/news/world-africa-20677168) [](https://www.npr.org/sections/thetwo-way/2013/06/23/194935816/hospitalized-nelson-mandela-in-critical-condition)\n\nMandela was readmitted to a Pretoria hospital on March 27, 2013, suffering from a recurrence of pneumonia; medical staff drained fluid from his lungs and reported him stable and breathing independently by March 30.[](https://www.cnn.com/2013/04/06/world/africa/south-africa-mandela) [](https://www.npr.org/sections/thetwo-way/2013/06/08/189705242/nelson-mandela-back-in-hospital-with-health-complications) He was discharged on April 6 after successful treatment.[](https://www.khou.com/article/news/timeline-major-events-in-the-life-of-nelson-mandela/285-320638067)\n\nOn June 8, 2013, Mandela, aged 94, was hospitalized again in Pretoria for a recurring lung infection, entering critical condition by late June as doctors managed complications from his age and prior lung damage.[](https://www.latimes.com/world/la-xpm-2013-jun-08-la-fg-south-africa-mandela-20130609-story.html) [](https://www.npr.org/sections/thetwo-way/2013/06/23/194935816/hospitalized-nelson-mandela-in-critical-condition) He spent 87 days in care, with family updates confirming steady improvement, before discharge to home-based treatment on September 2.[](https://www.dw.com/en/nelson-mandelas-first-day-at-home/a-17060068)\n\nMandela received ongoing home medical care for the persistent lung infection until his death on December 5, 2013, at his Johannesburg residence, aged 95; South African President Jacob Zuma announced that he had \"passed on peacefully\" after a prolonged respiratory illness.[](https://www.bbc.com/news/world-africa-25249520) [](https://www.dw.com/en/south-africas-nelson-mandela-dies-age-95/a-17274676) No autopsy was performed, but officials attributed the outcome to complications from repeated infections linked to his imprisonment-era health impairments.[](https://www.bbc.com/news/world-africa-25249520)\n\n## Personal Life\n\n### Marriages, Children, and Family Strains\n\n![Nelson Mandela and Evelyn Mase in 1944](./_assets_/Mandela_e_Evelyn_1944.jpg)  \nNelson Mandela married Evelyn Ntoko Mase, a nurse and cousin of Walter Sisulu, in October 1944.[](https://www.nelsonmandela.org/genealogy) The couple had four children: Madiba Thembekile (born 1946, died 1969 in a car crash), Makaziwe (born 1947, died at nine months from illness), Makgatho Lewanika (born 1950, died 2005 from AIDS-related illness), and Makaziwe Phumla (born 1954).[](https://sahistory.org.za/people/evelyn-ntoko-mase)[](https://www.nelsonmandela.org/faqs) Their marriage ended in divorce on March 19, 1958, amid growing tensions from Mandela's intensifying political activism, which demanded long absences and financial strains, and mutual accusations of infidelity and incompatibility.[](https://sahistory.org.za/people/evelyn-ntoko-mase)[](https://www.nelsonmandela.org/genealogy)\n\nIn June 1958, Mandela married Nomzamo Winifred Madikizela, a social worker, shortly after his divorce from Mase.[](https://www.nelsonmandela.org/genealogy) They had two daughters: Zenani (born 1959) and Zindziswa (born 1960, died 2020).[](https://www.nelsonmandela.org/faqs) Mandela's 1962 arrest and subsequent 27-year imprisonment severely strained the family; he was largely absent as a father, missing key milestones and leaving Winnie to raise the children amid harassment and isolation under apartheid restrictions.[](https://www.cbsnews.com/news/nelson-mandelas-daughter-he-was-not-there-as-a-father/) One daughter from the first marriage, Makaziwe Phumla, later reflected that Mandela \"was not there as a father,\" highlighting the emotional toll of his political commitments.[](https://www.cbsnews.com/news/nelson-mandelas-daughter-he-was-not-there-as-a-father/)\n\nPost-release in 1990, the marriage deteriorated further due to Winnie's extramarital affair with lawyer Dali Mpofu and her involvement in controversies, including allegations of endorsing violence during apartheid's endgame.[](https://www.theguardian.com/world/2013/dec/06/nelson-winnie-mandela-marriage)[](https://www.washingtonpost.com/news/retropolis/wp/2018/04/02/winnie-and-nelson-mandelas-marriage-survived-three-decades-of-prison-but-not-freedom/) Mandela initiated separation in 1992, and the divorce was finalized in 1996, with him citing irreconcilable differences rooted in her infidelity and political excesses.[](https://www.theguardian.com/world/2013/dec/06/nelson-winnie-mandela-marriage)[](https://www.washingtonpost.com/news/retropolis/wp/2018/04/02/winnie-and-nelson-mandelas-marriage-survived-three-decades-of-prison-but-not-freedom/)\n\nMandela wed Graça Machel, widow of Mozambican president Samora Machel and child rights advocate, on July 18, 1998—his 80th birthday—in a private Johannesburg ceremony.[](https://sahistory.org.za/dated-event/nelson-mandela-marries-graca-machel-his-80th-birthday) The union produced no children but provided Mandela personal stability in his later years, contrasting earlier familial disruptions.[](https://sahistory.org.za/dated-event/nelson-mandela-marries-graca-machel-his-80th-birthday)\n\nFamily strains persisted beyond marriages, exacerbated by Mandela's activism and imprisonment; sons from the first marriage grew up without paternal guidance, contributing to their premature deaths and ongoing resentments.[](https://www.cbsnews.com/news/nelson-mandelas-daughter-he-was-not-there-as-a-father/)[](https://www.nelsonmandela.org/faqs) Posthumous disputes over exhumations of children's remains in 2013— involving Thembi, infant Makaziwe, and Makgatho—revealed rifts among grandchildren and ex-family members vying for control of Mandela's legacy and burial site.[](https://abcnews.go.com/International/bodies-nelson-mandelas-children-exhumed-ghoulish-family-feud/story?id=19565455) These conflicts underscored how Mandela's public life overshadowed private bonds, leaving a legacy of fractured relationships marked by loss and litigation rather than cohesion.[](https://abcnews.go.com/International/bodies-nelson-mandelas-children-exhumed-ghoulish-family-feud/story?id=19565455)\n\n### Personality Traits, Health Issues, and Daily Habits\n\nMandela demonstrated remarkable **resilience** and **endurance**, qualities honed during his 27 years of imprisonment, where he maintained physical fitness through rigorous self-imposed routines despite harsh conditions.[](https://www.reuters.com/article/world/factbox-a-timeline-of-mandela-s-health-problems-idUSBRE957062/) He was also characterized by **charisma** and oratorical skill, enabling him to inspire followers and negotiate with adversaries, as seen in his role in dismantling apartheid.[](https://www.businessandleadership.com/leadership/item/nelson-mandela-leadership-which-ended-apartheid/) Contemporaries noted his **humility** and capacity for **forgiveness**, exemplified by his support for the Truth and Reconciliation Commission, though critics argue this masked deeper strategic pragmatism rather than innate temperament.[](https://www.facebook.com/NelsonMandelaCentreOfMemory/posts/some-of-the-character-traits-that-nelson-mandela-espoused-were-those-of-love-sel/3217038491667229/) Early in life, he displayed a **hot-tempered** streak, admitting in his autobiography to impulsive decisions, but prison tempered this into calculated **determination** and **tactical patience**.[](https://skipprichard.com/11-leadership-qualities-of-nelson-mandela/)\n\nHis health history included an enlarged prostate gland requiring surgery on November 28, 1985, which alleviated urinary blockage but marked the onset of recurring issues.[](https://www.telegraph.co.uk/news/worldnews/nelson-mandela/10138320/Nelson-Mandelas-health-problems.html) In August 1988, while imprisoned, he was diagnosed with early-stage tuberculosis, treated successfully but leaving permanent lung damage that predisposed him to infections.[](https://www.news24.com/life/mandelas-health-history-20130610) Post-release, he underwent radiotherapy for prostate cancer diagnosed in July 2001, achieving remission.[](https://www.telegraph.co.uk/news/worldnews/nelson-mandela/10138320/Nelson-Mandelas-health-problems.html) In later years, respiratory complications intensified; he was hospitalized for pneumonia in December 2012 and June 2013, stemming from TB sequelae and age-related decline, culminating in his death from prolonged respiratory infection and heart failure on December 5, 2013, at age 95.[](https://www.reuters.com/article/world/factbox-a-timeline-of-mandela-s-health-problems-idUSBRE957062/)[](https://www.scientificamerican.com/article/ask-the-experts-lung-infections/)\n\nMandela maintained disciplined daily habits emphasizing exercise for both physical vitality and mental clarity, believing it dissipated tension.[](https://www.facebook.com/nelsonmandela/posts/i-have-always-believed-exercise-is-a-key-not-only-to-physical-health-but-to-peac/3321463044531128/) In Robben Island's prison cell, from Monday to Thursday, he performed up to 45 minutes of stationary running followed by 100 sit-ups, push-ups, and other calisthenics, adapting to limited space.[](http://theguycancook.com/blog/2012/03/30/what-nelson-mandela-can-teach-us-about-fitness/) As president, he rose early—often at 4 or 5 a.m.—made his own bed, and dedicated 30 minutes to light exercise before breakfast.[](https://southafrica.co.za/a-typical-day-of-president-mandela.html) His diet favored simple, nutrient-dense foods: cereal, fresh fruit, grilled chicken, rice, and traditional Xhosa dishes like peanut butter spinach soup, while avoiding processed items and excess sugar to sustain energy.[](https://library.habitsets.com/people/nelson-mandela/) These routines persisted into retirement, underscoring his commitment to self-discipline amid political demands.[](https://thering.sg/how-we-can-draw-on-mandela-for-inspiration-during-challenging-times/)\n\n## Political Ideology\n\n### Commitment to Democracy and Multi-Racialism\n\n![Mandela voting in 1994](./_assets_/Mandela_voting_in_1994.jpg)\n\nMandela's commitment to multi-racialism was evident in his adherence to the African National Congress (ANC) policy of non-racialism, formalized in the Freedom Charter adopted on June 26, 1955, at the Congress of the People in Kliptown, which declared that \"South Africa belongs to all who live in it, united in our diversity\" and envisioned a democratic state without racial discrimination.[](https://www.marxists.org/subject/africa/bunting-brian/kotane/ch13.htm) This charter rejected Africanist exclusivity, positioning the ANC against factions like the Pan-Africanist Congress that opposed multi-racial alliances, a stance Mandela upheld during internal debates in the 1950s.[](https://sahistory.org.za/article/nelson-mandela-timeline-1950-1959) Despite pressures from radical elements favoring black nationalism, Mandela co-authored and defended the charter's inclusive framework, which influenced the ANC's strategy against apartheid by seeking alliances across racial lines, including with white, Indian, and Coloured groups in the Congress Alliance.[](https://www.nelsonmandela.org/omalley/cis/omalley/OMalleyWeb/03lv02424/04lv02730/05lv03188/06lv03189.htm)\n\nIn negotiations to end apartheid, Mandela demonstrated dedication to multi-party democracy by engaging in the Convention for a Democratic South Africa (CODESA) from December 1991 and subsequent multi-party talks, insisting on an elected constituent assembly as the mechanism for a new constitution rather than unilateral imposition.[](http://www.mandela.gov.za/mandela_speeches/1993/931117_multiparty.htm) In a 1992 letter to President F.W. de Klerk, he emphasized that the sovereign body's composition tested genuine commitment to democracy, rejecting distortions of ANC proposals that could undermine broad participation.[](https://www.anc1912.org.za/letters-1992-letter-from-nelson-mandela-to-fw-de-klerk/) Mandela's address to the multi-party negotiations plenary on November 17, 1993, underscored the process's role in forging unity from division, prioritizing peaceful transition over vengeance.[](http://www.mandela.gov.za/mandela_speeches/1993/931117_multiparty.htm) This culminated in the 1994 elections, South Africa's first under universal suffrage, where Mandela voted on April 27, affirming multi-racial participation as the ANC secured 62.65% of the vote in a contest with multiple parties.[](https://www.nationalgeographic.com/history/article/nelson-mandela-fought-apartheid-work-not-complete)\n\nAs president from May 10, 1994, to June 16, 1999, Mandela reinforced democratic norms by upholding the multi-party framework, as seen in his response to the National Party's 1996 withdrawal from the Government of National Unity, where he stressed that unity relied on voluntary coalitions, not enforced ones, and affirmed confidence in the system.[](http://www.mandela.gov.za/mandela_speeches/1996/960509_np.htm) At the ANC's 48th National Conference in 1991, he articulated the party's rejection of one-party dominance, committing to multi-party democracy to ensure accountability and prevent authoritarianism.[](https://www.anc1912.org.za/48th-national-conference-nelson-mandelas-opening-address/) In his 1997 address, Mandela reiterated the ANC's role in a pluralistic system, viewing opposition parties as essential to democratic health rather than threats.[](https://speakola.com/political/nelson-mandela-final-speech-leader-anc-party-conference-1997) These positions contrasted with some ANC allies' preferences for socialist centralism, highlighting Mandela's pragmatic emphasis on inclusive governance to sustain post-apartheid stability.[](https://monthlyreview.org/articles/mandelas-democracy/)\n\n### Marxist Influences, SACP Membership, and Socialism\n\nMandela's engagement with Marxist ideas began in the late 1940s through associations with African National Congress (ANC) figures like Walter Sisulu and Moses Kotane, who introduced him to communist circles and literature.[](https://martinplaut.com/2015/02/25/mandela-and-the-communist-party/) By the early 1950s, Mandela reported that studying Marxist texts \"deepened my sense of commitment\" to anti-apartheid struggle and aligned him more closely with Communist Party members, influencing his strategic thinking on class alliances and economic redistribution.[](https://martinplaut.com/2015/02/25/mandela-and-the-communist-party/) This exposure shaped his advocacy for the 1955 Freedom Charter, which demanded nationalization of key industries like mines and banks, reflecting socialist principles of collective ownership to address racial capitalism, though Mandela later emphasized it as a unifying program rather than a rigid ideological blueprint.[](https://www.un.org/en/events/mandeladay/court_statement_1964.shtml)\n\n![Soviet recognition of Mandela](./_assets_/The_Soviet_Union_1988_CPA_5971_stamp_%252870th_birth_anniversary_of_Nelson_Mandela%252C_South_African_anti-apartheid_revolutionary%252C_political_leader_and_philanthropist%2529 )\n\nDeclassified documents and archival evidence confirm Mandela's membership in the South African Communist Party (SACP), an underground affiliation he publicly denied during his 1963-1964 Rivonia Trial to avoid bolstering apartheid regime accusations of subversion.[](https://www.telegraph.co.uk/news/worldnews/nelson-mandela/9731522/Nelson-Mandela-proven-to-be-a-member-of-the-Communist-Party-after-decades-of-denial.html) A 1961 SACP document from Russian archives lists Mandela as a member recruited that year, while 1982 Politburo minutes, uncovered by historian Stephen Ellis, place him on the party's central committee alongside figures like Joe Slovo.[](https://www.ascleiden.nl/news/research-stephen-ellis-confirmed-nelson-mandela-was-member-south-african-communist-party) At least six senior SACP leaders, including Raymond Suttner and Mac Maharaj, have affirmed his involvement, attributing secrecy to operational needs amid ANC-SACP alliance tensions and Mandela's non-European leadership role in the ANC.[](https://www.opendemocracy.net/en/mandela-communism-and-south-africa/) This membership facilitated the 1961 formation of Umkhonto we Sizwe (MK), the ANC's armed wing, as a joint initiative with the SACP, where Mandela served as initial commander, drawing on Leninist tactics of guerrilla warfare against apartheid infrastructure.[](https://www.tandfonline.com/doi/abs/10.1080/03057070.2018.1404264)\n\nMandela's socialism blended African nationalism with Marxist-Leninist elements, prioritizing anti-imperialist unity over doctrinal purity; he described himself as influenced by socialism's emphasis on equality but rejected Soviet-style communism as incompatible with South Africa's multi-class liberation front.[](https://africasacountry.com/2023/06/mandelas-black-marxism) In his 1964 trial statement, he acknowledged \"the need for some form of socialism\" to industrialize and redistribute resources, yet clarified the Freedom Charter envisioned democratic reforms, not state seizure of all production.[](https://www.un.org/en/events/mandeladay/court_statement_1964.shtml) Post-release, pragmatic shifts occurred: by 1992, Mandela explicitly opposed nationalization in ANC policy documents, favoring mixed-economy incentives over expropriation to attract investment and redress colonial inequities without full socialization.[](https://www.youtube.com/watch?v=ZB6eCqYlqQw) This evolution reflected causal pressures from global capitalism and internal ANC debates, where SACP influence waned against Mandela's focus on reconciliation and growth, though critics note persistent socialist rhetoric masked policy moderation that preserved private enterprise.[](https://monthlyreview.org/articles/mandelas-democracy/)\n\n### Justification for Violence and Armed Resistance\n\nMandela and the African National Congress (ANC) initially adhered to a policy of non-violent resistance against apartheid, including campaigns like the Defiance of Unjust Laws in 1952 and the Congress of the People in 1955, which adopted the Freedom Charter.[](https://law2.umkc.edu/faculty/projects/ftrials/mandela/mandelaspeech.html) However, escalating government repression, culminating in the Sharpeville Massacre on March 21, 1960—where South African police killed 69 unarmed protesters and wounded over 180 during a demonstration against pass laws—demonstrated the futility of peaceful protest, as the state responded with lethal force rather than negotiation.[](https://digitalcommons.georgiasouthern.edu/aujh/vol13/iss1/5/) [](https://sahistory.org.za/article/1960-1966-genesis-armed-struggle) The massacre prompted a national stay-at-home strike and state of emergency, during which over 18,000 people were arrested, further eroding faith in non-violence.[](https://www.facinghistory.org/resource-library/mandela-trial)\n\nOn April 8, 1960, the apartheid government banned the ANC and the Pan Africanist Congress (PAC), outlawing their activities and driving leaders underground, which Mandela cited as a pivotal factor rendering constitutional or passive resistance impossible.[](https://law2.umkc.edu/faculty/projects/ftrials/mandela/mandelaspeech.html) [](https://www.facinghistory.org/resource-library/mandela-trial) In discussions from May to June 1961, Mandela argued that the ANC's non-racial, non-violent approach had \"achieved nothing\" in altering the apartheid system's use of violence against Africans, leading to the formation of Umkhonto we Sizwe (MK), the ANC's armed wing, on December 16, 1961.[](https://law2.umkc.edu/faculty/projects/ftrials/mandela/mandelaspeech.html) MK's initial strategy emphasized sabotage of economic infrastructure—such as power stations, government buildings, and transportation lines—to disrupt the regime without targeting lives, as Mandela explained that \"properly controlled violence\" would pressure the government while minimizing casualties and avoiding escalation to guerrilla warfare unless provoked.[](https://www.un.org/en/events/mandeladay/court_statement_1964.shtml) [](https://www.bbc.com/news/world-africa-10529498)\n\nDuring the Rivonia Trial in 1963–1964, Mandela defended the shift in his April 20, 1964, statement from the dock, asserting that the ANC had exhausted all peaceful avenues and that without violence, \"there would be no way open to the African people to succeed in their struggle against the principle of white supremacy.\"[](https://law2.umkc.edu/faculty/projects/ftrials/mandela/mandelaspeech.html) [](https://www.bbc.com/news/world-africa-10529498) He emphasized MK's subordination to ANC political leadership and its aim to achieve a non-racial democracy, not communist dictatorship, framing armed action as a defensive response to the state's monopoly on violence, which had already claimed thousands of lives in suppressing dissent.[](https://law2.umkc.edu/faculty/projects/ftrials/mandela/mandelaspeech.html) Mandela acknowledged potential for broader conflict if sabotage failed, stating he was prepared to die for the ideal of a democratic society, but maintained that the resort to arms was compelled by the regime's refusal to allow political change through non-violent means.[](https://www.un.org/en/events/mandeladay/court_statement_1964.shtml) This justification aligned with first-principles reasoning that prolonged oppression justified proportionate countermeasures when legal avenues were systematically blocked, though critics later noted MK's operations sometimes blurred lines between military and civilian targets.[](https://law2.umkc.edu/faculty/projects/ftrials/mandela/mandelaspeech.html)\n\n## Controversies and Criticisms\n\n### Ethical Questions on MK Operations and Civilian Casualties\n\nUmkhonto we Sizwe (MK), co-founded by Nelson Mandela on 16 December 1961 as the ANC's armed wing, initially adhered to a policy of sabotage targeting economic and military infrastructure to avoid human casualties, reflecting Mandela's stated intent to minimize loss of life while signaling armed resistance to apartheid repression. This approach was articulated in MK's manifesto, which emphasized precision strikes on unoccupied targets to pressure the regime without alienating international support or moral legitimacy. However, as operations escalated in the 1970s and 1980s amid intensified state crackdowns, MK shifted toward urban bombings and guerrilla tactics, resulting in unintended but foreseeable civilian deaths that prompted ethical scrutiny over proportionality and civilian protections under just war principles. The Truth and Reconciliation Commission (TRC) later determined that the majority of casualties from ANC/MK attacks were civilians, attributing this to operational lapses rather than deliberate policy, though holding the ANC morally and politically accountable for abuses.[](https://omalley.nelsonmandela.org/index.php/site/q/03lv02424/04lv02730/05lv02918/06lv02938.htm)[](https://www.justice.gov.za/trc/media/1998/9810/s981029j.htm)\n\nProminent examples include the Church Street bombing on 20 May 1983 in Pretoria, where an MK car bomb detonated outside South African Air Force headquarters during rush hour, killing 19 people—two military personnel and 17 civilians—and injuring 217 others, many severely. ANC leaders justified the attack as retaliation against SADF raids and a strike on a military target, but critics highlighted the timing and placement as recklessly endangering non-combatants, violating distinctions between legitimate military objectives and civilian areas. Similarly, the Amanzimtoti shopping center bombing on 23 December 1985, carried out by MK operative Andrew Sibusiso Zondo in reprisal for a SADF incursion into Lesotho, exploded amid holiday shoppers, killing five civilians (including children) and wounding over 40, drawing condemnation for targeting a civilian venue despite claims of symbolic protest. MK's rural landmine campaign in the late 1980s further exacerbated civilian tolls, with devices placed on roadsides killing or maiming farmers and bystanders, as documented in TRC hearings.[](https://www.justice.gov.za/trc/hrvtrans/submit/anc2.htm)[](https://sabctrc.saha.org.za/reports/volume3/chapter3/subsection29.htm)\n\nMandela, imprisoned from 1962 onward and unable to directly command 1980s operations, bore symbolic responsibility as MK's founding commander and ANC figurehead, having defended the turn to violence in his 1964 Rivonia Trial testimony as a calibrated escalation after non-violent avenues failed against state intransigence. He later expressed regret over specific civilian deaths, describing them in his autobiography as \"tragic accidents\" that horrified him, while maintaining that armed struggle's overall necessity outweighed isolated errors, provided intent avoided indiscriminate targeting. Ethical critiques, including from just war theorists, question whether MK's acceptance of collateral risks—such as urban blasts in populated areas—eroded the moral asymmetry of the anti-apartheid fight, potentially prolonging conflict by hardening regime resolve and complicating post-apartheid reconciliation. The ANC's post-1990 apology for civilian casualties, citing inadequate cadre training, acknowledged these failings but framed them as aberrations within a defensive war, a view contested by analysts noting systemic planning deficiencies.[](https://www.un.org/en/events/mandeladay/court_statement_1964.shtml)[](https://omalley.nelsonmandela.org/index.php/site/q/03lv03445/04lv04015/05lv04016/06lv04030/07lv04031.htm)[](https://www.justice.gov.za/trc/hrvtrans/submit/anc2.htm)\n\nThese incidents fueled broader debates on causal trade-offs: while MK operations contributed to apartheid's erosion by imposing economic costs and global pressure, the civilian toll—estimated in hundreds across campaigns—raised proportionality concerns, as non-lethal sabotage might have sustained moral authority without alienating moderates or inviting reprisals that killed thousands more in state responses. Sources like TRC archives, drawn from amnesty applications and eyewitness accounts, provide empirical grounding but reflect institutional biases toward reconciliation over punitive accountability, potentially understating intent in operational directives. Independent analyses emphasize that, absent rigorous firebreak rules against civilian proximity, such tactics blurred into coercive violence, challenging hagiographic portrayals of Mandela's leadership as unblemished.[](https://omalley.nelsonmandela.org/index.php/site/q/03lv02424/04lv02730/05lv02918/06lv02938.htm)[](https://www.hamascase.com/volume-ii/26_vadi-anc/)\n\n### Economic Legacy: Inequality, Corruption Roots, and Policy Shifts\n\n![RDP houses representing early housing policy under Mandela](./_assets_/Rdphouses.jpg)\n\nDuring Nelson Mandela's presidency from 1994 to 1999, South Africa's economic policies initially emphasized the Reconstruction and Development Programme (RDP), a framework promising housing, education, and infrastructure to redress apartheid-era disparities, but implementation faltered amid fiscal constraints and administrative challenges.[](https://omalley.nelsonmandela.org/index.php/site/q/03lv02039/04lv02103/05lv02120/06lv02126.htm) By 1996, the government shifted to the Growth, Employment and Redistribution (GEAR) strategy, prioritizing macroeconomic stability, privatization elements, and export-led growth to attract investment after years of sanctions, reflecting a pragmatic departure from earlier socialist rhetoric in the ANC's Freedom Charter.[](https://www.bbc.com/news/business-23041513) This pivot stabilized public finances, reducing the fiscal deficit, but yielded modest GDP growth averaging 3.2% annually, insufficient to broadly uplift the black majority amid inherited structural rigidities like rigid labor markets and skills gaps.[](https://www.bbc.com/news/business-23041513)[](https://tpy.nelsonmandela.org/pages/part-iv-transformation/12-social-and-economic-transformation/12-3-economy)\n\nIncome inequality, already severe under apartheid with a Gini coefficient of approximately 0.59 in 1993, showed little improvement and arguably worsened slightly by the late 1990s, remaining above 0.60 as wealth concentrated among a nascent black elite while mass poverty endured.[](https://www.bloomberg.com/news/articles/2013-12-06/mandela-free-market-legacy-imperiled-by-south-african-inequality) Official data from Statistics South Africa later confirmed that post-1994 policies, including GEAR's focus on efficiency over redistribution, failed to narrow racial or intra-black disparities, with inequalities within racial groups intensifying due to uneven access to emerging opportunities.[](https://www.statssa.gov.za/publications/Report-03-10-19/Report-03-10-192017.pdf) Critics, including ANC-aligned economists, attributed this to GEAR's neoliberal tilt, which prioritized investor confidence over aggressive land reform or wage controls, perpetuating a dual economy where formal sector gains bypassed informal and rural populations.[](https://journals.co.za/doi/pdf/10.10520/EJC-ae480ac06)\n\nUnemployment rates climbed from about 20% in 1994 to 25.4% by 1999, exacerbated by global commodity slumps, rapid formalization of previously informal apartheid-era jobs, and GEAR's emphasis on capital-intensive growth rather than labor absorption.[](https://businesstech.co.za/news/trending/77737/south-africa-unemployment-1994-2015/) World Bank estimates align with this trend, highlighting how policy shifts toward fiscal austerity curbed inflation but stifled job creation in manufacturing and mining, sectors shedding over 250,000 positions between 1989 and 1992 with little reversal under Mandela.[](https://data.worldbank.org/indicator/SL.UEM.TOTL.ZS)[](https://omalley.nelsonmandela.org/index.php/site/q/03lv02167/04lv02218/05lv02244/06lv02252.htm) Despite RDP initiatives delivering over one million subsidized houses by 1999, these measures proved inadequate against structural barriers, including low skills among the black workforce and resistance to deregulation from union allies.[](https://www.gov.za/blog/former-president-nelson-mandelas-economic-legacy-lives)\n\nThe roots of entrenched corruption trace to early ANC governance practices, including cadre deployment—prioritizing party loyalists in state roles over merit—which eroded institutional independence inherited from apartheid structures.[](https://newlinesmag.com/argument/nelson-mandelas-african-national-congress-has-violated-everything-he-stood-for/) In 1995, senior ANC figure Winnie Mandela faced accusations of accepting a US$20,000 bribe from a construction firm for government contracts, signaling initial vulnerabilities in tender processes amid rapid state expansion.[](https://en.wikipedia.org/wiki/Corruption_in_South_Africa) The introduction of Black Economic Empowerment (BEE) under Mandela, initially focused on black ownership stakes in firms, aimed to foster inclusion but devolved into patronage networks benefiting politically connected individuals, laying groundwork for cronyism by channeling state resources through opaque deals rather than broad-based development.[](https://www.nelsonmandela.org/omalley/cis/omalley/OMalleyWeb/03lv03445/04lv04206/05lv04220/06lv04221/07lv04222.htm)[](https://www.bbc.com/news/business-23041513) This approach, while politically expedient to consolidate ANC support, prioritized elite enrichment over systemic reforms, contributing to long-term governance decay as evidenced by subsequent scandals like the arms deal implicating Mandela associates.[](https://www.quora.com/Why-is-the-ANC-regime-in-South-Africa-so-corrupt-despotic-and-evil)\n\n### Handling of HIV/AIDS and Other Social Failures\n\nMandela's administration from 1994 to 1999 coincided with a rapid escalation of the HIV epidemic in South Africa, where prevalence among antenatal clinic attendees increased from 7.6% in 1994 to 22.4% by 1999.[](https://pmc.ncbi.nlm.nih.gov/articles/PMC2803032/) Despite early warnings from health experts, the government under Mandela allocated limited resources to HIV prevention and treatment, establishing a national AIDS program in 1994 but failing to fund it adequately or integrate it into broader public health priorities.[](https://sahistory.org.za/article/history-official-government-hivaids-policy-south-africa) Mandela himself rarely addressed the crisis publicly during his presidency, prioritizing political reconciliation and economic stabilization over aggressive public health campaigns, which critics contend allowed the epidemic to entrench itself unchecked.[](https://www.pbs.org/wgbh/frontline/article/nelson-mandelas-mixed-legacy-on-hivaids/) By the end of his term, adult HIV infection rates approached 20%, with approximately 500 AIDS-related deaths occurring daily and no nationwide antiretroviral treatment initiative in place.[](https://swasti.org/knowledgebase/blog/nelson-mandela-and-the-battle-against-hiv-and-aids-in-south-africa-pertinent-lessons)\n\nThis inaction extended to a broader reluctance to confront the scientific consensus on HIV causation, setting a precedent for later denialism under successor Thabo Mbeki, though Mandela's government avoided overt rejection of antiretrovirals.[](https://pmc.ncbi.nlm.nih.gov/articles/PMC3738204/) Mandela established the South African National AIDS Coordinating Committee in 1992 pre-presidency, but its effectiveness waned under resource constraints and competing demands for housing and welfare programs.[](https://www.cuimc.columbia.edu/news/nelson-mandelas-public-health-legacy) Post-presidency, Mandela shifted to vocal advocacy, launching the 46664 campaign in 2002 and publicly criticizing Mbeki's policies in 2000 for diverting focus from education and treatment.[](https://www.theguardian.com/world/2000/sep/30/nelsonmandela)[](https://www.bbc.com/news/world-africa-10529266) Nonetheless, assessments of his presidential tenure highlight a missed opportunity to leverage his moral authority for early intervention, contributing to an estimated hundreds of thousands of preventable infections and deaths in the subsequent decade.[](https://www.pbs.org/wgbh/frontline/article/nelson-mandelas-mixed-legacy-on-hivaids/)[](https://www.science.org/content/article/world-mourns-mandela-his-role-aids-awareness-recalled)\n\nBeyond HIV/AIDS, Mandela's government faced challenges in addressing entrenched social issues like surging violent crime, persistent unemployment, and inadequate education access, which apartheid legacies exacerbated but post-1994 policies failed to reverse decisively.[](https://1997-2001.state.gov/background_notes/southafrica_0004_bgn.html) Murder rates, already high at around 67 per 100,000 in 1994–1995, remained elevated throughout his term amid police restructuring and insufficient community policing reforms, reflecting a prioritization of symbolic unity over operational capacity-building.[](https://www.everycrsreport.com/reports/R43130.html) Unemployment affected roughly 20–23% of the workforce in the mid-1990s, with growth in formal job creation lagging due to fiscal conservatism via the 1996 Growth, Employment and Redistribution strategy, which critics argue entrenched inequality by favoring market liberalization over labor-intensive public works.[](https://www.dw.com/en/nelson-mandelas-mixed-legacy/a-44691481) Education outcomes stagnated, with adult illiteracy rates above 15% and school infrastructure deficits unaddressed at scale, as budget allocations favored reconciliation commissions over systemic overhauls.[](https://sayasblog.com/2020/04/27/freedom-or-fallacy/) These shortcomings stemmed from a focus on macroeconomic stability and avoiding white flight, which deferred bold redistributive measures and allowed social pathologies to fester, laying groundwork for later governance breakdowns.[](https://www.newyorker.com/news/daily-comment/mandelas-dream-for-south-africa-is-in-ruins)[](https://theconversation.com/nelson-mandelas-legacy-is-taking-a-battering-because-of-the-dismal-state-of-south-africa-209883)\n\n### Associations with Authoritarian Regimes and Ideological Stances\n\n![Soviet stamp honoring Nelson Mandela](./_assets_/The_Soviet_Union_1988_CPA_5971_stamp_%252870th_birth_anniversary_of_Nelson_Mandela%252C_South_African_anti-apartheid_revolutionary%252C_political_leader_and_philanthropist%2529)\n\nDuring the apartheid era, the African National Congress (ANC) and its armed wing, Umkhonto we Sizwe (MK), received substantial material, financial, and military support from communist bloc countries, including the Soviet Union, Cuba, East Germany, and China, as well as non-aligned authoritarian states like Libya. The Soviet Union provided training to thousands of MK cadres at facilities in the USSR and allied nations, along with weapons and ideological guidance through its close partnership with the South African Communist Party (SACP), which shared leadership overlaps with the ANC.[](https://www.cia.gov/readingroom/docs/CIA-RDP91B00874R000100200015-4.pdf)[](https://www.kyleorton.com/p/anc-sacp-soviet-assets-destroyed-south-africa) Cuba contributed significantly by deploying over 300,000 internationalist troops to Angola, where their victory against South African forces at the Battle of Cuito Cuanavale in 1987-1988 was later described by Mandela as a pivotal moment weakening apartheid's military dominance.[](https://cuba-solidarity.org.uk/news/article/3421/nelson-mandela-on-how-cuba-destroyed-the-myth-of-the-invincibility-of-the-white-oppressor) Libya under Muammar Gaddafi supplied financial aid and military training to ANC exiles, aiding their operations against the apartheid regime.[](https://www.facebook.com/AfricanArchives/posts/nelson-mandela-and-libyan-leader-muammar-gaddafi-in-tripoli-libya-1990/1165390635625672/)\n\nFollowing his release from prison on February 11, 1990, Mandela prioritized visits to these supporters, underscoring his personal commitment to these alliances. His first international trip was to Cuba on July 26, 1991, where he addressed a crowd of 250,000 in Havana, thanking Fidel Castro for Cuba's \"invaluable\" assistance and stating, \"We come here with the hearts of sons and daughters who owe their lives to the great generosity of this country.\"[](https://www.facebook.com/arfsBlog/posts/in-1991-shortly-after-his-release-nelson-mandela-visited-cuba-sparking-strong-re/1284425273047716/)[](https://havanatimes.org/features/mandela-a-loyal-friend-of-cubas-fidel/) In September 1990, he traveled to Libya to express gratitude to Gaddafi for past support, despite Western sanctions and criticisms of Gaddafi's human rights record.[](https://www.facebook.com/AfricanArchives/posts/nelson-mandela-and-libyan-leader-muammar-gaddafi-in-tripoli-libya-1990/1165390635625672/) During a June 21, 1990, ABC News interview, Mandela defended his associations with Gaddafi, Castro, and Yasser Arafat, asserting, \"They are our friends,\" and contrasting their aid to the ANC with Western support for apartheid allies like Mobutu Sese Seko in Zaire.[](https://thekenyatimes.com/latest-kenya-times-news/today-in-history-when-mandela-fired-back-at-us-for-criticizing-his-relationships-with-gaddafi-castro-and-arafat/)\n\nMandela maintained these ties into his presidency (1994-1999), prioritizing ideological loyalty over geopolitical pressures. In a 1991 speech, he explicitly praised the Soviet Union, East Germany, and China for their roles in the anti-apartheid struggle, even as the Soviet bloc dissolved.[](https://www.aljazeera.com/features/2013/12/6/mandela-the-radical) He visited Russia in 1999 to thank it for historical solidarity.[](https://www.rbth.com/world/2013/12/06/nelson_mandela_and_the_ussr_the_russian_role_in_the_struggle_against_ap_31431) In October 1997, defying UN sanctions related to the Lockerbie bombing, Mandela met Gaddafi in Tripoli, greeting him as \"my brother leader\" and later awarding him South Africa's highest honor, the Order of Good Hope, in 1999.[](https://www.nytimes.com/1997/10/23/world/despite-un-ban-mandela-meets-qaddafi-in-libya.html) Gaddafi reciprocated with a visit to South Africa in June 1999, hosted by Mandela at Robben Island.[](https://www.youtube.com/watch?v=yq_dvbbwEgU) These actions reflected Mandela's stance that foreign policy should honor those who aided liberation efforts, irrespective of domestic authoritarian practices in those regimes, a position he articulated as prioritizing anti-imperialist solidarity over selective human rights critiques.[](https://fpif.org/nelson-mandelas-closest-allies/)[](https://www.washingtonpost.com/news/worldviews/wp/2013/12/10/the-last-great-liberator-why-mandela-made-and-stayed-friends-with-dictators/)\n\n## Reception and Long-Term Impact\n\n### Global Honors, Monuments, and Hagiographic Narratives\n\n![Nelson Mandela bust in London](./_assets_/Mandela_Bust_at_Southbank.jpg)\nMandela was awarded the Nobel Peace Prize on October 14, 1993, jointly with Frederik Willem de Klerk, for their collaborative efforts in negotiating the end of apartheid and laying the foundations for a democratic South Africa.[](https://sahistory.org.za/article/nelson-mandela-awards-1960s-2000s) He received India's Bharat Ratna, the country's highest civilian honor, on May 16, 1990, recognizing his anti-apartheid activism.[](https://sahistory.org.za/article/nelson-mandela-awards-1960s-2000s) Additional global accolades included the United States Presidential Medal of Freedom in 2002 and the Jawaharlal Nehru Award for International Understanding in 1980, among over 250 honors accumulated during his lifetime.[](https://sahistory.org.za/article/nelson-mandela-awards-1960s-2000s) [](https://www.nelsonmandela.org/tributes1)\n\nNumerous monuments commemorate Mandela internationally, with at least 40 public statues erected worldwide, including 19 within South Africa.[](https://www.thesouthafrican.com/news/politics/over-40-statues-of-nelson-mandela-around-the-world-heres-where-birthday-madiba-union-buildings/) Notable examples outside South Africa feature installations in England, such as the Parliament Square statue in London unveiled in 2007; the United States, including one in Washington, D.C.; France; and further afield in Cuba, China, and Brazil.[](https://www.thesouthafrican.com/news/politics/over-40-statues-of-nelson-mandela-around-the-world-heres-where-birthday-madiba-union-buildings/) [](https://www.sabcnews.com/sabcnews/hold-for-amgallery-the-world-of-mandela-statues/) The tallest monument, a 9-meter bronze statue, stands at South Africa's Union Buildings in Pretoria, symbolizing his presidency and reconciliation efforts.[](https://www.thesouthafrican.com/news/politics/over-40-statues-of-nelson-mandela-around-the-world-heres-where-birthday-madiba-union-buildings/)\n\nHagiographic narratives portray Mandela as a near-saintly figure of universal forgiveness and moral exemplarity, often emphasizing his post-prison reconciliation over his earlier endorsement of armed resistance through Umkhonto we Sizwe.[](https://jacobin.com/2013/12/the-two-mandelas/) Films such as *Invictus* (2009), depicting his use of rugby to foster national unity, exemplify this idealized depiction, with actor Morgan Freeman embodying a paternalistic healer of divisions.[](https://www.hollywoodreporter.com/gallery/nelson-mandela-apartheid-13-hollywood-576587/) Critics argue these representations elevate Mandela to secular sainthood, sidelining the ANC's violent campaigns and policy trade-offs, a tendency amplified in Western media after the Cold War when his communist ties became less salient.[](https://jacobin.com/2013/12/the-two-mandelas/) Following his death on December 5, 2013, global leaders issued tributes framing him as a timeless icon of humanity, prompting reflections that such uncritical adulation risks obscuring the pragmatic, sometimes compromised realities of his leadership.[](https://www.bbc.com/news/world-africa-25250082) [](https://www.atlanticcouncil.org/blogs/new-atlanticist/the-enormity-of-mandelas-struggle/)\n\n### Balanced Assessments: Achievements vs. Persistent South African Challenges\n\nMandela's leadership enabled a negotiated transition from apartheid to democracy, averting a potential civil war through dialogue with the National Party government and the establishment of a multiracial constitution in 1996.[](https://www.cfr.org/expert-brief/how-mandela-changed-south-africa) His administration oversaw the 1994 elections, the first under universal suffrage, which installed him as president and laid the groundwork for rule of law in a previously segregated society.[](https://www.dw.com/en/nelson-mandelas-mixed-legacy/a-44691481) The Truth and Reconciliation Commission (TRC), initiated in 1995, facilitated confessions and amnesty for politically motivated crimes from 1960 to 1994, fostering a measure of national healing and preventing cycles of revenge that plagued other post-colonial transitions.[](https://www.collegesoflaw.edu/blog/2019/01/08/trc-south-africa-study-abroad/) Assessments of the TRC highlight its role in building democratic stability, though critics note its partiality in prioritizing political over gross human rights violations and limited reparative justice for victims.[](https://scholarship.law.ufl.edu/cgi/viewcontent.cgi?article=1396\u0026context=fjil)[](https://www.researchgate.net/publication/231927464_Evaluating_the_Truth_and_Reconciliation_Commission)\n\nEconomically, Mandela's era (1994–1999) saw initial stabilization and growth averaging around 3% annually, with policies like the Reconstruction and Development Programme expanding access to housing, water, and electricity for millions of previously underserved black South Africans.[](https://www.idc.co.za/wp-content/uploads/2018/11/IDC-RI-publication-Overview-of-key-trends-in-SA-economy-since-1994.pdf)[](https://www.theguardian.com/world/2019/may/05/south-africa-reaches-new-crossroads-25-years-after-free-elections) However, the shift to the more market-oriented Growth, Employment and Redistribution (GEAR) strategy in 1996 reflected pragmatic retreats from initial socialist ambitions, yet failed to generate sufficient job creation or dismantle apartheid-era economic structures dominated by white-owned capital.[](https://www.almendron.com/tribuna/why-some-south-africans-are-rethinking-nelson-mandelas-legacy/)\n\nDespite these political milestones, South Africa under and after Mandela has faced entrenched socioeconomic stagnation. Inequality remains extreme, with the Gini coefficient at 0.63–0.67 as of 2018–2023, reflecting minimal redistribution of wealth and low intergenerational mobility.[](https://www.worldbank.org/en/country/southafrica/overview)[](https://datacommons.org/place/country/ZAF) GDP growth has averaged just 0.8% annually since 2012, far below rates needed to absorb a growing labor force, while unemployment has climbed from around 20% in 1994 to over 32% by 2024, exacerbating youth joblessness above 60%.[](https://www.reuters.com/graphics/SAFRICA-ELECTION/ECONOMY/egpbonzrgvq/)\n\n| Indicator              | Mid-1990s (Mandela Era) | 2020s                  |\n|------------------------|--------------------------|------------------------|\n| Gini Coefficient      | ~0.59                   | 0.63                   |\n| Unemployment Rate     | ~20–23%                 | ~32–33%                |\n| GDP Growth (Annual Avg)| ~2–3%                   | \u003c1% since 2012         |\n\nPoverty persists for over half the population when accounting for multidimensional metrics, with crime rates—particularly murders—surging post-1994 to levels exceeding the apartheid transition's political violence peak, reaching 45 per 100,000 by the early 2020s amid failures in policing and socioeconomic policy.[](https://www.aljazeera.com/news/2024/4/27/south-africa-30-years-after-apartheid-what-has-changed)[](https://issafrica.org/iss-today/is-south-africa-s-crime-problem-turning-around) These outcomes stem partly from ANC governance prioritizing elite empowerment over broad-based reforms, sowing seeds of corruption that intensified under successors, prompting reevaluations of Mandela's legacy as insufficiently attuned to causal drivers of inequality like skills mismatches and property rights distortions.[](https://www.washingtonpost.com/opinions/2024/04/23/south-africa-elections-nelson-mandela-anc-corruption/)[](https://www.almendron.com/tribuna/why-some-south-africans-are-rethinking-nelson-mandelas-legacy/) While global narratives emphasize reconciliation triumphs, empirical data underscores how unaddressed structural legacies have perpetuated a \"rainbow nation\" in name but not in equitable outcomes.[](https://www.imf.org/en/News/Articles/2020/01/29/na012820six-charts-on-south-africas-persistent-and-multi-faceted-inequality)\n\n### Influence in Media, Biographies, and Cultural Depictions\n\nMandela's portrayal in international media following his release from prison on February 11, 1990, emphasized themes of forgiveness and reconciliation, often framing him as a moral exemplar who transcended personal bitterness despite 27 years of incarceration. Coverage in outlets like *The New York Times* and BBC highlighted his role in averting civil war through negotiations with the National Party government, culminating in the 1994 multiracial elections where he secured 62.65% of the vote. This narrative contributed to his status as a global icon, with Time magazine naming him \"Man of the Year\" in 1993, yet critics have noted a tendency toward hagiography that downplays his pre-1990 advocacy for armed resistance via Umkhonto we Sizwe (MK), including church bombings in the 1980s that killed civilians.[](https://www.atlanticcouncil.org/blogs/new-atlanticist/the-enormity-of-mandelas-struggle/)[](https://ethicsalarms.com/2013/12/07/nelson-mandela-john-brown-and-the-perils-of-hagiography/)[](https://billmuehlenberg.com/2013/12/06/nelson-mandela/)\n\nBiographical works on Mandela vary in depth and perspective, with his own *Long Walk to Freedom* (published 1994) presenting a first-person account of his evolution from militant activism to negotiated settlement, drawing on prison notebooks smuggled out over decades. Authorized biographies, such as Anthony Sampson's *Mandela: The Authorized Biography* (1999), have faced criticism for relying heavily on Mandela's self-narration and ANC-approved sources, resulting in limited scrutiny of internal party decisions or personal failings like his strained family relations. More critical analyses, including R.W. Johnson's review in the *London Review of Books*, argue that such works exhibit pro-ANC bias, omitting details of Mandela's undisclosed South African Communist Party membership from 1962 and the strategic compromises that preserved economic structures favoring white capital. Independent efforts, like those in academic journals, urge a \"humanized\" approach to counter saintly idealization, acknowledging his strategic pragmatism amid ideological commitments to socialism.[](https://www.lrb.co.uk/the-paper/v21/n16/r.w.-johnson/an-unreliable-friend)[](http://www.scielo.org.za/scielo.php?script=sci_arttext\u0026pid=S0259-94222015000100051)\n\nCultural depictions have amplified Mandela's image through films, music, and visual arts, often focusing on his imprisonment and triumphant release while eliding operational details of the anti-apartheid struggle. Hollywood productions like *Invictus* (2009), directed by Clint Eastwood and starring Morgan Freeman as Mandela, centered on his use of the 1995 Rugby World Cup to foster national unity, grossing $122 million worldwide and earning two Academy Awards. *Mandela: Long Walk to Freedom* (2013), adapted from his autobiography with Idris Elba in the lead role, portrayed his life arc but drew mixed reviews for softening the violence of MK campaigns. In music, tracks such as The Specials' \"Nelson Mandela\" (1984) and Artists United Against Apartheid's \"Sun City\" (1985) mobilized global awareness, influencing boycott campaigns that pressured South Africa's economy until 1990. Visual arts include widespread statues, such as the 9-foot bronze bust in London's South Bank (unveiled 2007), and Soviet-era stamps commemorating his 70th birthday in 1988, reflecting Cold War ideological alignments. These representations, while inspirational, have been faulted for perpetuating a selective narrative that prioritizes reconciliation over the causal role of sanctions, internal unrest, and geopolitical shifts in apartheid's end.[](https://lithub.com/how-nelson-mandela-became-a-pop-cultural-icon-through-music/)[](https://www.today.com/popculture/nelson-mandela-legacy-includes-lasting-mark-pop-culture-2d11702786)[](https://www.cbc.ca/news/entertainment/nelson-mandela-a-muse-and-inspiration-for-artists-worldwide-1.2452747)[](https://jacobin.com/2013/12/the-two-mandelas/)"])</script><script nonce="Yzc3ODQ1MzItMTYyZC00ZTgxLTk1ODYtZDljZGJhZDU5OGFi">self.__next_f.push([1,"8:[\"$\",\"$L1f\",null,{\"state\":{\"mutations\":[],\"queries\":[{\"dehydratedAt\":1761676297494,\"state\":{\"data\":{\"page\":{\"citations\":[{\"id\":\"1\",\"title\":\"Nelson Mandela – Biographical - NobelPrize.org\",\"description\":\"Nelson Rolihlahla Mandela was born in Transkei, South Africa on July 18, 1918. His father was Hendry Mphakanyiswa of the Tembu Tribe. Mandela himself was ...\",\"url\":\"https://www.nobelprize.org/prizes/peace/1993/mandela/biographical/\",\"favicon\":\"\"},{\"id\":\"2\",\"title\":\"Biography of Nelson Mandela\",\"description\":\"In 1993 he and President FW de Klerk jointly won the Nobel Peace Prize and ... He died at his home in Johannesburg on 5 December 2013. 1. Nelson Mandela's father ...\",\"url\":\"https://www.nelsonmandela.org/biography\",\"favicon\":\"\"},{\"id\":\"3\",\"title\":\"uMkhonto weSizwe (MK) - South African History Online\",\"description\":\"Mar 20, 2011 · On 16 December, 1961, Umkhonto weSizwe (MK) was launched as an armed wing of the African National Congress (ANC).\",\"url\":\"https://sahistory.org.za/article/umkhonto-wesizwe-mk\",\"favicon\":\"\"},{\"id\":\"4\",\"title\":\"Nelson Mandela – Speed read - NobelPrize.org\",\"description\":\"Nelson Mandela was awarded the Nobel Peace Prize, jointly with Frederik Willem de Klerk, for his work for the peaceful termination of the apartheid regime.\",\"url\":\"https://www.nobelprize.org/prizes/peace/1993/mandela/speedread/\",\"favicon\":\"\"},{\"id\":\"5\",\"title\":\"Nelson Mandela was a member of the South African Communist Party\",\"description\":\"Jun 29, 2015 · A document has been discovered in a Russian archive proving that Nelson Mandela was a member of the South African Communist Party (SACP) in the early 1960s.\",\"url\":\"https://www.ascleiden.nl/news/research-stephen-ellis-confirmed-nelson-mandela-was-member-south-african-communist-party\",\"favicon\":\"\"},{\"id\":\"6\",\"title\":\"Why Nelson Mandela Was on Terror Watch Lists Until 2008 | TIME\",\"description\":\"Jul 18, 2018 · Since its founding in 1912, “the ANC fought against apartheid for decades through rigorously nonviolent means, mostly labor strikes and public ...\u003c|separator|\u003e\",\"url\":\"https://time.com/5338569/nelson-mandela-terror-list/\",\"favicon\":\"\"},{\"id\":\"7\",\"title\":\"Nelson Mandela Fast Facts - CNN\",\"description\":\"Dec 11, 2012 · Death date: December 5, 2013. Birth place: Mvezo, Transkei ... Gadla Henry Mphakanyiswa, a counselor to the royal house of the Thembu tribe.\",\"url\":\"https://www.cnn.com/2012/12/11/africa/nelson-mandela-fast-facts\",\"favicon\":\"\"},{\"id\":\"8\",\"title\":\"Mandela's memories of Qunu, his childhood village\",\"description\":\"Dec 12, 2013 · “I was no more than five when I became a herd-boy, looking after sheep and calves in the fields,” Mandela said. Typically long- and sharp-horned ...\",\"url\":\"https://brandsouthafrica.com/94333/mandela-day-month/photos-mandela-remembers-qunu-his-childhood-village/\",\"favicon\":\"\"},{\"id\":\"9\",\"title\":\"Qunu: the place where Nelson Mandela was at home - The Guardian\",\"description\":\"Dec 6, 2013 · \\\"Some of the happiest years of my boyhood were spent in Qunu,\\\" Mandela wrote. ... Mandela was a herd boy, looking after sheep and calves in the ...\",\"url\":\"https://www.theguardian.com/world/2013/dec/06/qunu-nelson-mandela-home\",\"favicon\":\"\"},{\"id\":\"10\",\"title\":\"timeline - Nelson Mandela Foundation\",\"description\":\"1934. Undergoes initiation; Attends Clarkebury Boarding Institute in Engcobo. 1937. Attends Healdtown, the Wesleyan College at Fort Beaufort. 1939. Enrols at ...\",\"url\":\"https://www.nelsonmandela.org/timeline-2\",\"favicon\":\"\"},{\"id\":\"11\",\"title\":\"Nelson Mandela 1918-2013: the timeline of a lifetime\",\"description\":\"Sep 27, 2024 · A timeline of the 95-year life of Nelson Rolihlahla Mandela – revolutionary, soldier, political prisoner, president of South Africa, statesman and global icon ...\",\"url\":\"https://southafrica-info.com/history/nelson-mandela-timeline/\",\"favicon\":\"\"},{\"id\":\"12\",\"title\":\"The mission schoolboy - Nelson Mandela and missionary education\",\"description\":\"When Nelson Mandela first arrived at Clarkebury in 1934 his self-confidence took a beating. This was because he found it uneasy to walk in the first pair of ...\",\"url\":\"https://www.theheritageportal.co.za/article/mission-schoolboy-nelson-mandela-and-missionary-education\",\"favicon\":\"\"},{\"id\":\"13\",\"title\":\"Healdtown Mission Institute and the struggle for South Africa's freedom\",\"description\":\"Sep 23, 2018 · It was, at the time, the largest African school south of the equator, with more than a thousand learners, both male and female. Its gracefully ...\",\"url\":\"https://www.theheritageportal.co.za/article/upon-eagles-wings-healdtown-mission-institute-and-struggle-south-africas-freedom\",\"favicon\":\"\"},{\"id\":\"14\",\"title\":\"A Virtual Exhibition on the Life and Times of Nelson Mandela\",\"description\":\"\\\"This is the earliest photograph of Nelson Mandela. From his time at Healdown School which he attended in 1937 and 1938.\\\" Razia Saleh, Director of archive.\",\"url\":\"https://artsandculture.google.com/story/a-virtual-exhibition-on-the-life-and-times-of-nelson-mandela-nelson-mandela-centre-of-memory/7wURCwoZmy8vJw?hl=en\",\"favicon\":\"\"},{\"id\":\"15\",\"title\":\"History - University of Fort Hare | Together in Excellence\",\"description\":\"Nelson Mandela leaves the university. Oliver Tambo is awarded a Bachelor of Science degree.\",\"url\":\"https://www.ufh.ac.za/about-us/history\",\"favicon\":\"\"},{\"id\":\"16\",\"title\":\"Nelson Mandela Timeline 1940-1949 | South African History Online\",\"description\":\"The head of the University gave him a choice: either he accepts the post or he leaves the university. He was given until the end of the university holidays to ...\",\"url\":\"https://sahistory.org.za/article/nelson-mandela-timeline-1940-1949\",\"favicon\":\"\"},{\"id\":\"17\",\"title\":\"Biography - Nelson Mandela University\",\"description\":\"Here he became involved in student politics and was expelled in 1940 as a result of participating in a student protest. On moving to Johannesburg, he was ...\",\"url\":\"https://www.mandela.ac.za/About-us/Nelson-Mandela-The-Man/Biography\",\"favicon\":\"\"},{\"id\":\"18\",\"title\":\"Mandela's Joburg - Johannesburg Development Agency\",\"description\":\"Dec 2, 2013 · In 1941, Mandela made his way to Johannesburg and his first job in the city was that of a night watchman at Crown Mines. Madiba was later ...\",\"url\":\"https://www.jda.org.za/mandelas-joburg/\",\"favicon\":\"\"},{\"id\":\"19\",\"title\":\"Learners' biography - Nelson Mandela Foundation\",\"description\":\"His first job in 1941 was as a security guard on a gold mine and then as a legal clerk in the law firm Witkin, Edelman and Sidelsky. At the same time he ...\",\"url\":\"https://www.nelsonmandela.org/learners-biography\",\"favicon\":\"\"},{\"id\":\"20\",\"title\":\"Chronology - Nelson Mandela\",\"description\":\"This is an attempt to list some of the achievements of former President Nelson Mandela and the events that influenced his life in chronological order.Missing:  education | Show results with:education\",\"url\":\"http://www.mandela.gov.za/chronology/\",\"favicon\":\"\"},{\"id\":\"21\",\"title\":\"Biography of Nelson Mandela | SAnews\",\"description\":\"Dec 6, 2013 · Mandela was introduced to Walter Sisulu in 1941 and it was Sisulu who arranged for him to do his articles at Lazar Sidelsky's law firm.\",\"url\":\"https://www.sanews.gov.za/features-south-africa/biography-nelson-mandela\",\"favicon\":\"\"},{\"id\":\"22\",\"title\":\"Mandela the Lawyer\",\"description\":\"Mandela told Sisulu that he wanted to study law, so Sisulu introduced him to attorney Lazar Sidelsky, who agreed to take him on as an articled clerk, (today ...\",\"url\":\"https://www.lawyer.co.za/Mandela.html\",\"favicon\":\"\"},{\"id\":\"23\",\"title\":\"The 46-year-long Wits LLB that never was\",\"description\":\"Sep 13, 2018 · Mandela was a law student at Wits University from 1943 to 1949 but failed the final examination on three occasions between 1947 and 1949.\",\"url\":\"https://www.wits.ac.za/curiosity/stories/the-46-year-long-wits-llb-that-never-was.html\",\"favicon\":\"\"},{\"id\":\"24\",\"title\":\"Our History - African National Congress Youth Legue\",\"description\":\"Established on 2 April 1944, the ANCYL was founded by a group of young leaders, including Anton Lembede (its first President), Nelson Mandela, Ashby Mda, Walter ...\",\"url\":\"https://ancylekurhuleni.org/our-history/\",\"favicon\":\"\"},{\"id\":\"25\",\"title\":\"The Group Areas Act of 1950 | South African History Online\",\"description\":\"Dec 19, 2014 · The Group Areas Act was fashioned as the “cornerstone” of Apartheid policy and aimed to eliminate mixed neighbourhoods in favour of racially segregated ones.\",\"url\":\"https://sahistory.org.za/article/group-areas-act-1950\",\"favicon\":\"\"},{\"id\":\"26\",\"title\":\"ANC adopts the Programme of Action | South African History Online\",\"description\":\"Mar 16, 2011 · The Programme of Action called on the ANC to embark on mass action, involving civil disobedience, strikes, boycotts and other forms of non-violent resistance.\",\"url\":\"https://sahistory.org.za/dated-event/anc-adopts-programme-action\",\"favicon\":\"\"},{\"id\":\"27\",\"title\":\"Defiance Campaign 1952: The Story of Defiance – ANC\",\"description\":\"With them to the gaol went defiance leaders Yusuf Cachalia and Nelson Mandela. The first groups of Defiers came up before the magistrate and were sentenced ...\",\"url\":\"https://www.anc1912.org.za/defiance-campaign-1952-the-story-of-defiance/\",\"favicon\":\"\"},{\"id\":\"28\",\"title\":\"The Defiance Campaign in South Africa, recalled – ANC\",\"description\":\"Nelson Mandela, President of the ANC Youth League, was appointed Volunteer-in-Chief of the Campaign. His outstanding qualities as a mass leader led to his ...\",\"url\":\"https://www.anc1912.org.za/defiance-campaign-1952-the-defiance-campaign-in-south-africa-recalled/\",\"favicon\":\"\"},{\"id\":\"29\",\"title\":\"Defiance Campaign 1952 | South African History Online\",\"description\":\"Mar 21, 2011 · The first group of volunteers including Nelson Mandela, Yusuf Dadoo, Moses Kotane, J.B. Marks, David Bopape and Walter Sisulu defied ...The defiance campaign by... · Defiance by Norman Levy · Transvaal Indian Youth...\",\"url\":\"https://sahistory.org.za/article/defiance-campaign-1952\",\"favicon\":\"\"},{\"id\":\"30\",\"title\":\"Nelson Rolihlahla Mandela | South African History Online\",\"description\":\"In 1934, at 16 years old, Mandela went to initiation school to undergo ulwaluko, a traditional ceremony that whereby young boys transition into manhood (For ...Nelson Mandela Timeline... · Nelson Mandela Family Tree\",\"url\":\"https://sahistory.org.za/people/nelson-rolihlahla-mandela\",\"favicon\":\"\"},{\"id\":\"31\",\"title\":\"Congress of the People and the Freedom Charter\",\"description\":\"Mar 21, 2011 · The Congress of the People constituted the most representative gathering in the history of South Africa. It adopted the Freedom Charter, a vision for a united, ...\",\"url\":\"https://sahistory.org.za/article/congress-people-and-freedom-charter\",\"favicon\":\"\"},{\"id\":\"32\",\"title\":\"(1955) The South African Freedom Charter | BlackPast.org\",\"description\":\"The Freedom Charter. Adopted at the Congress of the People, Kliptown, on 26 June 1955. We, the People of South Africa, declare for all our country and the ...\",\"url\":\"https://blackpast.org/global-african-history/african-national-congress-freedom-charter/\",\"favicon\":\"\"},{\"id\":\"33\",\"title\":\"[PDF] mda02. 'Free Nelson Mandela!' leaflet\",\"description\":\"Though unable to be present at Kliptown, due to a banning order, Mandela was at the forefront of this activity, and in 1956 was one of the 156 people accused ...\u003c|control11|\u003e\u003c|separator|\u003e\",\"url\":\"https://www.aamarchives.org/archive/history/1960s/mda02-free-nelson-mandela/download.html\",\"favicon\":\"\"},{\"id\":\"34\",\"title\":\"Treason Trial 1956 - 1961 | South African History Online\",\"description\":\"Mar 31, 2011 · 156 Congress leaders were arrested and put on trial for high treason. The swoop came in the early hours of the morning of 5 December and was executed with ...Missing:  Nelson | Show results with:Nelson\",\"url\":\"https://sahistory.org.za/article/treason-trial-1956-1961\",\"favicon\":\"\"},{\"id\":\"35\",\"title\":\"Nelson Mandela's Testimony at the Treason Trial 1956-60\",\"description\":\"The Treason Trial was in its fourth year when the shootings at Sharpeville took place on 21 March 1960. Sixty-nine Africans were killed and 176 wounded.Missing:  details | Show results with:details\",\"url\":\"https://omalley.nelsonmandela.org/index.php/site/q/03lv01538/04lv01600/05lv01615/06lv01616.htm\",\"favicon\":\"\"},{\"id\":\"36\",\"title\":\"Trials and prisons chronology - Nelson Mandela Foundation\",\"description\":\"After a four-and-a-half-year trial, where he and scores of other people were charged with high treason, Mandela and the last 27 remaining accused are acquitted.\",\"url\":\"https://www.nelsonmandela.org/trials-and-prison-chronology\",\"favicon\":\"\"},{\"id\":\"37\",\"title\":\"Chronology | The Long Walk Of Nelson Mandela | FRONTLINE - PBS\",\"description\":\"In response to the new apartheid policies, the ANC Youth League drafts a Program of Action calling for mass strikes, boycotts, protests and passive resistance.Missing:  Programme | Show results with:Programme\",\"url\":\"https://www.pbs.org/wgbh/pages/frontline/shows/mandela/etc/cron.html\",\"favicon\":\"\"},{\"id\":\"38\",\"title\":\"Mandela on Trial | Facing History \u0026 Ourselves\",\"description\":\"Jul 31, 2018 · But if peaceful protest is met with violence, its efficacy is at an end. For me, nonviolence was not a moral principle but a strategy; there is ...Missing:  1955-1961 | Show results with:1955-1961\",\"url\":\"https://www.facinghistory.org/resource-library/mandela-trial\",\"favicon\":\"\"},{\"id\":\"39\",\"title\":\"The armed struggle and state repression of the 1960s\",\"description\":\"The ANC formed an armed organisation, Umkhonto we Sizwe (MK), and started a sabotage campaign. The ANC was against killing people, and rather burnt down power ...\",\"url\":\"https://sahistory.org.za/article/armed-struggle-and-state-repression-1960s\",\"favicon\":\"\"},{\"id\":\"40\",\"title\":\"5. The ANC: Stages of Struggle and Policy Foundations, 1960-1994\",\"description\":\"Umkhonto we Sizwe (MK) was preceded by a Committee for National Liberation, subsequently calling itself the African Resistance Movement, which included members ...\",\"url\":\"https://omalley.nelsonmandela.org/index.php/site/q/03lv02167/04lv02264/05lv02303/06lv02304/07lv02305/08lv02311.htm\",\"favicon\":\"\"},{\"id\":\"41\",\"title\":\"Violence, Political Strategy and the Turn to Guerrilla Warfare by the ...\",\"description\":\"Oct 4, 2021 · The Sabotage Campaign and the Militarisation of the Congress Movement, 1961–62. On 16 December 1961, Umkhonto we Sizwe announced its existence ...\",\"url\":\"https://www.tandfonline.com/doi/full/10.1080/03057070.2021.1974224\",\"favicon\":\"\"},{\"id\":\"42\",\"title\":\"Nelson Mandela's Statement from the Dock at the Opening ... - UN.org.\",\"description\":\"Umkhonto was to perform sabotage, and strict instructions were given to its ... But when in 1961 the Umkhonto was formed, and a new phase of struggle ...\",\"url\":\"https://www.un.org/en/events/mandeladay/court_statement_1964.shtml\",\"favicon\":\"\"},{\"id\":\"43\",\"title\":\"LILIESLEAF FARM - SAHRA 2025\",\"description\":\"Dec 2, 2016 · Liliesleaf subsequently became the headquarters of MK and a crucible for the Liberation Struggle.\",\"url\":\"https://www.sahra.org.za/liliesleaf-farm/\",\"favicon\":\"\"},{\"id\":\"44\",\"title\":\"Manifesto of Umkhonto we Sizwe - The O'Malley Archives\",\"description\":\"Leaflet issued by the Command of Umkhonto we Sizwe, 16th December 1961. Units of Umkhonto we Sizwe today carried out planned attacks against government ...\",\"url\":\"https://omalley.nelsonmandela.org/index.php/site/q/03lv02424/04lv02730/05lv02918/06lv02950.htm\",\"favicon\":\"\"},{\"id\":\"45\",\"title\":\"A Brief Historical Overview of Umkhonto we Sizwe (MK), 1961–1994\",\"description\":\"Nelson Mandela was to feature prominently in these efforts and was, himself, to receive military training abroad in Algeria and Ethiopia between 1961 and 1962.\u003c|separator|\u003e\",\"url\":\"http://samilitaryhistory.org/vol115rw.html\",\"favicon\":\"\"},{\"id\":\"46\",\"title\":\"The Sabotage Campaign - The O'Malley Archives\",\"description\":\"The sabotage campaign began when we launched Umkhonto, and continued until 1963. This period from 1961 to 1963, was a particular phase in the life of Umkhonto.\",\"url\":\"https://omalley.nelsonmandela.org/index.php/site/q/03lv02424/04lv02730/05lv02918/06lv02946.htm\",\"favicon\":\"\"},{\"id\":\"47\",\"title\":\"Turn to Sabotage by The Congress Movement in South Africa*\",\"description\":\"Oct 3, 2019 · ... and violence will no longer be met with non-violent resistance only! ... Mandela, Sisulu and most other Congress leaders remained committed ...\",\"url\":\"https://academic.oup.com/past/article/245/1/221/5580560\",\"favicon\":\"\"},{\"id\":\"48\",\"title\":\"Nelson Mandela travels through Africa\",\"description\":\"May 31, 2022 · He travelled for months to different countries such as Botswana, Tanzania, Ethiopia, Ghana, and Nigeria. In 1961 the ANC and Pan Africanist ...\",\"url\":\"https://www.nelsonmandela.org/news/entry/nelson-mandela-travels-through-africa\",\"favicon\":\"\"},{\"id\":\"49\",\"title\":\"(1962) Nelson Mandela, \\\"Address at the Conference of the Pan ...\",\"description\":\"Jul 5, 2010 · In January 1962, Nelson Mandela, the emerging leader of the South African campaign against apartheid, spoke at a convention of Pan African ...\",\"url\":\"https://blackpast.org/global-african-history/1962-nelson-mandela-address-conference-pan-african-freedom-movement-east-and-central-africa/\",\"favicon\":\"\"},{\"id\":\"50\",\"title\":\"Nelson Mandela Timeline 1960-1969 | South African History Online\",\"description\":\"26 June, Mandela and Tambo arrive in Addis Ababa to recieve military training, which was meant to last six months. 24 July, Mandela returned to South Africa ...Missing:  itinerary | Show results with:itinerary\",\"url\":\"https://sahistory.org.za/article/nelson-mandela-timeline-1960-1969\",\"favicon\":\"\"},{\"id\":\"51\",\"title\":\"Nelson Mandela in Sudan: A historic 1962 journey - Daily Maverick\",\"description\":\"Jul 17, 2020 · Mandela used the Ethiopian passport on the tour that took him to North and West Africa. He visited Egypt, Libya, Tunisia, Morocco, Mali, Guinea, ...\",\"url\":\"https://www.dailymaverick.co.za/article/2020-07-17-nelson-mandela-in-sudan-a-historic-1962-journey/\",\"favicon\":\"\"},{\"id\":\"52\",\"title\":\"African Footprint - Mandela International Office\",\"description\":\"Mandela's plan was to meet African leaders, introduce the ANC and clarify its policies, and explain ANC's strategic shift from non-violence to armed struggle.\",\"url\":\"https://international.mandela.ac.za/About-Us/African-Footprint\",\"favicon\":\"\"},{\"id\":\"53\",\"title\":\"Mandela and the South African Communist Party\",\"description\":\"Jun 11, 2018 · In the 1950s ANC membership was restricted to Black Africans, and the Communist Party remained the only partner in the alliance with an open ...\",\"url\":\"https://sahistory.org.za/article/mandela-and-south-african-communist-party\",\"favicon\":\"\"},{\"id\":\"54\",\"title\":\"uMkhonto weSizwe (MK) Timeline 1961-1990\",\"description\":\"MK commanders who were active in the early 1961-64 sabotage campaigns are released from Robben Island. Among them are Joe Gqabi, Indres Naidoo, Ismail ...\",\"url\":\"https://sahistory.org.za/article/umkhonto-wesizwe-mk-timeline-1961-1990\",\"favicon\":\"\"},{\"id\":\"55\",\"title\":\"Mandela and the Communist Party - Martin Plaut\",\"description\":\"Feb 25, 2015 · I did not need to become a communist in order to work with them. I find that African nationalists and African communists generally had far more ...\",\"url\":\"https://martinplaut.com/2015/02/25/mandela-and-the-communist-party/\",\"favicon\":\"\"},{\"id\":\"56\",\"title\":\"Nelson Mandela Trial (1963-64)\",\"description\":\"It's \\\"the trial that changed South Africa.\\\" In the fall of 1963, Nelson Mandela and ten other leading opponents of South Africa's apartheid regime went on ...Missing:  facts | Show results with:facts\",\"url\":\"https://www.famous-trials.com/nelsonmandela\",\"favicon\":\"\"},{\"id\":\"57\",\"title\":\"Rivonia Trial 1963 - 1964 | South African History Online\",\"description\":\"Mandela, Sisulu, Mbeki, Motsoaledi, Mlangeni, and Goldberg were found guilty on all four counts. The defense had hoped that Mahlaba, Kathrada, and Bernstein ...People involved in Rivonia... · Speeches and Public... · Letters\",\"url\":\"https://sahistory.org.za/article/rivonia-trial-1963-1964\",\"favicon\":\"\"},{\"id\":\"58\",\"title\":\"One day back in '63 at Liliesleaf | The Heritage Portal\",\"description\":\"The top leadership of the ANC were arrested at Liliesleaf on 11 July 1963. The apartheid government was smug - they had seized and put away for life the top ...\",\"url\":\"https://www.theheritageportal.co.za/article/one-day-back-63-liliesleaf\",\"favicon\":\"\"},{\"id\":\"59\",\"title\":\"Nelson Mandela sentenced to life imprisonment 44 years ago\",\"description\":\"Jun 10, 2008 · Forty-four years ago, on June 12, 1964, Nelson Mandela and seven of his comrades were jailed for life in what became known as the Rivonia Trial.\",\"url\":\"https://www.nelsonmandela.org/news/entry/nelson-mandela-sentenced-to-life-imprisonment-44-years-ago\",\"favicon\":\"\"},{\"id\":\"60\",\"title\":\"[PDF] Prisoner - Apartheid Museum\",\"description\":\"Life was gruelling on Robben Island. Mandela's group of prisoners arrived in mid-1964, the coldest winter in South. Africa for 30 years. As leaders, they ...\",\"url\":\"https://www.apartheidmuseum.org/uploads/files/PRISONER-theme4.pdf\",\"favicon\":\"\"},{\"id\":\"61\",\"title\":\"[PDF] Robben Island Prison Dossier 1964 – 1974 - Marxists Internet Archive\",\"description\":\"Nelson Mandela was sentenced to life imprisonment, along with fellow Rivonia treason trialists, in 1964. He was incarcerated on Robben Island from 1964.\",\"url\":\"https://www.marxists.org/archive/alexander/rip-dossier.pdf\",\"favicon\":\"\"},{\"id\":\"62\",\"title\":\"In His Own Words: Nelson Mandela's Prison Years\",\"description\":\"Mr Mandela and seven others were sentenced to life imprisonment on 12 June 1964. He remained on Robben Island until the end of March 1982 after which he was ...\",\"url\":\"https://artsandculture.google.com/story/in-his-own-words-nelson-mandela-s-prison-years-nelson-mandela-centre-of-memory/IwWB0EVYSJpvJg?hl=en-US\",\"favicon\":\"\"},{\"id\":\"63\",\"title\":\"Mandela's 'Robben Island University' - Brand South Africa\",\"description\":\"Jul 10, 2013 · When several pages were discovered by prison warders, his study privileges were revoked for four years, and he could only resume his LLB studies ...\",\"url\":\"https://brandsouthafrica.com/102976/mandela-day-month/robbenisland-university/\",\"favicon\":\"\"},{\"id\":\"64\",\"title\":\"Mandela death: How a prisoner became a legend - BBC News\",\"description\":\"Dec 7, 2013 · For three decades in Robben Island there was an epic leadership battle in the ANC for supremacy between the African nationalists, led by Mandela ...\",\"url\":\"https://www.bbc.com/news/magazine-25256818\",\"favicon\":\"\"},{\"id\":\"65\",\"title\":\"\",\"description\":\"\",\"url\":\"https://oxfordre.com/africanhistory/display/10.1093/acrefore/9780190277734.001.0001/acrefore-9780190277734-e-686\",\"favicon\":\"\"},{\"id\":\"66\",\"title\":\"The Mandela I knew: Prof Saths Cooper - Nelson Mandela Foundation\",\"description\":\"Dec 12, 2013 · In many ways, the ANC in Robben Island was different to the ANC outside those prison walls, as most of the information only reached prison much ...Missing:  debates | Show results with:debates\",\"url\":\"https://www.nelsonmandela.org/news/entry/the-mandela-i-knew-prof-saths-cooper\",\"favicon\":\"\"},{\"id\":\"67\",\"title\":\"\",\"description\":\"\",\"url\":\"https://www.pbs.org/wgbh/pages/frontline/shows/mandela/prison/alexander.html\",\"favicon\":\"\"},{\"id\":\"68\",\"title\":\"Nelson Mandela: The prison years | Sky HISTORY TV Channel\",\"description\":\"A month later he was taken to hospital after contracting tuberculosis - the damp conditions of his prison cell exacerbating the disease. His time at Pollsmoor ...Missing:  health | Show results with:health\",\"url\":\"https://www.history.co.uk/article/nelson-mandela-the-prison-years\",\"favicon\":\"\"},{\"id\":\"69\",\"title\":\"In History: Nelson Mandela walks out of prison a free man - BBC\",\"description\":\"Feb 7, 2024 · In 1982 he was moved to Pollsmoor Prison in Cape Town, where the damp conditions contributed to him being hospitalised with tuberculosis in 1988 ...\",\"url\":\"https://www.bbc.com/culture/article/20240207-in-history-nelson-mandela-walks-out-of-prison-a-free-man\",\"favicon\":\"\"},{\"id\":\"70\",\"title\":\"Mandela's health scares over the years | AWANI International\",\"description\":\"Mandela had surgery in 1985 for an enlarged prostate gland that had caused a urinary blockage. In 2001, he received radiotherapy treatment for prostate cancer ...\",\"url\":\"https://international.astroawani.com/global-news/mandelas-health-scares-over-years-17135\",\"favicon\":\"\"},{\"id\":\"71\",\"title\":\"Nelson Mandela's Prison Adventures : Parallels - NPR\",\"description\":\"Jul 2, 2013 · Mandela came down with tuberculosis in 1988 and spent six weeks recuperating at a hospital and the whites-only Constantiaberg Clinic outside ...\",\"url\":\"https://www.npr.org/sections/parallels/2013/07/01/197674511/nelson-mandelas-prison-adventures\",\"favicon\":\"\"},{\"id\":\"72\",\"title\":\"Mandela Hospitalized With Tuberculosis, Lawyer Says\",\"description\":\"Aug 17, 1988 · Nelson R. Mandela, the imprisoned leader of the African National Congress, is suffering from tuberculosis, his lawyer said today.\",\"url\":\"https://www.nytimes.com/1988/08/17/world/mandela-hospitalized-with-tuberculosis-lawyer-says.html\",\"favicon\":\"\"},{\"id\":\"73\",\"title\":\"Mandela in Solitary\",\"description\":\"Dec 7, 2013 · In 1988, after spending time in the hospital for tuberculosis, he was moved to Victor Verster Prison, where he lived under less harsh and ...\",\"url\":\"https://solitarywatch.org/2013/12/07/mandela-solitary/\",\"favicon\":\"\"},{\"id\":\"74\",\"title\":\"Nelson Mandela spent 27 years in prison, and during that time, we ...\",\"description\":\"Jul 17, 2025 · Victor Verster Prison (1988-1990): Mandela was moved to Victor Verster Prison, where he was given a private cell and allowed to receive visitors ...\",\"url\":\"https://www.facebook.com/ICRC/posts/nelson-mandela-spent-27-years-in-prison-and-during-that-time-we-visited-him-regu/1204911435009304/\",\"favicon\":\"\"},{\"id\":\"75\",\"title\":\"\",\"description\":\"\",\"url\":\"https://artsandculture.google.com/story/a-unique-bond-nelson-mandela-and-his-last-warder-nelson-mandela-centre-of-memory/7wWRwcfzXslfIg?hl=en-US\",\"favicon\":\"\"},{\"id\":\"76\",\"title\":\"MEETINGS BETWEEN NELSON MANDELA AND THE PW BOTHA ...\",\"description\":\"The first meeting of the secret working group took place in May, 1988, at a posh officers' club within the precincts of Pollsmoor.Missing:  1988-1989 | Show results with:1988-1989\",\"url\":\"https://fwdeklerk.org/meetings-between-nelson-mandela-and-the-pw-botha-government/\",\"favicon\":\"\"},{\"id\":\"77\",\"title\":\"Nelson Mandela meets President P.W. Botha to begin negotiating ...\",\"description\":\"Mar 16, 2011 · The meeting between Mandela and P.W. Botha occurred in secret on 5 July 1989, and was very brief.\",\"url\":\"https://sahistory.org.za/dated-event/nelson-mandela-meets-president-pw-botha-begin-negotiating-end-apartheid\",\"favicon\":\"\"},{\"id\":\"78\",\"title\":\"19 January 1989 - Nelson Mandela Foundation\",\"description\":\"ANC leader Nelson Mandela met with South African President P. W. Botha on 5 July at the latter's office in Cape Town. On 8 July, Justice Minister Kobie Coetsee ...\",\"url\":\"https://www.nelsonmandela.org/omalley/cis/omalley/OMalleyWeb/03lv01538/04lv01539/05lv01573/06lv01583.htm\",\"favicon\":\"\"},{\"id\":\"79\",\"title\":\"FW DE KLERK'S FIRST MEETING WITH NELSON MANDELA\",\"description\":\"“Under cover of darkness on the evening of 13 December 1989, Nelson Mandela was smuggled into the basement garage of Tuynhuys. He was ushered into my office ...\",\"url\":\"https://fwdeklerk.org/fw-de-klerks-first-meeting-with-nelson-mandela/\",\"favicon\":\"\"},{\"id\":\"80\",\"title\":\"F.W. de Klerk announces Nelson Mandela will be freed on 11 ...\",\"description\":\"Feb 10, 2020 · As de Klerk's predecessor in parliament, P. W. Botha had offered to release Mandela on condition that he renounce violence.\",\"url\":\"https://sahistory.org.za/dated-event/fw-de-klerk-announces-nelson-mandela-will-be-freed-11-february\",\"favicon\":\"\"},{\"id\":\"81\",\"title\":\"Nelson Mandela released from prison | February 11, 1990 | HISTORY\",\"description\":\"... ANC. In 1952, he became deputy national president of the ANC, advocating nonviolent resistance to apartheid—South Africa's institutionalized system of white ...\",\"url\":\"https://www.history.com/this-day-in-history/february-11/nelson-mandela-released-from-prison\",\"favicon\":\"\"},{\"id\":\"82\",\"title\":\"Nelson Mandela's release from prison: 33 years on\",\"description\":\"Feb 10, 2023 · When Mandela was finally released in 1990 none of the conditions applied because it was such an auspicious moment of hope for South Africa ...\",\"url\":\"https://www.nelsonmandela.org/news/entry/nelson-mandelas-release-from-prison-33-years-on\",\"favicon\":\"\"},{\"id\":\"83\",\"title\":\"FW de Klerk made a speech 31 years ago that ended apartheid\",\"description\":\"Jan 30, 2020 · In his opening address to parliament, De Klerk unbanned the exiled liberation movements, notably the African National Congress (ANC), Pan- ...\",\"url\":\"https://theconversation.com/fw-de-klerk-made-a-speech-31-years-ago-that-ended-apartheid-why-he-did-it-130803\",\"favicon\":\"\"},{\"id\":\"84\",\"title\":\"F. W. de Klerk's speech at the opening of Parliament 2 February 1990\",\"description\":\"Feb 2, 1990 · The aim is a totally new and just constitutional dispensation in which every inhabitant will enjoy equal rights, treatment and opportunity in every sphere of ...\",\"url\":\"https://omalley.nelsonmandela.org/index.php/site/q/03lv02039/04lv02103/05lv02104/06lv02105.htm\",\"favicon\":\"\"},{\"id\":\"85\",\"title\":\"CONSTITUTIONAL TRANSFORMATION OF SOUTH AFRICA\",\"description\":\"The negotiations, under his presidency, commenced with his speech of 2 February 1990 ... On 2 February 1989 FW De Klerk was elected leader of The National Party.\",\"url\":\"https://fwdeklerk.org/constitutional-transformation-of-south-africa/\",\"favicon\":\"\"},{\"id\":\"86\",\"title\":\"The Groote Schuur Minute 4 May 1990 - Nelson Mandela Foundation\",\"description\":\"May 4, 1990 · The government and the African National Congress agree on a common commitment towards the resolution of the existing climate of violence and intimidation.\",\"url\":\"https://omalley.nelsonmandela.org/index.php/site/q/03lv02039/04lv02103/05lv02104/06lv02106.htm\",\"favicon\":\"\"},{\"id\":\"87\",\"title\":\"Meeting the enemy – Groote Schuur – May 1990 - Our Constitution\",\"description\":\"May 2, 1990 · On 2 May 1990, the NP and the ANC began a two-day meeting at the historic Groote Schuur estate in Cape Town.\",\"url\":\"https://ourconstitution.wethepeoplesa.org/meeting-the-enemy-groote-schuur-may-1990/\",\"favicon\":\"\"},{\"id\":\"88\",\"title\":\"Talks between the government and ANC on negotiations proceed\",\"description\":\"Apr 25, 2012 · The Groote Schuur talks between the South African government and the African National Congress (ANC) were held on 2, 3 and 4 May 1990.\",\"url\":\"https://sahistory.org.za/dated-event/talks-between-government-and-anc-negotiations-proceed\",\"favicon\":\"\"},{\"id\":\"89\",\"title\":\"South Africa: ANC agrees to suspend armed struggle - UPI Archives\",\"description\":\"Aug 6, 1990 · The 72-year-old Mandela said 'there will be no infiltration of men and arms into South Africa and any related activity to military action will ...\",\"url\":\"https://www.upi.com/Archives/1990/08/06/South-Africa-ANC-agrees-to-suspend-armed-struggle/3983649915200/\",\"favicon\":\"\"},{\"id\":\"90\",\"title\":\"THE PRETORIA MINUTE 6 AUGUST 1990 - FW de Klerk Foundation\",\"description\":\"Aug 6, 1990 · ... Pretoria Minute, State of Emergency in Natal, suspension of ANC armed struggle. FW de Klerk Foundation 129 Hatfield Street, Gardens, Cape ...\",\"url\":\"https://fwdeklerk.org/the-pretoria-minute-6-august-1990/\",\"favicon\":\"\"},{\"id\":\"91\",\"title\":\"ANC Halts All Armed Struggle : South Africa: The rebel group acts to ...\",\"description\":\"Aug 7, 1990 · “There will be no infiltrations of men and arms into South Africa, and any activity related to military action will be suspended,” Mandela said.\u003c|separator|\u003e\",\"url\":\"https://www.latimes.com/archives/la-xpm-1990-08-07-mn-150-story.html\",\"favicon\":\"\"},{\"id\":\"92\",\"title\":\"The Pretoria Minute 6 August 1990 - The O'Malley Archives\",\"description\":\"Aug 6, 1990 · The Pretoria Minute 6 August 1990. The government and the ANC have held discussions at the Presidency, Pretoria, today 6 August 1990.\",\"url\":\"https://omalley.nelsonmandela.org/index.php/site/q/03lv02039/04lv02103/05lv02104/06lv02107.htm\",\"favicon\":\"\"},{\"id\":\"93\",\"title\":\"The context of the call for a general amnesty in South Africa\",\"description\":\"These negotiations led to the conclusion of two \\\"Minutes,\\\" at Groote Schuur on May 4, 1990, and at Pretoria on August 6, 1990, which set up procedures and ...\",\"url\":\"https://www.hrw.org/reports/1992/southafrica/2.htm\",\"favicon\":\"\"},{\"id\":\"94\",\"title\":\"Convention for a Democratic South Africa (CODESA)\",\"description\":\"Mar 21, 2011 · The first plenary session of the Convention for a Democratic South Africa (CODESA) began on December 21 1991, at the World Trade Centre in ...\",\"url\":\"https://sahistory.org.za/article/convention-democratic-south-africa-codesa\",\"favicon\":\"\"},{\"id\":\"95\",\"title\":\"The Convention for a Democratic South Africa (CODESA): CODESA 1\",\"description\":\"Apr 20, 2017 · The convention also witnessed the illuminating and fiery exchange between President De Klerk and Mandela, which highlighted an unresolved issue ...\",\"url\":\"https://sahistory.org.za/article/convention-democratic-south-africa-codesa-codesa-1\",\"favicon\":\"\"},{\"id\":\"96\",\"title\":\"THE SOUTH AFRICAN CONSTITUTIONAL NEGOTIATIONS\",\"description\":\"At the same time Nelson Mandela and the South African government began discussions on a negotiated solution that culminated in 1989 in meetings between him and ...\",\"url\":\"https://fwdeklerk.org/the-south-african-constitutional-negotiations/\",\"favicon\":\"\"},{\"id\":\"97\",\"title\":\"CODESA negotiations began in December 1991 – a significant ...\",\"description\":\"Dec 20, 2011 · Negotiations to end the apartheid system began in 1990, starting with the release of Nelson Mandela and some political prisoners from Robben Island prison.\",\"url\":\"https://www.saha.org.za/news/2011/December/codesa_negotiations_began_in_december_1991_a_significant_transitional_step_towards_a_democratic_south_africa.htm\",\"favicon\":\"\"},{\"id\":\"98\",\"title\":\"Convention For A Democratic South Africa (CODESA)\",\"description\":\"A negotiating forum called CODESA was set up in 1991 after an agreement, the National Peace Accord, signed by the government and 18 other political ...Missing:  details | Show results with:details\",\"url\":\"https://omalley.nelsonmandela.org/index.php/site/q/03lv03445/04lv03446/05lv03459.htm\",\"favicon\":\"\"},{\"id\":\"99\",\"title\":\"[PDF] The Negotiation Tactics of Nelson Mandela\",\"description\":\"May 8, 2021 · National Congress called off multilateral negotiations at Codesa and bilateral negotiations with government until it met a list of 14 ...\",\"url\":\"https://digitalcommons.pepperdine.edu/cgi/viewcontent.cgi?article=1417\u0026context=globaltides\",\"favicon\":\"\"},{\"id\":\"100\",\"title\":\"\",\"description\":\"\",\"url\":\"https://c-r.org/accord/public-participation/south-africas-multi-party-constitutional-negotiation-process\",\"favicon\":\"\"},{\"id\":\"101\",\"title\":\"The Interim South African Constitution 1993\",\"description\":\"Jan 15, 2014 · The 1993 Interim Constitution created the Constitutional Court. The Interim Constitution was approved in Kempton Park and it was duly endorsed ...\",\"url\":\"https://sahistory.org.za/article/interim-south-african-constitution-1993\",\"favicon\":\"\"},{\"id\":\"102\",\"title\":\"South Africa holds first multiracial elections | April 27, 1994 | HISTORY\",\"description\":\"More than 22 million South Africans turn out to cast ballots in the country's first multiracial parliamentary electio...\",\"url\":\"https://www.history.com/this-day-in-history/april-27/south-africa-holds-first-multiracial-elections\",\"favicon\":\"\"},{\"id\":\"103\",\"title\":\"April 26-29, 1994 General Election Results\",\"description\":\"... 1994 General Election Results - Republic of South Africa Totals: National Assembly. Voters, 19,726,610. Invalid (Spoilt) Ballots, 193,112, 1.0%. Valid Votes ...\",\"url\":\"http://electionresources.org/za/provinces.php?election=1994\",\"favicon\":\"\"},{\"id\":\"104\",\"title\":\"1994 Election - Apartheid Museum\",\"description\":\"On 27 April 1994 voters stood for hours in queues often stretching over a kilometre long to vote in South Africa's first democratic election.\",\"url\":\"https://www.apartheidmuseum.org/exhibitions/1994-election\",\"favicon\":\"\"},{\"id\":\"105\",\"title\":\"Nelson Mandela Votes For First Time in South Africa's ... - YouTube\",\"description\":\"Apr 26, 2024 · On 26 April 1994, anti-apartheid activist and African National Congress (ANC) leader Nelson Mandela voted for the first time in South ...\",\"url\":\"https://www.youtube.com/watch?v=cgvDk_FCPM4\",\"favicon\":\"\"},{\"id\":\"106\",\"title\":\"[PDF] south africa: - campaign and election report - april 26-29, 1994\",\"description\":\"The six major parties -- the African National Congress, National Party, Inkatha. Freedom Party, Freedom Front, Democratic Party and Pan Africanist Congress of ...\u003c|separator|\u003e\",\"url\":\"https://www.iri.org/wp-content/uploads/2021/12/south_africas_1994_presidential_and_parliamentary_elections_1-1.pdf\",\"favicon\":\"\"},{\"id\":\"107\",\"title\":\"(1994) Nelson Mandela's Inaugural Address as President of South ...\",\"description\":\"Jan 26, 2009 · On May 9, 1994, Nelson Mandela was officially inaugurated as the first democratically elected President of South Africa chosen by the majority ...\",\"url\":\"https://blackpast.org/global-african-history/1994-nelson-mandela-s-inaugural-address-president-south-africa/\",\"favicon\":\"\"},{\"id\":\"108\",\"title\":\"10 | 1994: Mandela becomes SA's first black president\",\"description\":\"The inauguration ceremony took place in the Union Buildings amphitheatre in Pretoria today, attended by politicians and dignitaries from more than 140 countries ...\",\"url\":\"http://news.bbc.co.uk/onthisday/hi/dates/stories/may/10/newsid_2661000/2661503.stm\",\"favicon\":\"\"},{\"id\":\"109\",\"title\":\"Read: Nelson Mandela's inauguration speech as President of SA\",\"description\":\"May 10, 2018 · 10 May 1994. Your Majesties Your Highnesses Distinguished Guests Comrades and Friends. Today, all of us do, by our presence here, and by our ...\",\"url\":\"https://www.sanews.gov.za/south-africa/read-nelson-mandelas-inauguration-speech-president-sa\",\"favicon\":\"\"},{\"id\":\"110\",\"title\":\"Nelson Mandela is inaugurated as South Africa's first black president\",\"description\":\"Nelson Mandela was sworn in as South Africa's first black president at the Union Buildings, Pretoria after being unanimously elected by parliament.\",\"url\":\"https://sahistory.org.za/dated-event/nelson-mandela-inaugurated-south-africas-first-black-president\",\"favicon\":\"\"},{\"id\":\"111\",\"title\":\"[PDF] Nelson Mandela's 1994 inauguration as South Africa's first ...\",\"description\":\"Nelson Mandela's 1994 inauguration as South Africa's first democratically elected president soothed decades of racial tensions in that country.\",\"url\":\"https://honors.ku.edu/sites/honors/files/2023-01/08-whitcomb-macdonald.pdf\",\"favicon\":\"\"},{\"id\":\"112\",\"title\":\"South Africa Establishes a Truth and Reconciliation Commission\",\"description\":\"To pave the way for a new united and democratic South Africa and to prevent possible large-scale and violent race-based retribution, the newly elected Mandela ...\",\"url\":\"https://www.ebsco.com/research-starters/history/south-africa-establishes-truth-and-reconciliation-commission\",\"favicon\":\"\"},{\"id\":\"113\",\"title\":\"The Nelson Mandela Presidency - 1994 to 1999\",\"description\":\"Jul 16, 2015 · Also, as part of his mission for peace, nation-building and reconciliation, Mandela used the nation's enthusiasm for sports as an important ...\",\"url\":\"https://sahistory.org.za/article/nelson-mandela-presidency-1994-1999\",\"favicon\":\"\"},{\"id\":\"114\",\"title\":\"How Nelson Mandela Used Rugby as a Symbol of South African Unity\",\"description\":\"Jul 29, 2021 · “Just as Mandela's gesture in 1995 was hailed as a metaphor for racial reconciliation in the nation, so rugby's failure to transform is seen ...\",\"url\":\"https://www.history.com/articles/nelson-mandela-1995-rugby-world-cup-south-african-unity\",\"favicon\":\"\"},{\"id\":\"115\",\"title\":\"[PDF] Promotion of National Unity and Reconciliation Act 34 of 1995\",\"description\":\"Promotion of National Unity and Reconciliation Act 34 of 1995. [ASSENTED TO 19 JULY 1995]. [DATE OF COMMENCEMENT: 1 DECEMBER 1995]. (Unless otherwise ...\",\"url\":\"https://www.justice.gov.za/legislation/acts/1995-034.pdf\",\"favicon\":\"\"},{\"id\":\"116\",\"title\":\"South Africa Truth and Reconciliation Commission (1996-2002)\",\"description\":\"Nov 1, 2023 · Its mandate was to investigate the gross human rights violations that occurred under apartheid between March 1960 and May 1994, when Nelson Mandela was ...\",\"url\":\"https://atjhub.csvr.org.za/south-africa-truth-and-reconciliation-commission-1996-2002/\",\"favicon\":\"\"},{\"id\":\"117\",\"title\":\"Failing South Africa: the Truth Commission 30 years on\",\"description\":\"Jan 27, 2025 · The year 2025 marks the 30th anniversary of Nelson Mandela's appointment of South Africa's Truth and Reconciliation Commission (TRC).\",\"url\":\"https://www.nelsonmandela.org/news/entry/failing-south-africa-the-truth-commission-30-years-on\",\"favicon\":\"\"},{\"id\":\"118\",\"title\":\"14 - Amnesty or impunity? A preliminary critique of the Report of the ...\",\"description\":\"The TRC claimed to be different from its predecessors, whether in Latin America or Eastern Europe. It would neither grant impunity nor practice vengeance. It ...\",\"url\":\"https://www.cambridge.org/core/books/identities-affiliations-and-allegiances/amnesty-or-impunity-a-preliminary-critique-of-the-report-of-the-truth-and-reconciliation-commission-of-south-africa/33B476F7C314707D96082397D899A01A\",\"favicon\":\"\"},{\"id\":\"119\",\"title\":\"Amnesty or Impunity? A Preliminary Critique of the Report of the ...\",\"description\":\"To the extent that the TRC did not acknowledge the full truth, the amnesty intended to be individual turned into a group amnesty. For any perpetrator who was ...\",\"url\":\"https://muse.jhu.edu/pub/1/article/178513/pdf\",\"favicon\":\"\"},{\"id\":\"120\",\"title\":\"Nelson Mandela: leadership and reconciliation | Clingendael\",\"description\":\"Dec 6, 2013 · He turned out to be the real combatant fighting for national reconciliation in a deeply divided South Africa. But there is also another Nelson ...\",\"url\":\"https://www.clingendael.org/publication/nelson-mandela-leadership-and-reconciliation\",\"favicon\":\"\"},{\"id\":\"121\",\"title\":\"South Africa's Key economic policies changes (1994 - 2013)\",\"description\":\"May 6, 2014 · When faced with these constraints Government introduced a macroeconomic policy framework called the Growth, Employment and Redistribution (GEAR) ...\",\"url\":\"https://sahistory.org.za/article/south-africas-key-economic-policies-changes-1994-2013\",\"favicon\":\"\"},{\"id\":\"122\",\"title\":\"The Politics of South Africa: The Transition to Democracy | Solidarity\",\"description\":\"The ANC argued that GEAR was necessary to overcome the debt from the apartheid regime (25% of the annual budget) in order to restore the confidence of ...\",\"url\":\"https://www.marxists.org/history/etol/newspape/atc/1800.html\",\"favicon\":\"\"},{\"id\":\"123\",\"title\":\"[PDF] GROWTH, EMPLOYMENT AND REDISTRIBUTION A ...\",\"description\":\"The strategy aims for a fast-growing economy with sufficient jobs, income redistribution for the poor, and a 6% growth rate with 400,000 jobs by 2000.\",\"url\":\"https://www.treasury.gov.za/publications/other/gear/chapters.pdf\",\"favicon\":\"\"},{\"id\":\"124\",\"title\":\"Former President Nelson Mandela's economic legacy lives on\",\"description\":\"Dec 13, 2013 · GEAR was a macroeconomic strategy adopted by the Department of Finance in June 1996 aimed at strengthening economic development, broadening of ...Missing:  framework | Show results with:framework\",\"url\":\"https://www.gov.za/blog/former-president-nelson-mandelas-economic-legacy-lives\",\"favicon\":\"\"},{\"id\":\"125\",\"title\":\"ANC economic and social policy from African Claims to GEAR\",\"description\":\"GEAR was made public to the ANC membership and the rest of the world in mid-1996 with the stunning announcement that it was 'non-negotiable'.\",\"url\":\"https://journals.co.za/doi/pdf/10.10520/EJC-ae480ac06\",\"favicon\":\"\"},{\"id\":\"126\",\"title\":\"17.6 Alliance contestation around GEAR - The Presidential Years\",\"description\":\"I want to tell you that GEAR is the fundamental policy of the African National Congress. We are not going to change it because of your pressure. We will not do ...\",\"url\":\"https://tpy.nelsonmandela.org/pages/part-vi-anc-and-the-transition/17-anc-and-the-transition/17-6-alliance-contestation-around-gear\",\"favicon\":\"\"},{\"id\":\"127\",\"title\":\"[PDF] The Government`s new economic strategy - ANC\",\"